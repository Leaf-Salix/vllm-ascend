    "coefficients": "coeff_rows>=plan[0]*16，coeff_cols=G*64，来自相同group plan；尾query块全零",
    "keys": "Native slab[pages,page_bytes]；page_bytes>=4160且64字节对齐；key0字节0开始floor(total_bytes/128)行；key64字节64开始floor((total_bytes-64)/128)行，都是同一slab只读别名",
    "page_table": "真实visible历史所有逻辑页必须在table列范围且物理页合法；guard用于不解引用非法地址，不定义非法metadata的TopK结果",
    "transfer": "FP32[>=24*2*G,score_tile]，每core两槽，每槽G行；所有实际TSTORE G行且双AIV共同消费后复用",
    "score_arena": "FP32[>=24*2*G,8192]；nonbalanced每AIV/query独有一行，按实际prefix写后排序，不读取容量尾",
    "pair_arena": "FP32[>=T*64,1024]；roots2=q*64+leaf*2+lane，roots1=q*64+leaf，和publish阶段一致",
    "plan": "INT32[8]=[groups,max_history,leaves,leaf_tiles,extra,G,balanced,roots]，生产/消费同一配置且执行期间固定"
