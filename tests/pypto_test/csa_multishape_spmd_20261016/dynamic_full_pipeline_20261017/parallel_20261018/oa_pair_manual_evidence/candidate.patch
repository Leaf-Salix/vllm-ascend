+            a2 = pl.tile.load(o_packed, [row_base, kbase + 512], [128, 256], [valid_rows, 256], target_memory=pl.Mem.Mat)
+            w2a = pl.tile.load(wo_a, [group, kbase + 512, n0], [1, 256, 128], [1, 256, 128], target_memory=pl.Mem.Mat, cache=1)
