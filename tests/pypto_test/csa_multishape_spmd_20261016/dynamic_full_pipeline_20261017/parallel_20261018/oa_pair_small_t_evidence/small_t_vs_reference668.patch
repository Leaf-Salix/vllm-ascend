+        owner = group * 3 + pair
+        offset = (phase * participant_count + owner) * SIGNAL_SLOT_WORDS
+        signals = csa_signal_wait(signals, offset, generation)
+    for single in pl.range(2):
+        owner = (group * 3 + 3 + single) % 24
+        offset = (phase * participant_count + owner) * SIGNAL_SLOT_WORDS
+        signals = csa_signal_wait(signals, offset, generation)
+    pl.system.fence()
+    pl.system.cacheinvalid()
+    pl.system.fence()
+    return signals
