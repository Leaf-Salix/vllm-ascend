    %tv = pto.make_tensor_view %src, shape = [%c32, %c128], strides = [%c128, %c1] : !pto.tensor_view<?x?xi8>
    %input = pto.partition_view %tv, offsets = [%c0, %c0], sizes = [%c32, %c128] : !pto.tensor_view<?x?xi8> -> !pto.partition_tensor_view<32x128xi8>
    %pool = pto.alloc_tile addr = %a0 : !pto.tile_buf<loc=mat, dtype=i8, rows=384, cols=128, v_row=384, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %transposed = pto.alloc_tile addr = %a0 : !pto.tile_buf<loc=mat, dtype=i8, rows=128, cols=384, v_row=128, v_col=384, blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %right = pto.alloc_tile addr = %a0 : !pto.tile_buf<loc=right, dtype=i8, rows=128, cols=64, v_row=128, v_col=64, blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %write_pool = pto.alloc_tile addr = %a0 : !pto.tile_buf<loc=mat, dtype=i8, rows=384, cols=128, v_row=384, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %first = pto.subview %pool[%c0, %c0] sizes [32, 128] : !pto.tile_buf<loc=mat, dtype=i8, rows=384, cols=128, v_row=384, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0> -> !pto.tile_buf<loc=mat, dtype=i8, rows=32, cols=128, v_row=32, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %second = pto.subview %pool[%c32, %c0] sizes [32, 128] : !pto.tile_buf<loc=mat, dtype=i8, rows=384, cols=128, v_row=384, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0> -> !pto.tile_buf<loc=mat, dtype=i8, rows=32, cols=128, v_row=32, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %later = pto.subview %write_pool[%cast_offset, %c0] sizes [32, 128] : !pto.tile_buf<loc=mat, dtype=i8, rows=384, cols=128, v_row=384, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0> -> !pto.tile_buf<loc=mat, dtype=i8, rows=32, cols=128, v_row=32, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.tload ins(%input : !pto.partition_tensor_view<32x128xi8>) outs(%first : !pto.tile_buf<loc=mat, dtype=i8, rows=32, cols=128, v_row=32, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    pto.tload ins(%input : !pto.partition_tensor_view<32x128xi8>) outs(%second : !pto.tile_buf<loc=mat, dtype=i8, rows=32, cols=128, v_row=32, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    pto.textract ins(%transposed, %c0, %c0 : !pto.tile_buf<loc=mat, dtype=i8, rows=128, cols=384, v_row=128, v_col=384, blayout=row_major, slayout=col_major, fractal=512, pad=0>, index, index) outs(%right : !pto.tile_buf<loc=right, dtype=i8, rows=128, cols=64, v_row=128, v_col=64, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
    pto.tload ins(%input : !pto.partition_tensor_view<32x128xi8>) outs(%later : !pto.tile_buf<loc=mat, dtype=i8, rows=32, cols=128, v_row=32, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }
}
