    pto.textract ins(%transposed, %c0, %c0 : !pto.tile_buf<loc=mat, dtype=i8, rows=128, cols=128, v_row=128, v_col=128, blayout=row_major, slayout=col_major, fractal=512, pad=0>, index, index) outs(%right : !pto.tile_buf<loc=right, dtype=i8, rows=128, cols=48, v_row=128, v_col=48, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
