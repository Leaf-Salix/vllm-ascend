+        roots_.insert(collector.var_uses.begin(), collector.var_uses.end());
+      }
+    }
+  }
+
+  std::unordered_map<const Var*, std::vector<const Var*>> dependencies_;
+  std::unordered_set<const Var*> roots_;
+};
