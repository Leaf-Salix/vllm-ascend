+def _q_a_small_m16_worker(
+    x: pl.Tensor[[T_DYN, D], pl.BF16],
+    wq_a: pl.Tensor[[Q_LORA, D], pl.BF16, BF16_WEIGHT_LAYOUT],
+    qa_fp32: pl.Tensor[[QA_ROWS_DYN, Q_LORA], pl.FP32],
+    worker_id: pl.Scalar[pl.INDEX],
+    WORKERS: pl.constexpr,
+):
+    """小T以全局M16块编号分核，复用原尾块数学，不把尾块重新交回第零组。
+
+    任务 logical=block*8+column；T<=48 时任务数不超过24，正式24核各至多
+    领取一个任务。T24 的 row0/row16 分别归0..7/8..15，输入仍按有效行
+    读取，qa 的容量合同仍为 pad16(T)。M32 拆成M16可能增加权重总读取。
+    """
+    tokens = pl.tensor.dim(x, 0)
+    small_blocks = (tokens + QR_M_TILE - 1) // QR_M_TILE
+    for logical_worker in pl.range(pl.max(worker_id, 0), QR_N_BLOCKS * small_blocks, WORKERS):
+        column = (logical_worker % QR_N_BLOCKS) * QR_N_TILE
+        row = (logical_worker // QR_N_BLOCKS) * QR_M_TILE
+        small_acc = pl.create_tensor([QR_M_TILE, QR_N_TILE], dtype=pl.FP32)
+        # 与原M16尾块逐项同序：K256×16、首段初始化、valid_shape及assemble不变。
+        for k_block in pl.pipeline(D // QR_K_TILE, stage=2):
+            k0 = k_block * QR_K_TILE
+            valid_rows = pl.min(QR_M_TILE, tokens - row)
+            small_x = pl.slice(x, [QR_M_TILE, QR_K_TILE], [row, k0],
+                               valid_shape=[valid_rows, QR_K_TILE])
+            small_weight = wq_a[column : column + QR_N_TILE, k0 : k0 + QR_K_TILE]
+            small_acc = pl.matmul_acc(small_acc, small_x, small_weight, b_trans=True, init_cond=(k_block == 0))
+        qa_fp32 = pl.assemble(qa_fp32, small_acc, [row, column])
+    return qa_fp32
+
+
