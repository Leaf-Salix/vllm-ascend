+@pl.jit.inline(auto_scope=False)
+def o_dequant_hc_post_stage(
+    partials: pl.Tensor[[MM_ROWS_DYN, O_GROUPS * D], pl.INT32],
+    act_scale_dq: pl.Tensor[[O_GROUPS, SCALE_ROWS_DYN], pl.FP32],
+    wo_b_scale: pl.Tensor[[D], pl.FP32],
+    residual_flat: pl.Tensor[[T_DYN, HC_MULT * D], pl.BF16],
+    post: pl.Tensor[[T_DYN, HC_MULT], pl.FP32],
+    comb: pl.Tensor[[T_DYN, HC_MULT * HC_MULT], pl.FP32],
+    out_flat: pl.Out[pl.Tensor[[T_DYN, HC_MULT * D], pl.BF16]],
+    worker_id: pl.Scalar[pl.INDEX],
+    WORKERS: pl.constexpr,
+):
+    """Fill idle AIVs with independent columns; retain row ownership at larger T."""
+    tokens = pl.tensor.dim(out_flat, 0)
+    if tokens * 8 <= WORKERS:
+        out_flat = _o_dequant_hc_post_columns(partials, act_scale_dq, wo_b_scale, residual_flat, post, comb, out_flat, worker_id, WORKERS, 512)
+    elif tokens * 4 <= WORKERS:
+        out_flat = _o_dequant_hc_post_columns(partials, act_scale_dq, wo_b_scale, residual_flat, post, comb, out_flat, worker_id, WORKERS, 1024)
+    elif tokens * 2 <= WORKERS:
+        out_flat = _o_dequant_hc_post_columns(partials, act_scale_dq, wo_b_scale, residual_flat, post, comb, out_flat, worker_id, WORKERS, 2048)
+    else:
+        out_flat = _o_dequant_hc_post_rows(partials, act_scale_dq, wo_b_scale, residual_flat, post, comb, out_flat, worker_id, WORKERS)
+    return out_flat
