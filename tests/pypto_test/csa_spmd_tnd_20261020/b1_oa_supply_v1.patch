+# SPDX-License-Identifier: Apache-2.0
+"""Small-M O_A supply trial; selected only for one request and at most16 tokens."""
+
+import pypto.language as pl
+
+from .output_projection_a_stages import MM_ROWS_DYN, PACK_TOTAL_ROWS_DYN
+
+
+@pl.jit.inline(auto_scope=False)
+def o_projection_a_small_supply(
+    packed: pl.Tensor[[PACK_TOTAL_ROWS_DYN, 4096], pl.BF16],
+    weight: pl.Tensor[[8, 4096, 1024], pl.BF16, pl.NZ],
+    output: pl.InOut[pl.Tensor[[MM_ROWS_DYN, 8192], pl.FP32]],
+    tokens: pl.Scalar[pl.INDEX],
+    worker: pl.Scalar[pl.INDEX],
+    WORKERS: pl.constexpr,
+    A_COL_TILE: pl.constexpr,
+    group_begin: pl.Scalar[pl.INDEX],
+    group_end: pl.Scalar[pl.INDEX],
+):
+    """Same group/N owner and K order; every load/store keeps actual M valid."""
+    stride = pl.tensor.dim(packed, 0) // 8
+    first_group = group_begin * (1024 // A_COL_TILE)
+    limit = group_end * (1024 // A_COL_TILE)
+    first = worker + ((first_group + WORKERS - 1 - worker) // WORKERS) * WORKERS
+    for work in pl.range(pl.max(0, first), limit, WORKERS):
+        group = pl.max(0, work // (1024 // A_COL_TILE))
+        column = pl.max(0, work % (1024 // A_COL_TILE)) * A_COL_TILE
+        row = group * stride
+        oa_seed = pl.tile.create([16, A_COL_TILE], dtype=pl.FP32, target_memory=pl.MemorySpace.Acc)
+        oa_valid_seed = pl.set_validshape(oa_seed, tokens, A_COL_TILE)
+        # Mat windows are local to each iteration. Only the Acc is loop-carried.
+        for oa_pair, (oa_acc_iter,) in pl.range(4, init_values=(oa_valid_seed,)):
+            k0 = oa_pair * 1024
+            oa_x_first = pl.tile.load(packed, [row, k0], [16, 512], [tokens, 512],
+                                      target_memory=pl.MemorySpace.Mat)
+            oa_w_first = pl.tile.load(weight, [group, k0, column], [1, 512, A_COL_TILE],
+                                      [1, 512, A_COL_TILE], target_memory=pl.MemorySpace.Mat, cache=1)
+            oa_x_second = pl.tile.load(packed, [row, k0 + 512], [16, 512], [tokens, 512],
+                                       target_memory=pl.MemorySpace.Mat)
+            oa_w_second = pl.tile.load(weight, [group, k0 + 512, column], [1, 512, A_COL_TILE],
+                                       [1, 512, A_COL_TILE], target_memory=pl.MemorySpace.Mat, cache=1)
+            oa_weight_first = pl.tile.reshape(oa_w_first, [512, A_COL_TILE])
+            oa_l_first_0 = pl.tile.extract(oa_x_first, 0, 0,
+                [16, 128], target_memory=pl.MemorySpace.Left)
+            oa_r_first_0 = pl.tile.extract(oa_weight_first, 0, 0,
+                [128, A_COL_TILE], target_memory=pl.MemorySpace.Right)
+            oa_l_first_1 = pl.tile.extract(oa_x_first, 0, 128,
+                [16, 128], target_memory=pl.MemorySpace.Left)
+            oa_r_first_1 = pl.tile.extract(oa_weight_first, 128, 0,
+                [128, A_COL_TILE], target_memory=pl.MemorySpace.Right)
+            oa_acc_first_0 = pl.tile.matmul_acc(
+                oa_acc_iter, oa_l_first_0, oa_r_first_0, init_cond=(oa_pair == 0))
+            oa_acc_first_1 = pl.tile.matmul_acc(
+                oa_acc_first_0, oa_l_first_1, oa_r_first_1, init_cond=False)
+            oa_l_first_2 = pl.tile.extract(oa_x_first, 0, 256,
+                [16, 128], target_memory=pl.MemorySpace.Left)
+            oa_r_first_2 = pl.tile.extract(oa_weight_first, 256, 0,
+                [128, A_COL_TILE], target_memory=pl.MemorySpace.Right)
+            oa_acc_first_2 = pl.tile.matmul_acc(
+                oa_acc_first_1, oa_l_first_2, oa_r_first_2, init_cond=False)
+            oa_l_first_3 = pl.tile.extract(oa_x_first, 0, 384,
+                [16, 128], target_memory=pl.MemorySpace.Left)
+            oa_r_first_3 = pl.tile.extract(oa_weight_first, 384, 0,
+                [128, A_COL_TILE], target_memory=pl.MemorySpace.Right)
+            oa_acc_first_3 = pl.tile.matmul_acc(
+                oa_acc_first_2, oa_l_first_3, oa_r_first_3, init_cond=False)
+            oa_weight_second = pl.tile.reshape(oa_w_second, [512, A_COL_TILE])
+            oa_l_second_0 = pl.tile.extract(oa_x_second, 0, 0,
+                [16, 128], target_memory=pl.MemorySpace.Left)
+            oa_r_second_0 = pl.tile.extract(oa_weight_second, 0, 0,
+                [128, A_COL_TILE], target_memory=pl.MemorySpace.Right)
+            oa_l_second_1 = pl.tile.extract(oa_x_second, 0, 128,
+                [16, 128], target_memory=pl.MemorySpace.Left)
+            oa_r_second_1 = pl.tile.extract(oa_weight_second, 128, 0,
+                [128, A_COL_TILE], target_memory=pl.MemorySpace.Right)
+            oa_acc_second_0 = pl.tile.matmul_acc(
+                oa_acc_first_3, oa_l_second_0, oa_r_second_0, init_cond=False)
+            oa_acc_second_1 = pl.tile.matmul_acc(
+                oa_acc_second_0, oa_l_second_1, oa_r_second_1, init_cond=False)
+            oa_l_second_2 = pl.tile.extract(oa_x_second, 0, 256,
+                [16, 128], target_memory=pl.MemorySpace.Left)
+            oa_r_second_2 = pl.tile.extract(oa_weight_second, 256, 0,
+                [128, A_COL_TILE], target_memory=pl.MemorySpace.Right)
+            oa_acc_second_2 = pl.tile.matmul_acc(
+                oa_acc_second_1, oa_l_second_2, oa_r_second_2, init_cond=False)
+            oa_l_second_3 = pl.tile.extract(oa_x_second, 0, 384,
+                [16, 128], target_memory=pl.MemorySpace.Left)
+            oa_r_second_3 = pl.tile.extract(oa_weight_second, 384, 0,
+                [128, A_COL_TILE], target_memory=pl.MemorySpace.Right)
+            oa_acc_second_3 = pl.tile.matmul_acc(
+                oa_acc_second_2, oa_l_second_3, oa_r_second_3, init_cond=False)
+            oa_finished = pl.yield_(oa_acc_second_3)
+        pl.store(oa_finished, [0, group * 1024 + column], output)
+    return output
