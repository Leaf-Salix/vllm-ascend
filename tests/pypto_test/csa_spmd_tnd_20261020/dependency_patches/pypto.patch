+def test_local_signal_backoff_round_trip():
+    @pl.program
+    class Before:
+        @pl.function(type=pl.FunctionType.AIV)
+        def kernel(
+            self,
+            signal: pl.InOut[pl.Tensor[[256], pl.INT32]],
