+@pl.jit.inline(auto_scope=False)
+def publish_cube_tile_phase(
+    signals: pl.InOut[pl.Tensor[[SIGNAL_WORDS], pl.INT32]],
+    phase: pl.Scalar[pl.INDEX],
+    core_id: pl.Scalar[pl.INDEX],
+    participant_count: pl.Scalar[pl.INDEX],
+    generation: pl.Scalar[pl.INT32],
+):
+    """Cube-only trial: Tile/FIX payload, no dirty scalar business stores.
+
+    Keep the GM fence, PIPE_ALL before notification, the signal's own cache
+    maintenance and every consumer acquire. Omit only the full scalar-cache
+    flush and its following duplicate fence. Vector publication is unchanged.
+    The source call-graph audit and generated code must support this contract.
+    """
+    pl.system.fence()
