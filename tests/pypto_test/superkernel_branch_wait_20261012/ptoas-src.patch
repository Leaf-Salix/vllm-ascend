diff --git a/test/lit/pto/local_task_wait_branch_merge.pto b/test/lit/pto/local_task_wait_branch_merge.pto
new file mode 100644
index 00000000..08e58346
--- /dev/null
+++ b/test/lit/pto/local_task_wait_branch_merge.pto
@@ -0,0 +1,66 @@
+// Copyright (c) 2026 Huawei Technologies Co., Ltd.
+// SPDX-License-Identifier: LicenseRef-CANN-Open-Software-License-Version-2.0
+
+// RUN: ptoas --enable-insert-sync --pto-level=level3 %s 2>&1 | FileCheck %s
+// Both nested branches explicitly finish their Scalar preparation with Wait.
+// Coalescing must retain the Scalar result before the common wait, and must not
+// put loop-carried initial pipeline flags ahead of it.
+// CHECK-LABEL: AICORE void branch_wait(
+// CHECK-NOT: set_flag(
+// CHECK-NOT: wait_flag(
+// CHECK-NOT: pipe_barrier(
+// CHECK-NOT: pypto_wait_local_boundary(
+// CHECK: pypto_keep_prefix(
+// CHECK-NOT: set_flag(
+// CHECK-NOT: wait_flag(
+// CHECK-NOT: pipe_barrier(
+// CHECK: pypto_wait_local_boundary(
+// CHECK-NOT: pypto_wait_local_boundary(
+// CHECK: set_flag(PIPE_MTE3, PIPE_MTE2,
+// CHECK-NOT: pypto_wait_local_boundary(
+// CHECK: TLOAD(
+// CHECK: TSTORE(
+// CHECK-NOT: pypto_wait_local_boundary(
+// CHECK: ptoas_auto_sync_tail(PTOAutoSyncTailMode::kRuntimeBarrierAll);
+
+module attributes {pto.target_arch = "a2a3"} {
+  func.func @branch_wait(%src: !pto.ptr<f32>, %dst: !pto.ptr<f32>,
+      %raw: !pto.ptr<i64>, %handoff: i64, %count: index)
+      attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.scalar_prefix,
+                  pto.runtime_late_handoff, pto.auto_sync_tail_hint = "runtime_barrier_all"} {
+    %zero = arith.constant 0 : index
+    %one = arith.constant 1 : index
+    %two = arith.constant 2 : index
+    %cols = arith.constant 32 : index
+    %addr = arith.constant 0 : i64
+    %shape_src = pto.make_tensor_view %src, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<1x32xf32>
+    %shape_dst = pto.make_tensor_view %dst, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<1x32xf32>
+    %view_src = pto.partition_view %shape_src, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<1x32xf32> -> !pto.partition_tensor_view<1x32xf32>
+    %view_dst = pto.partition_view %shape_dst, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<1x32xf32> -> !pto.partition_tensor_view<1x32xf32>
+    %tile = pto.alloc_tile addr = %addr valid_row = %one valid_col = %cols : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
+    %positive = arith.cmpi sgt, %count, %zero : index
+    %large = arith.cmpi sgt, %count, %two : index
+    %work = scf.if %positive -> (index) {
+      %inner = scf.if %large -> (index) {
+        %plus = arith.addi %count, %two : index
+        func.call @pypto_wait_pre_task_end(%raw, %handoff) : (!pto.ptr<i64>, i64) -> ()
+        scf.yield %plus : index
+      } else {
+        func.call @pypto_wait_pre_task_end(%raw, %handoff) : (!pto.ptr<i64>, i64) -> ()
+        scf.yield %two : index
+      }
+      scf.yield %inner : index
+    } else {
+      func.call @pypto_wait_pre_task_end(%raw, %handoff) : (!pto.ptr<i64>, i64) -> ()
+      scf.yield %one : index
+    }
+    scf.for %j = %zero to %work step %one {
+      pto.tload ins(%view_src : !pto.partition_tensor_view<1x32xf32>) outs(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
+      pto.tstore ins(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%view_dst : !pto.partition_tensor_view<1x32xf32>)
+    }
+    func.call @pypto_set_next_task_start(%raw) : (!pto.ptr<i64>) -> ()
+    return
+  }
+  func.func private @pypto_wait_pre_task_end(!pto.ptr<i64>, i64)
+  func.func private @pypto_set_next_task_start(!pto.ptr<i64>)
+}
