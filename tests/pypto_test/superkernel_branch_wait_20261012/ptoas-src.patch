diff --git a/tools/ptoas/ptoas_pipeline.cpp b/tools/ptoas/ptoas_pipeline.cpp
index 92c4b0b0..116795d6 100644
--- a/tools/ptoas/ptoas_pipeline.cpp
+++ b/tools/ptoas/ptoas_pipeline.cpp
@@ -1168,6 +1168,35 @@ static void setFusionPipelineFlags(CompilePipelineState &state,
   }
 }
 
+// Coalesce only author-written, identical statement waits at both exits of an
+// if. Yield has no effects, and shared SSA operands dominate both arms, so the
+// common call observes exactly the same arguments and runs once on every path.
+// Doing this before prefix validation lets the existing checked top-level wait
+// remain the sole pipeline-lifetime anchor. It does not discover a boundary or
+// move work across one: a wait followed by any work is deliberately left alone.
+static void coalesceBranchLocalTaskWaits(ModuleOp module) {
+  module.walk([&](func::FuncOp func) {
+    if (!func->hasAttr("pto.scalar_prefix")) return;
+    func.walk<WalkOrder::PostOrder>([&](scf::IfOp branch) {
+      auto lastWait = [](Block *block) -> func::CallOp {
+        if (!block || block->empty()) return {};
+        Operation *last = block->getTerminator()->getPrevNode();
+        auto call = dyn_cast_or_null<func::CallOp>(last);
+        if (!call || call.getCallee() != "pypto_wait_pre_task_end" ||
+            call.getNumResults() != 0) return {};
+        return call;
+      };
+      auto thenWait = lastWait(branch.thenBlock());
+      auto elseWait = lastWait(branch.elseBlock());
+      if (!thenWait || !elseWait ||
+          thenWait->getAttrDictionary() != elseWait->getAttrDictionary() ||
+          !llvm::equal(thenWait.getOperands(), elseWait.getOperands())) return;
+      thenWait->moveAfter(branch);
+      elseWait.erase();
+    });
+  });
+}
+
 static LogicalResult validateScalarPrefixContracts(ModuleOp module) {
   bool invalid = false;
   module.walk([&](func::FuncOp func) {
@@ -1965,6 +1994,7 @@ int mlir::pto::compilePTOASModule(
     return 1;
   }
   setFusionPipelineFlags(state, effectiveBackend);
+  coalesceBranchLocalTaskWaits(*module);
   if (failed(validateCompileOptions(*module, state.level))) {
     return 1;
   }
