index 18d648a81..53e8fd0ac 100644
--- a/include/pypto/ir/transforms/utils/task_boundary_utils.h
+++ b/include/pypto/ir/transforms/utils/task_boundary_utils.h
@@ -26,15 +26,42 @@ struct TaskBoundaryMarkers {
   bool signal = false;
 };
 
+// Recognize a local wait at every exit of a non-repeating branch. PTOAS can
+// coalesce these explicit statement waits at the join; implicit entry loads
+// and MIX pipe setup must already be placed after that join in PyPTO IR.
+// A missing arm, a loop, or work after the wait is not such a boundary.
+inline bool EndsWithLocalTaskWait(const StmtPtr& stmt) {
+  if (auto eval = As<EvalStmt>(stmt)) {
+    return IsOp(As<Call>(eval->expr_), "system.wait_pre_task_end");
+  }
+  if (auto branch = As<IfStmt>(stmt)) {
+    return branch->else_body_.has_value() && EndsWithLocalTaskWait(branch->then_body_) &&
+           EndsWithLocalTaskWait(*branch->else_body_);
+  }
+  if (auto seq = As<SeqStmts>(stmt)) {
+    auto count = seq->stmts_.size();
+    if (count != 0) {
+      if (auto yield = As<YieldStmt>(seq->stmts_.back())) {
+        // A Yield can still contain an expression before normalization. Only
+        // already-computed values have the no-work property used by PTOAS.
+        if (!std::all_of(yield->value_.begin(), yield->value_.end(), [](const ExprPtr& value) {
+              return As<Var>(value) || As<ConstInt>(value) || As<ConstFloat>(value) || As<ConstBool>(value);
+            }))
+          return false;
+        --count;
+      }
+    }
+    return count != 0 && EndsWithLocalTaskWait(seq->stmts_[count - 1]);
+  }
+  return false;
+}
+
 // Compiler-generated loads and pipe initialization must not cross the local
 // predecessor boundary. Preserve the author's Scalar prefix before that wait.
 inline std::vector<StmtPtr> InsertAfterLocalTaskWait(const std::vector<StmtPtr>& setup,
-                                                   const std::vector<StmtPtr>& body) {
+                                                     const std::vector<StmtPtr>& body) {
   if (setup.empty()) return body;
-  auto wait = std::find_if(body.begin(), body.end(), [](const StmtPtr& stmt) {
-    auto eval = As<EvalStmt>(stmt);
-    return eval && IsOp(As<Call>(eval->expr_), "system.wait_pre_task_end");
-  });
+  auto wait = std::find_if(body.begin(), body.end(), EndsWithLocalTaskWait);
   auto insertion = wait == body.end() ? body.begin() : std::next(wait);
   std::vector<StmtPtr> result;
   result.reserve(setup.size() + body.size());
