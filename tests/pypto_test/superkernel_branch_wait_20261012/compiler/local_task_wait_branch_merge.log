#include "pto/pto-inst.hpp"
using namespace pto;

template <typename Tensor>
static AICORE inline auto PTOAS__GLOBAL_TENSOR_DATA(Tensor &tensor)
    -> decltype(tensor.data()) {
  return tensor.data();
}


enum class PTOAutoSyncTailMode : int {
  kBarrierAll = 0,
  kSetWaitMte3ToSEvent0 = 1,
  kAsyncAivEvent7 = 2,
  kAsyncAicEvent7 = 3,
  kAsyncAivAllPipesEvent7 = 4,
  kAsyncAicAllPipesEvent7 = 5,
  kRuntimeBarrierAll = 6,
};

static AICORE inline void ptoas_auto_sync_tail(
    PTOAutoSyncTailMode mode = PTOAutoSyncTailMode::kBarrierAll) {
  switch (mode) {
  case PTOAutoSyncTailMode::kRuntimeBarrierAll:
    // The dynamic caller executes the ordinary PIPE_ALL before publishing FIN
    // or before a same-core successor may touch pipeline resources.
    break;
  // Every event targets Scalar, so internal uses of the same pair/ID have
  // already been consumed before Scalar can issue these tail markers.
  // The caller must join all listed engines before reusing this core.
  case PTOAutoSyncTailMode::kAsyncAicAllPipesEvent7:
    set_flag(PIPE_M, PIPE_S, EVENT_ID7);
    set_flag(PIPE_FIX, PIPE_S, EVENT_ID7);
    set_flag(PIPE_MTE1, PIPE_S, EVENT_ID7);
    set_flag(PIPE_MTE2, PIPE_S, EVENT_ID7);
    break;
  case PTOAutoSyncTailMode::kAsyncAivAllPipesEvent7:
    set_flag(PIPE_V, PIPE_S, EVENT_ID7);
    set_flag(PIPE_MTE3, PIPE_S, EVENT_ID7);
    set_flag(PIPE_MTE2, PIPE_S, EVENT_ID7);
    break;
  case PTOAutoSyncTailMode::kAsyncAicEvent7:
    // The caller drains Cube and FIX independently. Join every upstream
    // matrix pipeline without making Scalar wait for device completion.
    set_flag(PIPE_MTE2, PIPE_MTE1, EVENT_ID7);
    wait_flag(PIPE_MTE2, PIPE_MTE1, EVENT_ID7);
    set_flag(PIPE_MTE1, PIPE_M, EVENT_ID7);
    wait_flag(PIPE_MTE1, PIPE_M, EVENT_ID7);
    set_flag(PIPE_M, PIPE_S, EVENT_ID7);
    set_flag(PIPE_M, PIPE_FIX, EVENT_ID7);
    wait_flag(PIPE_M, PIPE_FIX, EVENT_ID7);
    set_flag(PIPE_FIX, PIPE_S, EVENT_ID7);
    break;
  case PTOAutoSyncTailMode::kAsyncAivEvent7:
    // Join MTE2/V/MTE3 without a Scalar wait. The caller owns the final
    // MTE3->S event and must consume it before publishing completion.
    set_flag(PIPE_MTE2, PIPE_V, EVENT_ID7);
    wait_flag(PIPE_MTE2, PIPE_V, EVENT_ID7);
    // Diagnostic completion marker: the caller measures Vector separately
    // from MTE3 so a trailing store cannot be mistaken for compute overlap.
    set_flag(PIPE_V, PIPE_S, EVENT_ID7);
    set_flag(PIPE_V, PIPE_MTE3, EVENT_ID7);
    wait_flag(PIPE_V, PIPE_MTE3, EVENT_ID7);
    set_flag(PIPE_MTE3, PIPE_S, EVENT_ID7);
    break;
  case PTOAutoSyncTailMode::kSetWaitMte3ToSEvent0:
    set_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
    wait_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
    break;
  case PTOAutoSyncTailMode::kBarrierAll:
  default:
    pipe_barrier(PIPE_ALL);
    break;
  }
}

template <typename Ptr>
static AICORE inline void PTOAS__DCCI_SINGLE_CACHE_LINE(Ptr ptr) {
  dcci((__gm__ void*)ptr, cache_line_t::SINGLE_CACHE_LINE);
}

extern "C" AICORE void pypto_keep_prefix(int64_t);
extern "C" AICORE void pypto_wait_pre_task_end(__gm__ int64_t*, int64_t);
extern "C" AICORE void pypto_set_next_task_start(__gm__ int64_t*);
AICORE void branch_wait(__gm__ float* v1, __gm__ float* v2, __gm__ int64_t* v3, int64_t v4, int64_t v5) {
  using T = float;

  #if defined(__DAV_VEC__)
  // pto: %zero
  const int64_t v6 = 0;
  // pto: %one
  const int64_t v7 = 1;
  // pto: %two
  const int64_t v8 = 2;
  // pto: %cols
  const int64_t v9 = 32;
  // pto: %addr
  const int64_t v10 = 0;
  // pto: %shape_src
  const int64_t v11 = 1;
  // pto: %shape_src
  const int64_t v12 = 1;
  // pto: %shape_src
  const int64_t v13 = 1;
  // pto: %shape_src
  int64_t v14 = v7 * v9;
  // pto: %shape_src
  int64_t v15 = v13 * v14;
  // pto: %shape_src
  pto::Shape<1, 1, 1, 1, 32> v16 = pto::Shape<1, 1, 1, 1, 32>(v11, v12, v13, v7, v9);
  // pto: %shape_src
  pto::Stride<-1, -1, -1, -1, -1> v17 = pto::Stride<-1, -1, -1, -1, -1>(v12 * v15, v15, v14, v9, v7);
  // pto: %shape_src
  GlobalTensor<float, pto::Shape<1, 1, 1, 1, 32>, pto::Stride<-1, -1, -1, -1, -1>, pto::Layout::ND> v18 = GlobalTensor<float, pto::Shape<1, 1, 1, 1, 32>, pto::Stride<-1, -1, -1, -1, -1>, pto::Layout::ND>(v1, v16, v17);
  // pto: %shape_dst
  const int64_t v19 = 1;
  // pto: %shape_dst
  const int64_t v20 = 1;
  // pto: %shape_dst
  const int64_t v21 = 1;
  // pto: %shape_dst
  int64_t v22 = v7 * v9;
  // pto: %shape_dst
  int64_t v23 = v21 * v22;
  // pto: %shape_dst
  pto::Shape<1, 1, 1, 1, 32> v24 = pto::Shape<1, 1, 1, 1, 32>(v19, v20, v21, v7, v9);
  // pto: %shape_dst
  pto::Stride<-1, -1, -1, -1, -1> v25 = pto::Stride<-1, -1, -1, -1, -1>(v20 * v23, v23, v22, v9, v7);
  // pto: %shape_dst
  GlobalTensor<float, pto::Shape<1, 1, 1, 1, 32>, pto::Stride<-1, -1, -1, -1, -1>, pto::Layout::ND> v26 = GlobalTensor<float, pto::Shape<1, 1, 1, 1, 32>, pto::Stride<-1, -1, -1, -1, -1>, pto::Layout::ND>(v2, v24, v25);
  // pto: %view_src
  __gm__ float* v27 = PTOAS__GLOBAL_TENSOR_DATA(v18);
  // pto: %view_src
  pto::Shape<1, 1, 1, 1, 32> v28 = pto::Shape<1, 1, 1, 1, 32>();
  // pto: %view_src
  pto::Stride<32, 32, 32, 32, 1> v29 = pto::Stride<32, 32, 32, 32, 1>();
  // pto: %view_src
  GlobalTensor<float, pto::Shape<1, 1, 1, 1, 32>, pto::Stride<32, 32, 32, 32, 1>, pto::Layout::ND> v30 = GlobalTensor<float, pto::Shape<1, 1, 1, 1, 32>, pto::Stride<32, 32, 32, 32, 1>, pto::Layout::ND>(v27, v28, v29);
  // pto: %view_dst
  __gm__ float* v31 = PTOAS__GLOBAL_TENSOR_DATA(v26);
  // pto: %view_dst
  pto::Shape<1, 1, 1, 1, 32> v32 = pto::Shape<1, 1, 1, 1, 32>();
  // pto: %view_dst
  pto::Stride<32, 32, 32, 32, 1> v33 = pto::Stride<32, 32, 32, 32, 1>();
  // pto: %view_dst
  GlobalTensor<float, pto::Shape<1, 1, 1, 1, 32>, pto::Stride<32, 32, 32, 32, 1>, pto::Layout::ND> v34 = GlobalTensor<float, pto::Shape<1, 1, 1, 1, 32>, pto::Stride<32, 32, 32, 32, 1>, pto::Layout::ND>(v31, v32, v33);
  // pto: %tile
  Tile<TileType::Vec, float, 1, 32, BLayout::RowMajor, -1, -1, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null> v35 = Tile<TileType::Vec, float, 1, 32, BLayout::RowMajor, -1, -1, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>(v7, v9);
  // pto: %tile
  uint64_t v36 = (uint64_t) v10;
  TASSIGN(v35, v36);
  // pto: %positive
  // pto: %large
  // pto: %work
  int64_t v37;
  if (v5 > v6) {
    // pto: %inner
    ;
    int64_t v38;
    if (v5 > v8) {
      // pto: %plus
      ;
      v38 = (int64_t) ((uint64_t) v5 + (uint64_t) v8);
    } else {
      v38 = v8;
    };
    v37 = v38;
  } else {
    v37 = v7;
  }
  pypto_keep_prefix(v37);
  int64_t v39 = pypto_wait_local_boundary(v3, v4);
  const int64_t v40 = 0;
  if (v39 == v40) {
    return;
  }
  set_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
  for (int64_t v41 = v6; v41 < v37; v41 += v7) {
    wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
    TLOAD(v35, v30);
    set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    TSTORE(v34, v35);
    set_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
  }
  wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
  pypto_set_next_task_start(v3);
  #endif // __DAV_VEC__

  ptoas_auto_sync_tail(PTOAutoSyncTailMode::kRuntimeBarrierAll);
  return;
}