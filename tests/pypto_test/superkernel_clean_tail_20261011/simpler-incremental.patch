+TEST_F(TmrSchedulerExecutionInputsTest, CompiledPollRequiresEachMembersTailAndResetsOnReuse) {
+    for (int core_offset = 0; core_offset < 3; ++core_offset) {
+        initialize({table_a.data(), table_a.size()});
+        const auto member = static_cast<SubtaskSlot>(core_offset);
+        for (bool enabled : {true, false, true}) {
+            init_slot();
+            slot.active_mask = ActiveMask(SUBTASK_MASK_ALL);
+            payload.runtime_barrier_tail = SUBTASK_MASK_AIC | SUBTASK_MASK_AIV0;
+            payload.runtime_compiled_poll = enabled ? SUBTASK_MASK_AIC | SUBTASK_MASK_AIV1 : 0;
+            for (auto &dispatch : context->payload_per_core_[core_offset]) {
+                dispatch.global_context.late_handoff_scratch = ~uint64_t{0};
+            }
+            const auto handle = context->prepare_subtask_to_core(0, core_offset, slot, member, false, 0, false);
+            ASSERT_TRUE(handle.valid);
+            const auto &ctx = context->payload_per_core_[core_offset][handle.reg_task_id & 1u].global_context;
+            const auto expected = core_offset == 2 ? AsyncTailKind::None :
+                enabled && core_offset == 0 ? AsyncTailKind::RuntimeCompiledPollClean : AsyncTailKind::RuntimeBarrierAll;
+            EXPECT_EQ(ctx.async_tail_kind, static_cast<uint32_t>(expected));
+            EXPECT_EQ(ctx.late_handoff_scratch, 0u);
+            EXPECT_FALSE(slot.task_attrs.allow_early_resolve());
+        }
