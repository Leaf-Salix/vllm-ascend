@@ -263,0 +264,48 @@ TEST_F(TmrSchedulerExecutionInputsTest, CompiledPollRequiresEachMembersTailAndRe
+TEST_F(TmrSchedulerExecutionInputsTest, DirectPollResourcesRequireEachMembersCallbackAndResetOnReuse) {
+    for (int core_offset = 0; core_offset < 3; ++core_offset) {
+        initialize({table_a.data(), table_a.size()});
+        const auto member = static_cast<SubtaskSlot>(core_offset);
+        for (const bool enabled : {true, false, true}) {
+            init_slot();
+            slot.active_mask = ActiveMask(SUBTASK_MASK_ALL);
+            payload.runtime_barrier_tail = SUBTASK_MASK_ALL;
+            // AIV1 shares the offset but has no callback contract.
+            payload.runtime_compiled_poll = SUBTASK_MASK_AIC | SUBTASK_MASK_AIV0;
+            CoreTaskArgs args;
+            args.set_runtime_direct_poll_scratch(0, 64 * 1000);
+            ASSERT_FALSE(args.has_error);
+            payload.runtime_direct_poll_scratch = enabled ? args.runtime_direct_poll_scratch() : 0;
+            for (auto &dispatch : context->payload_per_core_[core_offset]) {
+                dispatch.global_context.late_handoff_scratch = ~uint64_t{0};
+            }
+            const auto handle = context->prepare_subtask_to_core(0, core_offset, slot, member, false, 0, false);
+            ASSERT_TRUE(handle.valid);
+            const auto &ctx = context->payload_per_core_[core_offset][handle.reg_task_id & 1u].global_context;
+            const bool direct = enabled && core_offset != 2;
+            const auto expected = core_offset == 2 ? AsyncTailKind::RuntimeBarrierAll :
+                direct ? AsyncTailKind::RuntimeDirectPollClean : AsyncTailKind::RuntimeCompiledPollClean;
+            EXPECT_EQ(ctx.async_tail_kind, static_cast<uint32_t>(expected));
+            EXPECT_EQ(ctx.late_handoff_scratch, direct && core_offset == 1 ? 64000u : 0u);
+            EXPECT_FALSE(slot.task_attrs.allow_early_resolve());
+            EXPECT_EQ(ctx.scalar_prefix, 0u);
+        }
+    }
+}
+
+TEST(TmrDirectPollArgs, EncodingRejectsAliasingAndClearRestoresCallback) {
+    CoreTaskArgs args;
+    args.set_runtime_direct_poll_scratch(0, 65534 * 64);
+    ASSERT_FALSE(args.has_error);
+    EXPECT_EQ(args.runtime_direct_poll_scratch(), 0xffff0001u);
+    args.clear();
+    EXPECT_EQ(args.runtime_direct_poll_scratch(), 0u);
+    args.set_runtime_direct_poll_scratch(-1, 64);
+    EXPECT_EQ(args.runtime_direct_poll_scratch(), 0x00020000u);
+    for (const int32_t invalid : {-2, 1, 65535 * 64}) {
+        args.reset();
+        args.set_runtime_direct_poll_scratch(invalid, -1);
+        EXPECT_TRUE(args.has_error);
+        EXPECT_EQ(args.runtime_direct_poll_scratch(), 0u);
+    }
+}
