@@ -317,0 +318,20 @@ struct Arg : TaskArgsTpl<TensorRef, uint64_t, MaxT, MaxS, TensorArgType> {
+    // Optional direct-notification resource contract. Zero means callback;
+    // each half otherwise encodes (64B scratch offset / 64) + 1. Both vector
+    // lanes use the same compiled AIV function and therefore the same offset.
+    // This representation covers local memories up to 4 MiB without growing
+    // TaskPayload. The compiler must also reserve notification event seven.
+    uint32_t runtime_direct_poll_scratch_{0};
+    void set_runtime_direct_poll_scratch(int32_t aic_base, int32_t aiv_base) {
+        auto encode = [](int32_t base) -> uint32_t {
+            return base < 0 ? 0u : static_cast<uint32_t>(base / 64 + 1);
+        };
+        for (const int32_t base : {aic_base, aiv_base}) {
+            if (base < -1 || base > 65534 * 64 || (base >= 0 && base % 64 != 0)) {
+                set_error("direct poll scratch must be -1 or a representable 64B-aligned offset");
+                return;
+            }
+        }
+        runtime_direct_poll_scratch_ = encode(aic_base) | (encode(aiv_base) << 16);
+    }
+    uint32_t runtime_direct_poll_scratch() const { return runtime_direct_poll_scratch_; }
+
