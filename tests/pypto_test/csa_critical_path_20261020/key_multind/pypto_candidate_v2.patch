+// Preserve a padded rank-3 ND source only on backends that can issue multi-ND
+// loads. Packed sources retain the established collapse and generated code.
+bool IsPaddedMultiNdMatSource(const std::vector<ExprPtr>& args) {
+  auto tensor = AsTensorTypeLike(args[0]->GetType());
+  if (!tensor || tensor->shape_.size() != 3 || !tensor->tensor_view_ ||
+      tensor->tensor_view_->layout != TensorLayout::ND || tensor->tensor_view_->stride.size() != 3) {
+    return false;
+  }
+  const auto packed = tensor_view_semantics::BuildRowMajorStrides(tensor->shape_);
+  const auto& stride = tensor->tensor_view_->stride;
+  const bool is_packed = std::equal(stride.begin(), stride.end(), packed.begin(),
+                                    [](const ExprPtr& a, const ExprPtr& b) { return structural_equal(a, b); });
+  if (is_packed) return false;
+  const auto* handler = PassContext::Current()->GetBackendHandler();
+  CHECK_SPAN(handler && handler->SupportsMultiNdMatLoad(), args[0]->span_)
+      << "padded rank-3 ND Mat loads are not supported on this backend; use per-page loads";
+  auto inner_stride = As<ConstInt>(stride.back());
+  CHECK_SPAN(inner_stride && inner_stride->value_ == 1, args[0]->span_)
+      << "multi-ND Mat load requires unit innermost stride";
+  return true;
+}
