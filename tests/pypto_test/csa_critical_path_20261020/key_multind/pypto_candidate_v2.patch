+TypePtr DeduceExplicitStrideViewType(const std::vector<ExprPtr>& args,
+                                     const std::vector<std::pair<std::string, std::any>>& kwargs) {
+  const auto span = args[0]->span_;
+  auto source = As<TensorType>(args[0]->GetType());
+  CHECK_SPAN(source && !As<DistributedTensorType>(args[0]->GetType()), span)
+      << "tensor.view explicit strides currently require a local GM Tensor";
+  CHECK_SPAN(source->dtype_ != DataType::FP4, span)
+      << "tensor.view explicit strides do not support sub-byte FP4 storage";
+  for (const auto& [name, value] : kwargs) {
+    if (name == "layout") {
+      CHECK_SPAN(AnyCast<TensorLayout>(value, "layout") == TensorLayout::ND, span)
+          << "tensor.view explicit strides currently support ND layout only";
+    }
+  }
+  if (source->tensor_view_) {
+    const auto& view = *source->tensor_view_;
+    CHECK_SPAN(view.layout == TensorLayout::ND, span)
+        << "tensor.view explicit strides require a packed ND source";
+    if (!view.stride.empty()) {
+      const auto packed = BuildRowMajorStrides(source->shape_);
+      CHECK_SPAN(view.stride.size() == packed.size() &&
+                     std::equal(view.stride.begin(), view.stride.end(), packed.begin(), ExprEqual), span)
+          << "tensor.view explicit strides require a packed ND source";
+    }
+    CHECK_SPAN(view.valid_shape.empty() ||
+                   (view.valid_shape.size() == source->shape_.size() &&
+                    std::equal(view.valid_shape.begin(), view.valid_shape.end(), source->shape_.begin(),
+                               ExprEqual)), span)
+        << "tensor.view explicit strides require a fully valid source";
+  }
+  auto shape_tuple = As<MakeTuple>(args[1]);
+  auto valid_tuple = As<MakeTuple>(args[2]);
+  auto stride_tuple = As<MakeTuple>(args[3]);
+  CHECK_SPAN(shape_tuple && valid_tuple && stride_tuple, span)
+      << "tensor.view shape, valid_shape and strides must be tuples";
+  const auto& shape = shape_tuple->elements_;
+  const auto& stride = stride_tuple->elements_;
+  CHECK_SPAN(!shape.empty() && shape.size() == stride.size(), span)
+      << "tensor.view strides must have the same nonzero rank as shape";
+  CHECK_SPAN(valid_tuple->elements_.empty() ||
+                 (valid_tuple->elements_.size() == shape.size() &&
+                  std::equal(valid_tuple->elements_.begin(), valid_tuple->elements_.end(), shape.begin(),
+                             ExprEqual)), span)
+      << "tensor.view explicit strides currently require a fully valid target";
+  int64_t static_end = 1;
+  bool static_span = true;
+  for (size_t i = 0; i < shape.size(); ++i) {
+    for (const auto& expr : {shape[i], stride[i]}) {
+      auto type = As<ScalarType>(expr->GetType());
+      CHECK_SPAN(type && type->dtype_.IsInt(), span)
+          << "tensor.view shape and strides must contain integer scalars";
+      if (auto constant = As<ConstInt>(expr)) {
+        CHECK_SPAN(constant->value_ > 0, span) << "tensor.view shape and strides must be positive";
+      }
+    }
+    auto extent = As<ConstInt>(shape[i]);
+    auto step = As<ConstInt>(stride[i]);
+    if (!extent || !step) {
+      static_span = false;
+    } else {
+      CHECK_SPAN(extent->value_ - 1 <= (std::numeric_limits<int64_t>::max() - static_end) / step->value_, span)
+          << "tensor.view explicit stride span overflows int64";
+      static_end += (extent->value_ - 1) * step->value_;
+    }
+  }
+  auto canonical = tensor_view_semantics::CheckCanonicalView(shape, stride, TensorLayout::ND, true);
+  CHECK_SPAN(canonical.ok, span) << "tensor.view explicit strides must describe non-overlapping ND rows: "
+                                 << canonical.reason;
+  int64_t capacity = 1;
+  bool static_capacity = true;
+  for (const auto& dim : source->shape_) {
+    if (auto extent = As<ConstInt>(dim)) {
+      CHECK_SPAN(extent->value_ > 0 && capacity <= std::numeric_limits<int64_t>::max() / extent->value_, span)
+          << "tensor.view source capacity must be positive and fit int64";
+      capacity *= extent->value_;
+    } else {
+      static_capacity = false;
+    }
+  }
+  CHECK_SPAN(!static_span || !static_capacity || static_end <= capacity, span)
+      << "tensor.view explicit stride span exceeds source storage capacity";
+  // Symbolic extents remain a caller contract, just as for existing dynamic
+  // tensor.slice/view. The operator must guard their positive, bounded span.
+  return std::make_shared<TensorType>(shape, source->dtype_, source->memref_,
+                                      TensorView(stride, TensorLayout::ND, shape));
+}
