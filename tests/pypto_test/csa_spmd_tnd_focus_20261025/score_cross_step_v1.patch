+                                        live_half_buf_key_l1_pool = pl.gather_row(
+                                            live_half_buf_key_l1_pool,
+                                            idx_kv_cache_shift64,
+                                            [live_half_buf_prime_key_page * BLOCK_SIZE, 0],
