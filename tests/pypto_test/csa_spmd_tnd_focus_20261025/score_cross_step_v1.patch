+                                live_half_split_qk_acc0, live_half_split_query0, live_half_buf_key_panel, init_cond=True
+                            )
+                            live_half_split_current0 = pl.tile.assemble(
+                                live_half_split_current0,
+                                live_half_split_qk0,
