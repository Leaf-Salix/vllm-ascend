+                                + live_half_buf_prime_col % (score_tile // 2)
+                                + live_half_buf_prime_key_page * BLOCK_SIZE
+                            )
+                            if balance_leaves:
+                                live_half_buf_prime_key_row = (
+                                    buf_logical_begin
+                                    + live_half_buf_score_begin
