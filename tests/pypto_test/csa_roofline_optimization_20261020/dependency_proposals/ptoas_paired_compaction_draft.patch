+      continue;
+    }
+    set_mask_norm();
+    set_vector_mask(-1, -1);
+    const unsigned repeats = (cols + 63) / 64;
+    for (unsigned rep = 0; rep < repeats; rep += 240) {
+      const unsigned num = repeats - rep < 240 ? repeats - rep : 240;
