+llvm::LogicalResult mlir::pto::TCompactCompareOp::verify() {
+  if (getTargetArch(getOperation()) != PTOArch::A3)
+    return emitOpError("compact compare currently requires A3");
+  auto mode = getCmpMode();
+  if (mode != CmpMode::EQ && mode != CmpMode::GT && mode != CmpMode::GE)
+    return emitOpError("compact compare supports eq/gt/ge");
+  for (Value value : {getSrc(), getValues(), getIndices(), getCount(), getTmp()}) {
+    Type type = value.getType();
+    if (failed(verifyTileBufCommon(getOperation(), type, "compact operand")) ||
+        !isRowMajorTileBuf(type))
+      return emitOpError("compact operands must be row-major tile buffers");
+    auto space = getPTOMemorySpaceEnum(type);
+    if (!space || *space != pto::AddressSpace::VEC)
+      return emitOpError("compact operands must be in vec memory");
+  }
+  if (!getElemTy(getSrc().getType()).isF32() ||
+      !getElemTy(getValues().getType()).isF32() ||
+      !getElemTy(getIndices().getType()).isInteger(32) ||
+      !getElemTy(getCount().getType()).isInteger(32) ||
+      !getElemTy(getTmp().getType()).isInteger(8))
+    return emitOpError("expects f32 src/values, i32 indices/count, i8 tmp");
+  auto src = getShapeVec(getSrc().getType());
+  auto values = getShapeVec(getValues().getType());
+  auto indices = getShapeVec(getIndices().getType());
+  auto count = getShapeVec(getCount().getType());
+  auto tmp = getShapeVec(getTmp().getType());
+  if (src.size() != 2 || values.size() != 2 || indices.size() != 2 ||
+      count.size() != 2 || tmp.size() != 2 ||
+      src[0] <= 0 || src[1] <= 0 || src[1] % 64 != 0)
+    return emitOpError("expects static 2D physical shapes and src cols divisible by 64");
+  if (values != indices || values[0] != src[0] || values[1] <= 0 ||
+      values[1] % 8 != 0 || values[1] > src[1])
+    return emitOpError("values/indices shapes must match, share src rows, and have aligned capacity <= src cols");
+  if (count[0] != 1 || count[1] < src[0] || count[1] % 8 != 0)
+    return emitOpError("count must be [1, aligned capacity >= src rows]");
+  const int64_t indexBytes = src[1] * 4;
+  const int64_t maskBytes = ((src[1] + 255) / 256) * 32;
+  const int64_t needed = indexBytes + std::max<int64_t>(1024, maskBytes + indexBytes);
+  if (tmp[0] <= 0 || tmp[1] <= 0 || tmp[0] * tmp[1] < needed)
+    return emitOpError("compact scratch is too small");
+  return success();
+}
