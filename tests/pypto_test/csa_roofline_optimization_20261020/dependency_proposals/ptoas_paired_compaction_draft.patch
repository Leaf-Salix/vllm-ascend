+  OpPipeInterface,
+  DeclareOpInterfaceMethods<MemoryEffectsOpInterface>
+]> {
+  let summary = "Stable bounded compaction of FP32 values and INT32 column indices";
+  let description = [{
+    A3 Vec prototype. A single scalar predicate selects corresponding values and
+    indices in source order. Index = offset + source column (integer arithmetic).
+    Each row produces an exact match count; only min(count, output capacity)
