+    `outs` `(` $values `,` $indices `,` $count `,` $tmp
+    `:` type($values) `,` type($indices) `,` type($count) `,` type($tmp) `)`
+    attr-dict
+  }];
+  let hasVerifier = 1;
+  let extraClassDeclaration = [{
+    ::mlir::pto::PIPE getPipe() { return ::mlir::pto::PIPE::PIPE_V; }
+    ::mlir::MutableOperandRange getDpsInitsMutable() {
+      return ::mlir::MutableOperandRange(getOperation(), 3, 3);
+    }
+  }];
+}
