index a98f880b0..2c44de3cf 100644
--- a/src/ir/op/tile_ops/gather.cpp
+++ b/src/ir/op/tile_ops/gather.cpp
@@ -511,5 +511,70 @@ REGISTER_OP("tile.gather_compare")
       return DeduceTileGatherCompareType(args, kwargs, "tile.gather_compare");
     });
 
+// 成对压缩是独立的三输出算子；tmp仅是scratch，不能被当作隐含返回值。
+static TypePtr DeduceTileCompactCompareType(
+    const std::vector<ExprPtr>& args,
+    const std::vector<std::pair<std::string, std::any>>& kwargs) {
+  CHECK(args.size() == 4)
+      << "tile.compact_compare requires src, kvalue, tmp, offset";
+  std::vector<ExprPtr> gather_args{args[0], args[1], args[2]};
+  auto pair = As<TupleType>(
+      DeduceTileGatherCompareType(gather_args, kwargs, "tile.compact_compare"));
+  INTERNAL_CHECK(pair) << "Internal error: gather deduction must return a tuple";
+  auto src = As<TileType>(args[0]->GetType());
+  CHECK(src->dtype_ == DataType::FP32)
+      << "tile.compact_compare currently requires FP32 src";
+  auto offset = As<ScalarType>(args[3]->GetType());
+  CHECK(offset && offset->dtype_ == DataType::INT32)
+      << "tile.compact_compare requires an INT32 scalar offset";
+  auto tmp = As<TileType>(args[2]->GetType());
+  CHECK(tmp->dtype_ == DataType::UINT8)
+      << "tile.compact_compare requires UINT8 tmp";
+  for (const auto& [key, value] : kwargs) {
+    if (key == "cmp_mode") {
+      const auto mode = AnyCast<int>(value, "cmp_mode");
+      CHECK(mode == 0 || mode == 4 || mode == 5)
+          << "tile.compact_compare supports eq/gt/ge";
+    }
+    if (key == "out_cols") {
+      const auto cols = AnyCast<int>(value, "out_cols");
+      CHECK(cols % 8 == 0) << "tile.compact_compare out_cols must be divisible by 8";
+      if (auto src_cols = As<ConstInt>(src->shape_[1]))
+        CHECK(cols <= src_cols->value_)
+            << "tile.compact_compare out_cols cannot exceed source columns";
+    }
+  }
+  if (auto cols = As<ConstInt>(src->shape_[1]))
+    CHECK(cols->value_ > 0 && cols->value_ % 64 == 0)
+        << "tile.compact_compare source columns must be divisible by 64";
+  auto indices = As<TileType>(pair->types_[0]);
+  auto values = std::make_shared<TileType>(
+      indices->shape_, DataType::FP32, std::nullopt, indices->tile_view_);
+  return std::make_shared<TupleType>(
+      std::vector<TypePtr>{values, pair->types_[0], pair->types_[1]});
+}
+
+REGISTER_OP("tile.compact_compare")
+    .set_op_category("TileOp")
+    .set_description("Stable bounded FP32 value/INT32 index compaction with exact counts")
+    .add_argument("src", "Source FP32 tile")
+    .add_argument("kvalue", "FP32 scalar comparison threshold")
+    .add_argument("tmp", "Explicit UINT8 workspace")
+    .add_argument("offset", "INT32 scalar index base")
+    .set_attr<int>("cmp_mode")
+    .set_attr<int>("out_cols")
+    .set_input_memory(0, MemorySpace::Vec)
+    .set_input_memory(2, MemorySpace::Vec)
+    .set_output_arity(3)
+    .set_arg_effect(0, ArgEffect::Read)
+    .set_arg_effect(1, ArgEffect::Read)
+    .set_arg_effect(2, ArgEffect::Write)
+    .set_arg_effect(3, ArgEffect::Read)
+    .set_workspace_arg(2)
+    .set_output_memory(MemorySpace::Vec)
+    .not_inplace_safe()
+    .set_lane_invariant_arg(2)
+    .f_deduce_type(DeduceTileCompactCompareType);
+
 }  // namespace ir
 }  // namespace pypto
