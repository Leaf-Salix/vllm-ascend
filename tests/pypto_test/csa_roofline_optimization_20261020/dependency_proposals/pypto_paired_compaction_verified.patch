                     return pl.tensor.gather(src, mask_pattern=1, kvalue=kv, cmp_mode="eq", out_cols=8)
 
 
+def _build_compact_program(rows=1, cols=64, capacity=32, mode="ge", offset_dtype=pl.INT32):
+    @pl.program
+    class Program:
+        @pl.function(type=pl.FunctionType.InCore)
+        def main(
+            self,
+            src: pl.Tensor[[rows, cols], pl.FP32],
+            threshold: pl.Scalar[pl.FP32],
+            offset: pl.Scalar[offset_dtype],
+            values_out: pl.Tensor[[rows, capacity], pl.FP32],
+            ids_out: pl.Tensor[[rows, capacity], pl.INT32],
+            counts_out: pl.Tensor[[1, rows], pl.INT32],
+        ):
+            values = pl.load(src, [0, 0], [rows, cols])
+            scratch = pl.tile.create([1, 18432], pl.UINT8)
+            packed, ids, counts = pl.tile.compact_compare(
+                values, threshold, scratch, offset, cmp_mode=mode, out_cols=capacity,
+            )
+            pl.store(packed, [0, 0], values_out)
+            pl.store(ids, [0, 0], ids_out)
+            pl.store(counts, [0, 0], counts_out)
+    return Program
+
+
+@pytest.mark.parametrize("rows", [1, 3, 8, 9])
+@pytest.mark.parametrize("mode", ["eq", "gt", "ge"])
+def test_compact_three_outputs_and_runtime_offset(rows, mode):
+    call = _find_call(_build_compact_program(rows=rows, mode=mode), "tile.compact_compare")
+    values, indices, counts = _tuple_elements(call)
+    assert _static_shape(values) == _static_shape(indices) == [rows, 32]
+    assert values.dtype == pl.FP32
+    assert indices.dtype == counts.dtype == pl.INT32
+    assert _static_shape(counts) == [1, ((rows + 7) // 8) * 8]
+    assert len(call.args) == 4
+    assert isinstance(call.args[3], _ir.Var)
+    assert call.args[3].type.dtype == pl.INT32
+    assert _ir.get_op_output_arity("tile.compact_compare") == 3
+    assert _ir.get_op_argument_count("tile.compact_compare") == 4
+    assert all(t.memory_space == _ir.MemorySpace.Vec for t in (values, indices, counts))
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "message"),
+    [
+        ({"mode": "lt"}, "supports eq/gt/ge"),
+        ({"capacity": 31}, "divisible by 8"),
+        ({"capacity": 128}, "cannot exceed"),
+        ({"cols": 72}, "divisible by 64"),
+        ({"offset_dtype": pl.INT64}, "INT32 scalar offset"),
+    ],
+)
+def test_compact_rejects_invalid_contract(kwargs, message):
+    with pytest.raises(InvalidOperationError, match=message):
+        _build_compact_program(**kwargs)
+
+
 if __name__ == "__main__":
     pytest.main([__file__, "-v"])
