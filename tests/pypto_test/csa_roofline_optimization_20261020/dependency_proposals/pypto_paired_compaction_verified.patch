@@ -731,6 +731,39 @@ static std::string MakeGatherCompareCodegenPTO(const CallPtr& op, codegen::Codeg
   return "";
 }
 
+static std::string MakeCompactCompareCodegenPTO(
+    const CallPtr& op, codegen::CodegenBase& codegen_base) {
+  auto& codegen = AsPto(codegen_base);
+  INTERNAL_CHECK_SPAN(op->args_.size() == 4, op->span_)
+      << "tile.compact_compare requires four arguments";
+  const auto outs = codegen.PrepareTupleOutputs(op);
+  INTERNAL_CHECK_SPAN(outs.size() == 3, op->span_)
+      << "tile.compact_compare must bind three outputs";
+  const int mode = op->GetKwarg<int>("cmp_mode");
+  static constexpr const char* kCmpNames[] = {"eq", "ne", "lt", "le", "gt", "ge"};
+  INTERNAL_CHECK_SPAN(mode >= 0 && mode < 6, op->span_) << "invalid compact compare mode";
+  std::ostringstream oss;
+  oss << "pto.tcompact.compare ins(";
+  const std::vector<int> inputs{0, 1, 3};
+  for (size_t i = 0; i < inputs.size(); ++i) {
+    if (i) oss << ", ";
+    oss << codegen.GetExprAsCode(op->args_[inputs[i]]);
+  }
+  oss << " : ";
+  for (size_t i = 0; i < inputs.size(); ++i) {
+    if (i) oss << ", ";
+    oss << codegen.GetExprTypeAnnotation(op->args_[inputs[i]]);
+  }
+  oss << ") outs(";
+  for (const auto& out : outs) oss << out.name << ", ";
+  oss << codegen.GetExprAsCode(op->args_[2]) << " : ";
+  for (const auto& out : outs) oss << out.type_str << ", ";
+  oss << codegen.GetExprTypeAnnotation(op->args_[2]) << ") {cmpMode = #pto<cmp "
+      << kCmpNames[mode] << ">}";
+  codegen.Emit(oss.str());
+  return "";
+}
+
