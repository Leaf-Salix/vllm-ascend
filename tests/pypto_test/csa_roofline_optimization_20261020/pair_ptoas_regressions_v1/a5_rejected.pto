// RUN: ptoas --pto-arch=a3 --enable-insert-sync %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a3 --enable-insert-sync --pto-insert-sync-debug=2 %s -o - 2>&1 | FileCheck %s --check-prefix=SYNC
// 验证三个DPS结果及动态INT32基址；设备位一致性另由成对压缩回归验证。

!src = !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!values = !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!indices = !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!count = !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!scratch = !pto.tile_buf<loc=vec, dtype=ui8, rows=1, cols=1280, v_row=1, v_col=1280, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module {
  func.func @compact_pair(%threshold: f32, %offset: i32) {
    %src = pto.alloc_tile : !src
    %values = pto.alloc_tile : !values
    %indices = pto.alloc_tile : !indices
    %count = pto.alloc_tile : !count
    %scratch = pto.alloc_tile : !scratch
    pto.tcompact.compare ins(%src, %threshold, %offset : !src, f32, i32)
      outs(%values, %indices, %count, %scratch : !values, !indices, !count, !scratch)
      {cmpMode = #pto<cmp ge>}
    return
  }
}

// CHECK: void compact_pair(float [[THRESHOLD:[_A-Za-z0-9]+]], int32_t [[OFFSET:[_A-Za-z0-9]+]])
// CHECK: PTOAS__COMPACT_COMPARE<Tile<{{.*}}CmpMode::GE>(
// CHECK-SAME: {{.*}}[[THRESHOLD]], {{.*}}[[OFFSET]]);
// SYNC-LABEL: After Sync Motion
// SYNC: COMPOUND pto.tcompact.compare [PIPE_V]
// SYNC-NEXT: COMPOUND pto.tcompact.compare [PIPE_V]
// SYNC-NEXT: COMPOUND pto.tcompact.compare [PIPE_S]
