+@pytest.mark.parametrize("cube", [False, True], ids=["vector", "cube"])
+def test_dispatch_notification_keeps_wrap_fallback_and_full_pipe_join(cube):
+    kind = ir.FunctionType.AIC if cube else ir.FunctionType.AIV
+    helper, entry = _compiled_late_poll(
+        SimpleNamespace(attrs={"task_boundary_scratch_base": 0}, func_type=kind)
+    )
+    assert "uint32_t expected = own | uint32_t{0x80000000}" in helper
+    assert "ctx->late_handoff_scratch & COMPILED_POLL_ID_REUSED" in helper
+    assert "expected = *value == 0 ? ~uint32_t{0} : 0" in helper
+    assert helper.index("const uint32_t own") < helper.index("COMPILED_POLL_ID_REUSED")
+    assert "set_vector_mask(0, 16)" in helper if not cube else "__cbuf__ uint32_t*" in helper
+    assert helper.index("pipe_barrier(PIPE_MTE3)") < helper.index("copy_")
+    assert "reinterpret_cast<__gm__ uint32_t*>(notice->value)" in helper
+    assert "*value == expected" in helper
+    assert "uint64_t{2}" in entry and "~uint64_t{3}" in entry
+
+
 def test_allocated_ids_reach_both_notification_endpoints():
     metadata = "// PYPTO_TASK_BOUNDARY_EVENTS_V1 producer MTE2=6 MTE1=7 M=7 FIX=7 V=5"
