diff --git a/tests/st/runtime/scheduling/task_boundary_notification_wrap_probe.py b/tests/st/runtime/scheduling/task_boundary_notification_wrap_probe.py
new file mode 100644
index 000000000..24a537d07
--- /dev/null
+++ b/tests/st/runtime/scheduling/task_boundary_notification_wrap_probe.py
@@ -0,0 +1,38 @@
+# Copyright (c) PyPTO Contributors.
+# Licensed under the CANN Open Software License Agreement Version 2.0.
+"""Exercise the 32-bit notification inversion path without billions of tasks."""
+
+from contextlib import contextmanager
+
+from pypto.backend import pto_backend
+
+if __package__:
+    from . import task_boundary_runtime_poll_probe as runtime_probe
+else:
+    import task_boundary_runtime_poll_probe as runtime_probe
+
+
+@contextmanager
+def instrument(mode, cube):
+    original = pto_backend._compiled_late_poll
+
+    def force_wrap(func):
+        helper, entry = original(func)
+        if helper:
+            condition = "(ctx->late_handoff_scratch & COMPILED_POLL_ID_REUSED) != 0"
+            assert helper.count(condition) == 1
+            helper = helper.replace(condition, "true")
+        return helper, entry
+
+    try:
+        pto_backend._compiled_late_poll = force_wrap
+        with runtime_probe.instrument(mode, cube):
+            yield
+    finally:
+        pto_backend._compiled_late_poll = original
+
+
+if __name__ == "__main__":
+    runtime_probe.probe.instrument = instrument
+    runtime_probe.probe.validate = runtime_probe.validate
+    runtime_probe.probe.main()
