--- a/src/a2a3/runtime/tensormap_and_ringbuffer/common/intrinsic.h
+++ b/src/a2a3/runtime/tensormap_and_ringbuffer/common/intrinsic.h
@@ -129,6 +129,10 @@ enum class AsyncTailKind : uint32_t {
     RuntimeDirectPollClean = 9,
 };
 
+// Compiled callbacks may use the unique register ID as their completion value
+// until the scheduler wraps it; subsequent callbacks read and invert the value.
+static constexpr uint32_t COMPILED_POLL_ID_REUSED = uint32_t{1} << 31;
+
 // Runtime-owned cache lines: Scalar never writes the DMA destination during
 // execution. A core alternates the two immutable sources after its previous
 // local tail has drained, including across dispatch-slot and graph replay reuse.
@@ -166,8 +170,8 @@ struct GlobalContext {
     // before touching dependent data or reusing local pipeline resources.
     volatile uint64_t wait_predecessor_fn;
     volatile uint64_t predecessor_context;
-    // Low 32 bits: compiler-reserved local scratch base. High bits are used
-    // only by explicit diagnostic traces, never by the normal polling path.
+    // Low 32 bits: direct-poll scratch base, or COMPILED_POLL_ID_REUSED for
+    // compiled callbacks. High bits belong to explicit diagnostic traces.
     volatile uint64_t late_handoff_scratch;
 };
 
