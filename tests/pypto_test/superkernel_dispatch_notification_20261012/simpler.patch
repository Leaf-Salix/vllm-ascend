+TEST_F(TmrSchedulerExecutionInputsTest, CompiledNotificationFallsBackAfterRegisterIdReuse) {
+    initialize({table_a.data(), table_a.size()});
+    auto &core = context->core_exec_states_[0];
+    core.dispatch_seq = AICORE_EXIT_SIGNAL - 2;
+    for (const uint32_t expected_id : {AICORE_EXIT_SIGNAL - 1, 0u, 1u}) {
+        init_slot();
+        payload.runtime_barrier_tail = SUBTASK_MASK_ALL;
+        payload.runtime_compiled_poll = SUBTASK_MASK_ALL;
+        const auto handle = context->prepare_subtask_to_core(0, 0, slot, SubtaskSlot::AIC, false, 0, false);
+        ASSERT_TRUE(handle.valid);
+        EXPECT_EQ(handle.reg_task_id, expected_id);
+        const auto &ctx = context->payload_per_core_[0][handle.reg_task_id & 1u].global_context;
+        const bool reused = expected_id < 2;
+        EXPECT_EQ(core.dispatch_id_reused, reused);
+        EXPECT_EQ(ctx.late_handoff_scratch, reused ? COMPILED_POLL_ID_REUSED : 0u);
+    }
+    // A later 32-bit counter rollover must not clear the sticky fallback.
+    core.dispatch_seq = UINT32_MAX;
+    const auto wrapped = context->prepare_subtask_to_core(0, 0, slot, SubtaskSlot::AIC, false, 0, false);
+    ASSERT_TRUE(wrapped.valid);
+    EXPECT_EQ(wrapped.reg_task_id, 0u);
+    EXPECT_EQ(context->payload_per_core_[0][0].global_context.late_handoff_scratch, COMPILED_POLL_ID_REUSED);
+
+    CoreTaskArgs args;
+    args.set_runtime_direct_poll_scratch(64, -1);
+    payload.runtime_direct_poll_scratch = args.runtime_direct_poll_scratch();
+    const auto direct = context->prepare_subtask_to_core(0, 0, slot, SubtaskSlot::AIC, false, 0, false);
+    ASSERT_TRUE(direct.valid);
+    const auto &ctx = context->payload_per_core_[0][direct.reg_task_id & 1u].global_context;
+    EXPECT_EQ(ctx.async_tail_kind, static_cast<uint32_t>(AsyncTailKind::RuntimeDirectPollClean));
+    EXPECT_EQ(ctx.late_handoff_scratch, 64u);
+
+    initialize({table_a.data(), table_a.size()});
+    EXPECT_FALSE(core.dispatch_id_reused);
+}
