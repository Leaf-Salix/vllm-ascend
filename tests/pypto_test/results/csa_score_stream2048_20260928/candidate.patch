+        large_pairs = pl.mrgsort(large_pairs, block_len=256)
+        large_pairs = pl.mrgsort(large_pairs, block_len=1024)
+        root = pl.tile.extract(large_pairs, 0, 0, [1, TOPK_PAIR_WIDTH], target_memory=pl.MemorySpace.Vec)
+    return root
 
 
