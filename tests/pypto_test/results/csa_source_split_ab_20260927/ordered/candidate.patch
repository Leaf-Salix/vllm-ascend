+++ b/vllm_ascend/ops/pypto/deepseek_v4_flash_dspark_perf/split_storage.py
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Experimental planar Indexer allocation; no device copy or new owner."""
+
+import torch
+
+KEY_BYTES = 32 * 128
+SCALE_BYTES = 32 * 2
+PAGE_BYTES = KEY_BYTES + SCALE_BYTES
+
+
+def split_indexer_views(raw, key_shape, scale_shape):
+    pages = key_shape[0]
+    if (tuple(key_shape) != (pages, 32, 1, 128)
+            or tuple(scale_shape) != (pages, 32, 1, 1)
+            or raw.dtype != torch.int8 or not raw.is_contiguous()
+            or raw.numel() != pages * PAGE_BYTES):
+        raise ValueError("Planar Indexer requires A3 C4 INT8 keys and FP16 scales")
+    flat = raw.view(-1)
+    return [flat[:pages * KEY_BYTES].view(key_shape),
+            flat[pages * KEY_BYTES:].view(torch.float16).view(scale_shape)]
+
+
+def indexer_storage(key, scale):
+    pages = key.shape[0]
+    if (key.dtype != torch.int8 or tuple(key.shape) != (pages, 32, 1, 128)
+            or scale.dtype != torch.float16 or tuple(scale.shape) != (pages, 32, 1, 1)
+            or not key.is_contiguous() or not scale.is_contiguous()):
+        raise ValueError("Experimental PTO requires planar Indexer key/scale views")
+    if (key.untyped_storage().data_ptr() != scale.untyped_storage().data_ptr()
+            or scale.storage_offset() * 2 != key.storage_offset() + pages * KEY_BYTES
+            or key.storage_offset() + pages * PAGE_BYTES > key.untyped_storage().nbytes()):
+        raise ValueError("Planar key/scale must cover disjoint regions of one allocation")
+    # Root tensor transports bytes, not interleaved pages. All subviews are
+    # derived inside PTO, keeping the graph ABI to one writable owner.
+    return key.as_strided((pages, PAGE_BYTES), (PAGE_BYTES, 1), key.storage_offset())
