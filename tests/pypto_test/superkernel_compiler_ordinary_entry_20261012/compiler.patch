diff --git a/tests/ut/backend/test_tmr_synchronous_entry.py b/tests/ut/backend/test_tmr_synchronous_entry.py
new file mode 100644
index 000000000..575877409
--- /dev/null
+++ b/tests/ut/backend/test_tmr_synchronous_entry.py
@@ -0,0 +1,83 @@
+# Copyright (c) PyPTO Contributors.
+# Licensed under the CANN Open Software License Agreement Version 2.0.
+"""Conservative compiler proof for the ordinary TMR executor path."""
+
+import pytest
+from pypto import DataType, backend
+from pypto.backend import pto_backend
+from pypto.backend.pto_backend import _with_tmr_synchronous_entries
+from pypto.pypto_core import ir, passes
+
+
+@pytest.fixture(autouse=True)
+def configure_backend():
+    backend.set_backend_type(backend.BackendType.Ascend910B)
+
+
+def _entry(attrs=None, op_name=None, helper=False, function_type=ir.FunctionType.AIV):
+    span = ir.Span.unknown()
+    body = ir.ReturnStmt([], span)
+    if op_name or helper:
+        op = ir.GlobalVar("opaque_helper") if helper else ir.get_op(op_name)
+        call = ir.Call(op, [], {}, ir.ScalarType(DataType.INT64), span)
+        body = ir.SeqStmts([ir.EvalStmt(call, span), body], span)
+    return ir.Function("entry", [], [], body, span, function_type, attrs=attrs)
+
+
+def _proof(func, runtime=passes.RuntimeKind.TENSORMAP_AND_RINGBUFFER):
+    program = ir.Program([func], "test", func.span)
+    derived = _with_tmr_synchronous_entries(program, runtime)
+    return dict(next(iter(derived.functions.values())).attrs).get("tmr_synchronous_entry", False)
+
+
+@pytest.mark.parametrize("function_type", [ir.FunctionType.AIC, ir.FunctionType.AIV])
+def test_compiler_owned_synchronous_entry(function_type):
+    assert _proof(_entry(function_type=function_type))
+
+
+@pytest.mark.parametrize(
+    "attrs",
+    [
+        {"external_source": "/unopened/external.cpp"},
+        {"builtin_template_dir": ":unopened.template"},
+        {"async_aic_return": True},
+        {"async_aiv_return": True},
+        {"scalar_prefix": True},
+    ],
+)
+def test_opaque_and_legacy_entries_cannot_supply_own_proof(attrs):
+    assert not _proof(_entry({**attrs, "tmr_synchronous_entry": True}))
+
+
+@pytest.mark.parametrize(
+    "op_name",
+    [
+        "system.wait_pre_task_end",
+        "system.set_next_task_start",
+        "system.wait_predecessor",
+        "pld.system.defer_wait",
+    ],
+)
+def test_overlap_or_deferred_operations_cannot_be_ordinary(op_name):
+    assert not _proof(_entry({"tmr_synchronous_entry": True}, op_name=op_name))
+
+
+def test_unresolved_helper_is_not_assumed_synchronous():
+    assert not _proof(_entry({"tmr_synchronous_entry": True}, helper=True))
+
+
+def test_hbg_does_not_receive_tmr_contract():
+    assert not _proof(_entry({"tmr_synchronous_entry": True}), passes.RuntimeKind.HOST_BUILD_GRAPH)
+
+
+def test_non_incore_function_does_not_receive_contract():
+    assert not _proof(_entry({"tmr_synchronous_entry": True}, function_type=ir.FunctionType.Opaque))
+
+
+def test_other_platform_does_not_receive_a2a3_contract(monkeypatch):
+    class OtherHandler:
+        def get_default_sim_platform(self):
+            return "a5sim"
+
+    monkeypatch.setattr(pto_backend._backend_core, "get_handler", lambda: OtherHandler())
+    assert not _proof(_entry({"tmr_synchronous_entry": True}))
