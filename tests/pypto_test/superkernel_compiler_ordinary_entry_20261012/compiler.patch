+
+def _with_tmr_synchronous_entries(
+    program: _ir_core.Program, runtime: _passes.RuntimeKind
+) -> _ir_core.Program:
+    """Prove ordinary entry wrappers without changing the user's launch policy.
+
+    Only complete, compiler-owned AIC/AIV bodies are eligible. External,
+    template, legacy async, deferred-completion and unresolved helper entries
+    keep the conservative runtime path. This metadata is derived here even
+    if a caller supplied an attribute with the same name.
+    """
+    functions = []
+    for func in program.functions.values():
+        attrs = dict(func.attrs)
+        had_contract = "tmr_synchronous_entry" in attrs
+        attrs.pop("tmr_synchronous_entry", None)
+        eligible = (
+            runtime == _passes.RuntimeKind.TENSORMAP_AND_RINGBUFFER
+            and _backend_core.get_handler().get_default_sim_platform() == "a2a3sim"
+            and func.func_type in (_ir_core.FunctionType.AIC, _ir_core.FunctionType.AIV)
+            and not func.requires_runtime_binding
+            and _external_source_of(func) is None
+            and _builtin_template_of(func) is None
+            and not any(
+                attrs.get(key, False) for key in ("async_aic_return", "async_aiv_return", "scalar_prefix")
+            )
+            and not _function_uses_ops(
+                func, _SCALAR_PREFIX_WAIT_OPS | _LOCAL_TASK_SIGNAL_OPS | _DEFERRED_COMPLETION_OPS
+            )
+        )
+        if eligible:
+            calls = _CallCollector()
+            calls.visit_stmt(func.body)
+            eligible = not calls.callee_names
+        if eligible:
+            attrs["tmr_synchronous_entry"] = True
+        if not eligible and not had_contract:
+            functions.append(func)
+            continue
+        functions.append(
+            _ir_core.Function(
+                func.name,
+                list(zip(func.params, func.param_directions)),
+                func.return_types,
+                func.body,
+                func.span,
+                func.func_type,
+                func.level,
+                func.role,
+                attrs,
+                func.requires_runtime_binding,
+                func.ir_stage,
+            )
+        )
+    return _ir_core.Program(functions, program.name, program.span)
