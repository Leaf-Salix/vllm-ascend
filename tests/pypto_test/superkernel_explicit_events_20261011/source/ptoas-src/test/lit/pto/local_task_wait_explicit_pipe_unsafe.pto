// RUN: not ptoas --enable-insert-sync --pto-level=level3 %s 2>&1 | FileCheck %s
// CHECK: unsafe operation before Scalar-prefix wait boundary

module attributes {pto.target_arch = "a2a3"} {
  func.func @unsafe_event_prefix(%raw: !pto.ptr<i64>, %handoff: i64)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.scalar_prefix, pto.runtime_late_handoff} {
    pto.set_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID0>]
    func.call @pypto_wait_pre_task_end(%raw, %handoff) : (!pto.ptr<i64>, i64) -> ()
    return
  }
  func.func private @pypto_wait_pre_task_end(!pto.ptr<i64>, i64)
}
