// RUN: ptoas --enable-insert-sync --pto-level=level3 %s 2>&1 | FileCheck %s

// CHECK-LABEL: AICORE void manual_safe_id(
// CHECK: TLOAD(
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
// CHECK-NEXT: wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
// CHECK-NEXT: TSTORE(
// CHECK-LABEL: AICORE void manual_other_pair(
// CHECK: set_flag(PIPE_V, PIPE_MTE2, EVENT_ID7);
// CHECK-NEXT: wait_flag(PIPE_V, PIPE_MTE2, EVENT_ID7);
// CHECK-LABEL: AICORE void manual_high_level(
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
// CHECK-NEXT: wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
// CHECK-LABEL: AICORE void manual_constant_dynamic(
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3,
// CHECK: wait_flag(PIPE_MTE2, PIPE_MTE3,
// CHECK-LABEL: AICORE void manual_unrelated_dynamic(
// CHECK: set_flag(PIPE_V, PIPE_MTE2,
// CHECK: wait_flag(PIPE_V, PIPE_MTE2,
// CHECK-LABEL: AICORE void unmarked_event7(
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID7);
// CHECK-NEXT: wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID7);

module attributes {pto.target_arch = "a2a3"} {
  func.func @manual_safe_id(%src: !pto.ptr<f32>, %dst: !pto.ptr<f32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff, pto.auto_sync_tail_hint = "runtime_barrier_all"} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %cols = arith.constant 32 : index
    %addr = arith.constant 0 : i64
    %shape_src = pto.make_tensor_view %src, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<1x32xf32>
    %shape_dst = pto.make_tensor_view %dst, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<1x32xf32>
    %view_src = pto.partition_view %shape_src, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<1x32xf32> -> !pto.partition_tensor_view<1x32xf32>
    %view_dst = pto.partition_view %shape_dst, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<1x32xf32> -> !pto.partition_tensor_view<1x32xf32>
    %tile = pto.alloc_tile addr = %addr valid_row = %one valid_col = %cols : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tload ins(%view_src : !pto.partition_tensor_view<1x32xf32>) outs(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.set_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.tstore ins(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%view_dst : !pto.partition_tensor_view<1x32xf32>)
    return
  }
  func.func @manual_other_pair() attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE2>, <EVENT_ID7>]
    return
  }
  func.func @manual_high_level() attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.record_event [#pto.pipe_event_type<TLOAD>, #pto.pipe_event_type<TSTORE_VEC>, #pto.event<EVENT_ID0>]
    pto.wait_event [#pto.pipe_event_type<TLOAD>, #pto.pipe_event_type<TSTORE_VEC>, #pto.event<EVENT_ID0>]
    return
  }
  func.func @manual_constant_dynamic() attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    %id = arith.constant 6 : index
    pto.set_flag_dyn [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_MTE3>, %id]
    pto.wait_flag_dyn [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_MTE3>, %id]
    return
  }
  func.func @manual_unrelated_dynamic(%id: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag_dyn [#pto.pipe<PIPE_V>, #pto.pipe<PIPE_MTE2>, %id]
    pto.wait_flag_dyn [#pto.pipe<PIPE_V>, #pto.pipe<PIPE_MTE2>, %id]
    return
  }
  func.func @unmarked_event7() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.set_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID7>]
    return
  }
}
