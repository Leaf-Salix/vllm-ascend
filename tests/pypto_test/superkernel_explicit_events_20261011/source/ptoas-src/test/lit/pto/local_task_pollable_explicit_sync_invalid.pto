// RUN: not ptoas --enable-insert-sync --pto-level=level3 %s 2>&1 | FileCheck %s
// CHECK: late task handoff reserves EVENT_ID7 on this notification pipe pair

module attributes {pto.target_arch = "a2a3"} {
  func.func @manual_tail() attributes {
      pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID7>]
    return
  }
}
