+
+static LogicalResult checkTaskBoundaryEvent(Operation *op, PIPE src, PIPE dst,
+                                            std::optional<int64_t> event) {
+  if (!usesTaskBoundaryEvent7(src, dst))
+    return success();
+  if (!event)
+    return op->emitError("late task handoff requires a statically known event ID "
+                         "on notification pipe pairs; EVENT_ID7 must remain free");
+  if (*event == 7)
+    return op->emitError("late task handoff reserves EVENT_ID7 on this notification pipe pair");
+  return success();
+}
+
+template <typename Op>
+static LogicalResult checkStaticTaskBoundaryEvent(Op op) {
+  return checkTaskBoundaryEvent(op, op.getSrcPipe().getPipe(),
+                                op.getDstPipe().getPipe(),
+                                static_cast<int64_t>(op.getEventId().getEvent()));
+}
+
+template <typename Op>
+static LogicalResult checkDynamicTaskBoundaryEvent(Op op) {
+  APInt value;
+  std::optional<int64_t> event;
+  if (matchPattern(op.getEventId(), m_ConstantInt(&value)))
+    event = value.getSExtValue();
+  return checkTaskBoundaryEvent(op, op.getSrcPipe().getPipe(),
+                                op.getDstPipe().getPipe(), event);
+}
+
+template <typename Op>
+static LogicalResult checkHighLevelTaskBoundaryEvent(Op op) {
+  auto src = parseSyncOpTypeLikeAttr(op.getSrcOpAttr());
+  auto dst = parseSyncOpTypeLikeAttr(op.getDstOpAttr());
+  if (failed(src) || failed(dst))
+    return op.emitError("cannot resolve explicit task-boundary event pipe pair");
+  return checkTaskBoundaryEvent(op, mapSyncOpTypeToPipe(*src),
+                                mapSyncOpTypeToPipe(*dst),
+                                static_cast<int64_t>(op.getEventId().getEvent()));
+}
+
+static LogicalResult checkExplicitTaskBoundaryEvents(func::FuncOp func) {
+  WalkResult result = func.walk([&](Operation *op) {
+    LogicalResult status = success();
+    if (auto set = dyn_cast<SetFlagOp>(op))
+      status = checkStaticTaskBoundaryEvent(set);
+    else if (auto wait = dyn_cast<WaitFlagOp>(op))
+      status = checkStaticTaskBoundaryEvent(wait);
+    else if (auto set = dyn_cast<SetFlagDynOp>(op))
+      status = checkDynamicTaskBoundaryEvent(set);
+    else if (auto wait = dyn_cast<WaitFlagDynOp>(op))
+      status = checkDynamicTaskBoundaryEvent(wait);
+    else if (auto record = dyn_cast<RecordEventOp>(op))
+      status = checkHighLevelTaskBoundaryEvent(record);
+    else if (auto wait = dyn_cast<WaitEventOp>(op))
+      status = checkHighLevelTaskBoundaryEvent(wait);
+    return failed(status) ? WalkResult::interrupt() : WalkResult::advance();
+  });
+  return failure(result.wasInterrupted());
