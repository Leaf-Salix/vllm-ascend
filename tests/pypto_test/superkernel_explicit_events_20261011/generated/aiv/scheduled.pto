    %14 = arith.maxsi %13, %c0 : index
    %15 = pto.partition_view %1, offsets = [%14, %c0], sizes = [%c64, %c256] : !pto.tensor_view<?x?xf32>
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.tstore ins(%11 : !pto.tile_buf<vec, 64x256xf32, valid=?x?>) outs(%15 : !pto.partition_tensor_view<64x256xf32>) {layout = #pto.layout<nd>}
