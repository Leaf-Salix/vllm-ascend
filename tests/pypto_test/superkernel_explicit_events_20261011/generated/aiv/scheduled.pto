    %5 = arith.muli %2, %c32 : index
    %6 = arith.addi %5, %c23 : index
    pto.store %4, %arg0[%6] {pto.scalar_prefix_store} : !pto.ptr<i64, gm>, i64
    %7 = pto.alloc_tile addr = %c64_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<vec, 64x256xf16, valid=?x?>
    %8 = arith.muli %2, %c64 : index
    %9 = arith.maxsi %8, %c0 : index
    %10 = pto.partition_view %0, offsets = [%9, %c0], sizes = [%c64, %c256] : !pto.tensor_view<?x?xf16>
    pto.tload ins(%10 : !pto.partition_tensor_view<64x256xf16>) outs(%7 : !pto.tile_buf<vec, 64x256xf16, valid=?x?>) {layout = #pto.layout<nd>}
    pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    %11 = pto.alloc_tile addr = %c32832_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<vec, 64x256xf32, valid=?x?>
    pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    pto.tcvt ins(%7 {rmode = #pto<round_mode ROUND>, satmode = #pto<saturation_mode ON>} : !pto.tile_buf<vec, 64x256xf16, valid=?x?>) outs(%11 : !pto.tile_buf<vec, 64x256xf32, valid=?x?>)
    %12 = arith.index_cast %arg3 : i64 to index
    scf.for %arg8 = %c0 to %12 step %c1 {
      %16 = pto.alloc_tile addr = %c32832_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<vec, 64x256xf32, valid=?x?>
      pto.barrier <PIPE_V>
