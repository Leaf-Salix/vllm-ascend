    %1 = pto.make_tensor_view %arg2, shape = [%c3088, %c256], strides = [%c256, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
    %2 = arith.index_cast %arg6 : i32 to index
