+@pytest.mark.parametrize("reuse", [False, True])
+def test_local_tail_scratch_does_not_alias_fifo_or_tiles(reuse):
+    """A local tail owns a cache line after explicit FIFO storage on both planner paths."""
+
+    @pl.program
+    class Before:
+        @pl.function(type=pl.FunctionType.AIV)
+        def main(self, x: pl.Tensor[[8, 32], pl.FP32], out: pl.Out[pl.Tensor[[8, 32], pl.FP32]]):
+            pl.system.wait_pre_task_end()
+            _fifo = pl.reserve_buffer(name="shared_fifo", size=4096)
+            value = pl.load(x, [0, 0], [8, 32], target_memory=pl.Mem.Vec)
+            pl.store(pl.add(value, 1.0), [0, 0], out)
+            pl.system.set_next_task_start()
+
+    program = passes.init_mem_ref()(Before)
+    if reuse:
+        program = passes.memory_reuse()(program)
+    program = passes.allocate_memory_addr()(program)
+    func = next(iter(program.functions.values()))
+    assert dict(func.attrs)["task_boundary_scratch_base"] == 4096
+    assert isinstance(func.body, ir.SeqStmts)
+    addresses = [
+        stmt.var.type.memref.byte_offset_.value
+        for stmt in func.body.stmts
+        if isinstance(stmt, ir.AssignStmt) and isinstance(stmt.var.type, ir.TileType)
+    ]
+    assert addresses and all(offset >= 4160 for offset in addresses)
