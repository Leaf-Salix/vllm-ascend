+    def test_branch_wait_with_work_keeps_captures_and_entry_load_after_join(self):
+        """Each selected Scalar prefix runs before one Wait; tile work stays after it."""
+
+        @pl.program
+        class Before:
+            @pl.function(type=pl.FunctionType.InCore)
+            def kernel(
+                self,
+                x: pl.Tensor[[16, 32], pl.FP32],
+                out: pl.Out[pl.Tensor[[16, 32], pl.FP32]],
+                seed: pl.Scalar[pl.FP32],
+                choose: pl.Scalar[pl.BOOL],
+            ):
+                if choose:
+                    value = seed * 3.0
+                    bias = seed + 1.0
+                    pl.system.wait_pre_task_end()
+                    result = pl.add(x, value)
+                    result = pl.add(result, bias)
+                    out[0:16, 0:32] = result
+                else:
+                    value = seed * 5.0
+                    pl.system.wait_pre_task_end()
+                    result = pl.mul(x, value)
+                    out[0:16, 0:32] = result
+                pl.system.set_next_task_start()
+                return  # noqa: PLR1711 (DSL return terminator)
+
+        @pl.program
+        class Expected:
+            @pl.function(type=pl.FunctionType.InCore)
+            def kernel(
+                self,
+                x: pl.Tensor[[16, 32], pl.FP32],
+                out: pl.Out[pl.Tensor[[16, 32], pl.FP32]],
+                seed: pl.Scalar[pl.FP32],
+                choose: pl.Scalar[pl.BOOL],
+            ):
+                if choose:
+                    value = seed * 3.0
+                    bias = seed + 1.0
+                    joined_value, joined_bias = pl.yield_(value, bias)
+                else:
+                    value = seed * 5.0
+                    joined_value, joined_bias = pl.yield_(value, 0.0)
+                pl.system.wait_pre_task_end()
+                tile = pl.load(x, [0, 0], [16, 32])
+                if choose:
+                    result = pl.tile.adds(tile, joined_value)
+                    result = pl.tile.adds(result, joined_bias)
+                    _stored = pl.store(result, [0, 0], out)
+                    out_join, result_join, value_join = pl.yield_(_stored, result, joined_value)
+                else:
+                    result = pl.tile.muls(tile, joined_value)
+                    _stored = pl.store(result, [0, 0], out)
+                    out_join, result_join, value_join = pl.yield_(_stored, result, joined_value)
+                pl.system.set_next_task_start()
+                return  # noqa: PLR1711 (DSL return terminator)
+
+        _assert_convert_equal(passes.convert_to_ssa()(Before), passes.convert_to_ssa()(Expected))
+
