+// Split a top-level, two-arm manual boundary without speculating either arm.
+// Each arm must contain one direct statement Wait. Nested boundary regions and
+// loop boundaries remain subject to PTOAS's existing verifier. This visits
+// disjoint top-level branch bodies a constant number of times (O(N)), apart
+// from fresh-name lookups; it does not repeatedly rescan nested subtrees.
+StmtPtr NormalizeBranchTaskWaits(const FunctionPtr& function) {
+  const auto& body = function->body_;
+  if (!GetTaskBoundaryMarkers(function).wait) return body;
+  struct Arm {
+    std::vector<StmtPtr> prefix;
+    StmtPtr suffix;
+    StmtPtr wait;
+    std::vector<VarPtr> captures;
+  };
+  auto split = [](const StmtPtr& region) -> std::optional<Arm> {
+    class WaitCounter : public IRVisitor {
+     public:
+      size_t count = 0;
+      void VisitExpr_(const CallPtr& call) override {
+        count += IsOp(call, "system.wait_pre_task_end");
+        IRVisitor::VisitExpr_(call);
+      }
+    } waits;
+    waits.VisitStmt(region);
+    if (waits.count != 1) return std::nullopt;
+    auto statements = FlattenToStmts(region);
+    auto boundary = std::find_if(statements.begin(), statements.end(), [](const StmtPtr& stmt) {
+      auto eval = As<EvalStmt>(stmt);
+      auto call = eval ? As<Call>(eval->expr_) : nullptr;
+      return IsOp(call, "system.wait_pre_task_end") && call->args_.empty() && call->kwargs_.empty() &&
+             call->attrs_.empty();
+    });
+    if (boundary == statements.end()) return std::nullopt;
+    Arm arm{{statements.begin(), boundary},
+            SeqStmts::Flatten({std::next(boundary), statements.end()}, region->span_),
+            *boundary,
+            {}};
+    var_collectors::VarDefUseCollector uses;
+    uses.VisitStmt(arm.suffix);
+    // Shapes/strides can reference a prefix Scalar without using it as an
+    // explicit call operand. Include those references before selecting captures.
+    for (const auto* var : uses.GetAllVarRefs()) {
+      var_collectors::VisitTypeExprFields(uses, var->GetType());
+    }
+    auto capture = [&](const VarPtr& var) {
+      if (uses.var_uses.count(var.get())) arm.captures.push_back(var);
+    };
+    for (const auto& stmt : arm.prefix) {
+      if (auto assign = As<AssignStmt>(stmt))
+        capture(assign->var_);
+      else if (auto branch = As<IfStmt>(stmt)) {
+        for (const auto& var : branch->return_vars_) capture(var);
+      } else if (auto loop = As<ForStmt>(stmt)) {
+        for (const auto& var : loop->return_vars_) capture(var);
+      } else if (auto loop = As<WhileStmt>(stmt)) {
+        for (const auto& var : loop->return_vars_) capture(var);
+      }
+    }
+    for (const auto& var : arm.captures) {
+      // Unchosen arms supply inert Scalar values. Tensor/tile descriptors
+      // need a separate representation; never invent a dummy device buffer.
+      auto scalar = As<ScalarType>(var->GetType());
+      if (!scalar || !(scalar->dtype_ == DataType::BOOL || scalar->dtype_.IsFloat() ||
+                       scalar->dtype_.IsInt() || scalar->dtype_.IsIndexLike()))
+        return std::nullopt;
+    }
+    return arm;
+  };
+  auto zero = [](const VarPtr& var) -> ExprPtr {
+    auto dtype = As<ScalarType>(var->GetType())->dtype_;
+    if (dtype == DataType::BOOL) return std::make_shared<ConstBool>(false, var->span_);
+    if (dtype.IsFloat()) return std::make_shared<ConstFloat>(0.0, dtype, var->span_);
+    return std::make_shared<ConstInt>(0, dtype, var->span_);
+  };
+  var_collectors::VarDefUseCollector all_vars;
+  all_vars.VisitStmt(body);
+  std::unordered_set<std::string> names;
+  for (const auto& param : function->params_) names.insert(param->name_hint_);
+  for (auto* var : all_vars.GetAllVarRefs()) names.insert(var->name_hint_);
+  size_t next_name = 0;
+  auto fresh = [&](const TypePtr& type, const Span& span) {
+    std::string name;
+    do {
+      name = "task_wait_value_" + std::to_string(next_name++);
+    } while (!names.insert(name).second);
+    return std::make_shared<Var>(name, type, span);
+  };
+  std::vector<StmtPtr> result;
+  for (const auto& stmt : FlattenToStmts(body)) {
+    auto branch = As<IfStmt>(stmt);
+    if (!branch || !branch->else_body_ || EndsWithLocalTaskWait(stmt)) {
+      result.push_back(stmt);
+      continue;
+    }
+    auto left = split(branch->then_body_);
+    auto right = split(*branch->else_body_);
+    if (!left || !right) {
+      result.push_back(stmt);
+      continue;
+    }
+    ExprPtr condition = branch->condition_;
+    if (!As<Var>(condition) && !As<ConstBool>(condition)) {
+      auto choice = fresh(condition->GetType(), condition->span_);
+      result.push_back(std::make_shared<AssignStmt>(choice, condition, condition->span_));
+      condition = choice;  // Evaluate even a complex condition exactly once.
+    }
+    std::vector<VarPtr> carried;
+    std::vector<ExprPtr> left_yields, right_yields;
+    std::unordered_map<const Var*, VarPtr> replacements;
+    auto join = [&](const VarPtr& lhs, const VarPtr& rhs) {
+      auto sample = lhs ? lhs : rhs;
+      auto joined = fresh(sample->GetType(), sample->span_);
+      carried.push_back(joined);
+      if (lhs) replacements[lhs.get()] = joined;
+      if (rhs) replacements[rhs.get()] = joined;
+      left_yields.push_back(lhs ? ExprPtr(lhs) : zero(sample));
+      right_yields.push_back(rhs ? ExprPtr(rhs) : zero(sample));
+    };
+    // Mutually exclusive suffixes can share a carrier of the same Scalar type.
+    // Keep max(left_count, right_count) per dtype, not their sum: the latter
+    // needlessly doubles values that must remain live across the runtime Wait.
+    std::unordered_map<uint8_t, std::vector<size_t>> right_by_dtype;
+    std::unordered_map<uint8_t, size_t> next_right;
+    std::vector<bool> paired(right->captures.size(), false);
+    for (size_t i = 0; i < right->captures.size(); ++i) {
+      right_by_dtype[As<ScalarType>(right->captures[i]->GetType())->dtype_.Code()].push_back(i);
+    }
+    for (const auto& lhs : left->captures) {
+      auto dtype = As<ScalarType>(lhs->GetType())->dtype_.Code();
+      const auto& candidates = right_by_dtype[dtype];
+      auto& index = next_right[dtype];
+      if (index == candidates.size())
+        join(lhs, nullptr);
+      else {
+        auto slot = candidates[index++];
+        paired[slot] = true;
+        join(lhs, right->captures[slot]);
+      }
+    }
+    for (size_t i = 0; i < right->captures.size(); ++i) {
+      if (!paired[i]) join(nullptr, right->captures[i]);
+    }
+    left->prefix.push_back(std::make_shared<YieldStmt>(left_yields, branch->span_));
+    right->prefix.push_back(std::make_shared<YieldStmt>(right_yields, branch->span_));
+    result.push_back(std::make_shared<IfStmt>(condition, SeqStmts::Flatten(left->prefix, branch->span_),
+                                              SeqStmts::Flatten(right->prefix, branch->span_), carried,
+                                              branch->span_, branch->leading_comments_));
+    result.push_back(left->wait);
+    result.push_back(std::make_shared<IfStmt>(
+        condition, transform_utils::Substitute(left->suffix, replacements),
+        transform_utils::Substitute(right->suffix, replacements), branch->return_vars_, branch->span_));
+  }
+  return SeqStmts::Flatten(std::move(result), body->span_);
+}
+
