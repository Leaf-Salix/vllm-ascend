+static bool isRuntimeTailPipeOp(StringRef name) {
+  // PIPE_ALL joins each physical member before FIN; the runtime retains the
+  // existing MIX group completion count. These operations keep their own
+  // cross-core synchronization, unlike the legacy event-7 tail contracts.
+  return name == "pto.reserve_buffer" || name == "pto.import_reserved_buffer" ||
+         name == "pto.aic_initialize_pipe" || name == "pto.aiv_initialize_pipe" ||
+         name == "pto.tpush_to_aic" || name == "pto.tpush_to_aiv" ||
+         name == "pto.tpop_from_aic" || name == "pto.tpop_from_aiv" ||
+         name == "pto.tfree_from_aic" || name == "pto.tfree_from_aiv" ||
+         name == "pto.set_ffts" || name == "pto.sync.set" || name == "pto.sync.wait";
+}
