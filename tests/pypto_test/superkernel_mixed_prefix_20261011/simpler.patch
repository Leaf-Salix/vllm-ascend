+TEST_F(TmrSchedulerExecutionInputsTest, MixedPrefixCapabilitiesBelongToEachPhysicalMember) {
+    for (const int core_offset : {0, 1, 2}) {
+        init_slot();
+        initialize({table_a.data(), table_a.size()});
