--- a/python/pypto/backend/pto_backend.py
+++ b/python/pypto/backend/pto_backend.py
@@ -1141,0 +1142,42 @@ static __aicore__ __attribute__((noinline)) void pypto_poll_local_tail(__gm__ in
+def _apply_task_boundary_relay(func_name: str, helper: str, ptoas_code: str) -> tuple[str, str, set[str]]:
+    """Join the full tail through free compute-pipe events when direct IDs run out."""
+    marker = "// PYPTO_TASK_BOUNDARY_RELAY_V1 "
+    vector = ("MTE2_TO_V", "V_TO_MTE3")
+    cube = ("MTE2_TO_MTE1", "MTE1_TO_M", "M_TO_FIX", "FIX_TO_MTE3")
+    allocations = {}
+    for line in ptoas_code.splitlines():
+        if not line.startswith(marker):
+            continue
+        fields = line[len(marker) :].split()
+        if not fields or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", fields[0]) or fields[0] in allocations:
+            raise ValueError(f"invalid or duplicate PTOAS tail-relay contract: {line}")
+        pairs = [re.fullmatch(r"([A-Z0-9_]+)=([0-7])", field) for field in fields[1:]]
+        if not all(pairs) or tuple(pair[1] for pair in pairs) not in (vector, cube):
+            raise ValueError(f"invalid PTOAS tail-relay pipe chain: {line}")
+        allocations[fields[0]] = [(pair[1], pair[2]) for pair in pairs]
+    if func_name in allocations:
+        if not helper:
+            raise ValueError(f"PTOAS requested a tail relay for {func_name} without a tail callback")
+        is_cube = "copy_cbuf_to_gm(" in helper
+        expected = cube if is_cube else vector
+        if tuple(pair for pair, _ in allocations[func_name]) != expected:
+            raise ValueError(f"PTOAS tail relay does not match the physical core of {func_name}")
+        engines = ("MTE2", "MTE1", "M", "FIX") if is_cube else ("MTE2", "V")
+        original = "\n".join(
+            f"    {op}_flag(PIPE_{engine}, PIPE_MTE3, EVENT_ID7);"
+            for op in ("set", "wait")
+            for engine in engines
+        )
+        if helper.count(original) != 1:
+            raise ValueError(f"incomplete direct notification joins for {func_name}")
+        relay = []
+        for pair, event in allocations[func_name]:
+            src, dst = pair.split("_TO_")
+            # Wait executes on dst, not Scalar. Each following Set on dst
+            # carries the prior joins forward to the final MTE3 notification.
+            relay.extend(f"    {op}_flag(PIPE_{src}, PIPE_{dst}, EVENT_ID{event});" for op in ("set", "wait"))
+        helper = helper.replace(original, "\n".join(relay))
+    contract = "#define PYPTO_TASK_BOUNDARY_RELAY_V1 1\n" if allocations else ""
+    return helper, contract, set(allocations)
+
+
@@ -1149 +1191 @@ def _apply_task_boundary_events(func_name: str, helper: str, ptoas_code: str) ->
-    contract = ""
+    helper, contract, relays = _apply_task_boundary_relay(func_name, helper, ptoas_code)
@@ -1160 +1202 @@ def _apply_task_boundary_events(func_name: str, helper: str, ptoas_code: str) ->
-        contract = "#define PYPTO_TASK_BOUNDARY_BLOCKING_POLL_V1 1\n"
+        contract += "#define PYPTO_TASK_BOUNDARY_BLOCKING_POLL_V1 1\n"
@@ -1184,0 +1227,8 @@ static __aicore__ __attribute__((noinline)) void pypto_poll_local_tail(__gm__ in
+    if (
+        blocking.intersection(allocations)
+        or blocking.intersection(relays)
+        or relays.intersection(allocations)
+    ):
+        raise ValueError(
+            "PTOAS requested both blocking, direct, or relayed notification contracts for one task"
+        )
@@ -1187,2 +1236,0 @@ static __aicore__ __attribute__((noinline)) void pypto_poll_local_tail(__gm__ in
-    if blocking.intersection(allocations):
-        raise ValueError("PTOAS requested both blocking poll and notification events for the same task")
