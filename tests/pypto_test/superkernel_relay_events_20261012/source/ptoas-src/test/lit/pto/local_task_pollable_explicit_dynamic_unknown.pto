// RUN: ptoas --enable-insert-sync --pto-level=level3 %s 2>&1 | FileCheck %s
// CHECK: // PYPTO_TASK_BOUNDARY_RELAY_V1 manual_dynamic MTE2_TO_V=7 V_TO_MTE3=7
// CHECK: #error relayed tail notification requires a matching PyPTO wrapper
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3,
// CHECK: wait_flag(PIPE_MTE2, PIPE_MTE3,
module attributes {pto.target_arch = "a2a3"} {
  func.func @manual_dynamic(%id: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag_dyn [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_MTE3>, %id]
    pto.wait_flag_dyn [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_MTE3>, %id]
    return
  }
}
