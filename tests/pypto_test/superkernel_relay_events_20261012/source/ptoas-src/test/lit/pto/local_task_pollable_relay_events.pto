// RUN: ptoas --enable-insert-sync --pto-level=level3 %s 2>&1 | FileCheck %s
// CHECK: // PYPTO_TASK_BOUNDARY_RELAY_V1 vector_relay MTE2_TO_V=6 V_TO_MTE3=7
// CHECK: // PYPTO_TASK_BOUNDARY_RELAY_V1 cube_relay MTE2_TO_MTE1=6 MTE1_TO_M=5 M_TO_FIX=4 FIX_TO_MTE3=3
// CHECK: // PYPTO_TASK_BOUNDARY_BLOCKING_POLL_V1 no_free_route
// CHECK: #error blocking tail poll requires a matching PyPTO wrapper
// CHECK: void vector_relay
// CHECK: set_flag(PIPE_MTE2, PIPE_V, EVENT_ID7)
// CHECK: wait_flag(PIPE_MTE2, PIPE_V, EVENT_ID7)
// CHECK: void cube_relay
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE1, EVENT_ID7)
// CHECK: void no_free_route
module attributes {pto.target_arch = "a2a3"} {
  func.func @vector_relay(%id: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag_dyn [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_MTE3>, %id]
    pto.wait_flag_dyn [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_MTE3>, %id]
    pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID7>]
    return
  }
  func.func @cube_relay(%id: index) attributes {pto.kernel_kind = #pto.kernel_kind<cube>, pto.runtime_late_handoff} {
    pto.set_flag_dyn [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_MTE3>, %id]
    pto.wait_flag_dyn [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_MTE3>, %id]
    pto.set_flag[<PIPE_MTE2>, <PIPE_MTE1>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE1>, <EVENT_ID7>]
    pto.set_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID7>]
    pto.set_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID6>]
    pto.wait_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID6>]
    // Include every possible branch outcome when reserving the relay IDs.
    %c4 = arith.constant 4 : index
    %c5 = arith.constant 5 : index
    %c6 = arith.constant 6 : index
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %bit = arith.andi %id, %c1 : index
    %cond = arith.cmpi eq, %bit, %c0 : index
    %f = arith.addi %bit, %c6 : index
    %m = arith.select %cond, %c5, %f : index
    %fix = arith.select %cond, %c4, %m : index
    pto.set_flag_dyn [#pto.pipe<PIPE_M>, #pto.pipe<PIPE_FIX>, %m]
    pto.wait_flag_dyn [#pto.pipe<PIPE_M>, #pto.pipe<PIPE_FIX>, %m]
    pto.set_flag_dyn [#pto.pipe<PIPE_FIX>, #pto.pipe<PIPE_MTE3>, %fix]
    pto.wait_flag_dyn [#pto.pipe<PIPE_FIX>, #pto.pipe<PIPE_MTE3>, %fix]
    return
  }
  func.func @no_free_route(%id: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag_dyn [#pto.pipe<PIPE_V>, #pto.pipe<PIPE_MTE3>, %id]
    pto.wait_flag_dyn [#pto.pipe<PIPE_V>, #pto.pipe<PIPE_MTE3>, %id]
    return
  }
}
