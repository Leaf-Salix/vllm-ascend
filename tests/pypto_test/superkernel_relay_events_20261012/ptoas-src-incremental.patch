@@ -184,0 +186 @@ public:
+        if (allocateRelay(func)) return success();
@@ -199 +201,27 @@ private:
-  std::array<uint8_t, 5> used{};
+  int freeId(unsigned pair) const {
+    int id = 7;
+    while (id >= 0 && (used[pair] & (1u << id))) --id;
+    return id;
+  }
+
+  bool allocateRelay(func::FuncOp func) {
+    auto kind = func->getAttrOfType<FunctionKernelKindAttr>(FunctionKernelKindAttr::name);
+    if (!kind) return false;
+    SmallVector<unsigned, 4> pairs;
+    if (kind.getKernelKind() == FunctionKernelKind::Cube)
+      pairs = {5, 6, 7, 3};
+    else if (kind.getKernelKind() == FunctionKernelKind::Vector)
+      pairs = {8, 4};
+    else
+      return false;
+    SmallVector<int32_t, 4> chosen;
+    for (unsigned pair : pairs) {
+      int id = freeId(pair);
+      if (id < 0) return false;
+      chosen.push_back(id);
+    }
+    func->setAttr(kTaskBoundaryRelayIds, DenseI32ArrayAttr::get(func.getContext(), chosen));
+    return true;
+  }
+
+  std::array<uint8_t, 9> used{};
@@ -239,0 +268 @@ struct PTOInsertSyncPass : public mlir::pto::impl::PTOInsertSyncBase<PTOInsertSy
+      func->removeAttr(kTaskBoundaryRelayIds);
