+            metadata += " " + std::string(pair) + "=" + std::to_string(ids[i]);
+          }
+          metadata += "\n#ifndef PYPTO_TASK_BOUNDARY_RELAY_V1\n"
+                      "#error relayed tail notification requires a matching PyPTO wrapper\n#endif";
+          builder.create<emitc::VerbatimOp>(func.getLoc(), builder.getStringAttr(metadata));
+          return;
+        }
