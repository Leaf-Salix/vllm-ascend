+@pytest.mark.parametrize("cube", [False, True], ids=["vector", "cube"])
+def test_normal_callback_omits_optional_trace_but_instrumentation_keeps_it(cube):
+    kind = ir.FunctionType.AIC if cube else ir.FunctionType.AIV
+    attrs = {"task_boundary_scratch_base": 0}
+    plain, entry = _compiled_late_poll(SimpleNamespace(attrs=attrs, func_type=kind))
+    traced, traced_entry = _compiled_late_poll(
+        SimpleNamespace(attrs={**attrs, "async_return_trace": object()}, func_type=kind)
+    )
+    assert "scalar_overlap_trace" not in plain
+    assert "late_handoff_scratch |= uint64_t{1} << 32" in traced
+    assert _with_compiled_poll_trace(plain) == traced
+    assert _with_compiled_poll_trace(traced) == traced
+    assert traced_entry == entry
+    assert traced.index("pipe_barrier(PIPE_MTE3)") < traced.index("const bool trace")
+    assert traced.index("const bool trace") < traced.index("for (;;)")
+
+
+def test_optional_trace_does_not_invent_a_notification_for_blocking_fallback():
+    marker = "// PYPTO_TASK_BOUNDARY_BLOCKING_POLL_V1 producer"
+    helper, _ = _apply_task_boundary_events("producer", vector_helper(), marker)
+    assert "pipe_barrier(PIPE_ALL)" in helper
+    assert _with_compiled_poll_trace(helper) == helper
+    assert _with_compiled_poll_trace("") == ""
+
+
