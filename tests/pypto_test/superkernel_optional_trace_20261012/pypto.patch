+def _with_compiled_poll_trace(code: str) -> str:
+    """Enable notification accounting only in explicitly instrumented code."""
+    accounting = (
+        "    const bool trace = ctx->scalar_overlap_trace != 0;\n"
+        "    if (trace) ctx->late_handoff_scratch |= uint64_t{1} << 32;\n"
+    )
+    if accounting in code:
+        return code
+    marker = "    for (;;) {\n        uint32_t next;\n"
+    if code.count(marker) > 1:
+        raise ValueError("expected at most one compiled local-tail poll in a kernel wrapper")
+    # A task without a callback, or with the blocking resource fallback, has
+    # no notification to account for. Preserve those paths unchanged.
+    return code.replace(marker, accounting + marker, 1)
+
