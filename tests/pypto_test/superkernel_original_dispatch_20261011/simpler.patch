+TEST_F(TmrSchedulerExecutionInputsTest, ScalarPrefixKeepsIdleCoreAheadOfMatchingBusyProducer) {
+    initialize({table_a.data(), table_a.size()});
+    ChipTaskSlotState producer{};
+    TaskDescriptor producer_task{};
+    TaskPayload producer_payload{};
+    producer.task = &producer_task;
+    producer.payload = &producer_payload;
+    producer.active_mask = ActiveMask(SUBTASK_MASK_AIV0);
+    producer.logical_block_num = 1;
+    producer.total_required_subtasks = 1;
+    producer_payload.published_block_count.store(1);
+    DepListEntry fanout{&slot, nullptr};
+    producer.fanout_head = &fanout;
+    ASSERT_TRUE(context->prepare_subtask_to_core(0, 1, producer, SubtaskSlot::AIV0, false, 0, false).valid);
+    context->core_trackers_[0].clear_pending_occupied(1);
+
+    slot.active_mask = ActiveMask(SUBTASK_MASK_AIV0);
+    payload.scalar_prefix = true;
+    payload.fanin_actual_count = 1;
+    payload.fanin_inline_edges[0].set(&producer, DEP_WAIT);
+    payload.fanin_wait_count = 1;
+    payload.early_dispatch_state.store(EARLY_DISPATCH_STAGING);
+    slot.fanin_count = 1;
+    ASSERT_TRUE(sched.early_dispatch_queues[static_cast<int>(ResourceShape::AIV)].push_tagged(&slot, 0));
+    ASSERT_EQ(context->early_dispatch_shape(0, ResourceShape::AIV, CoreTracker::DispatchPhase::IDLE), 1);
+    EXPECT_EQ(context->core_exec_states_[1].pending_slot_state, nullptr);
+    EXPECT_EQ(context->core_exec_states_[2].running_slot_state, &slot);
