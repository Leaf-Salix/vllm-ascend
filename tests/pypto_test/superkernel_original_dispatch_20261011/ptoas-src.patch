+// INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.
+// See LICENSE in the root of the software repository for the full text of the License.
+
+// RUN: ptoas --enable-insert-sync --pto-level=level3 %s 2>&1 | FileCheck %s
+// CHECK-LABEL: case PTOAutoSyncTailMode::kRuntimeBarrierAll:
+// CHECK-NEXT: {{.*}}dynamic caller{{.*}}
+// CHECK: break;
+// CHECK-LABEL: AICORE void runtime_tail_vector(
+// CHECK-NOT: pipe_barrier(PIPE_ALL)
+// CHECK-NOT: EVENT_ID7
+// CHECK: TSTORE(
+// CHECK: ptoas_auto_sync_tail(PTOAutoSyncTailMode::kRuntimeBarrierAll);
+
+module attributes {pto.target_arch = "a2a3"} {
+  func.func @runtime_tail_vector(%src: !pto.ptr<f32>, %dst: !pto.ptr<f32>)
+      attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.auto_sync_tail_hint = "runtime_barrier_all"} {
+    %zero = arith.constant 0 : index
+    %one = arith.constant 1 : index
+    %cols = arith.constant 32 : index
+    %addr = arith.constant 0 : i64
+    %shape_src = pto.make_tensor_view %src, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<1x32xf32>
+    %shape_dst = pto.make_tensor_view %dst, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<1x32xf32>
+    %view_src = pto.partition_view %shape_src, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<1x32xf32> -> !pto.partition_tensor_view<1x32xf32>
+    %view_dst = pto.partition_view %shape_dst, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<1x32xf32> -> !pto.partition_tensor_view<1x32xf32>
+    %tile = pto.alloc_tile addr = %addr valid_row = %one valid_col = %cols : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
+    pto.tload ins(%view_src : !pto.partition_tensor_view<1x32xf32>) outs(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
+    pto.tstore ins(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%view_dst : !pto.partition_tensor_view<1x32xf32>)
+    return
+  }
+}
