+def test_local_boundaries_preserve_submit_early_resolve():
+    @pl.program
+    class P:
+        @pl.function(type=pl.FunctionType.InCore)
+        def k(
+            self, x: pl.Tensor[[128], pl.FP32], out: pl.Out[pl.Tensor[[128], pl.FP32]]
+        ) -> pl.Tensor[[128], pl.FP32]:
+            pl.system.wait_pre_task_end()
+            value = pl.load(x, [0], [128])
+            out = pl.store(value, [0], out)
+            pl.system.set_next_task_start()
+            return out
+
+        @pl.function(type=pl.FunctionType.Orchestration)
+        def main(
+            self, x: pl.Tensor[[128], pl.FP32], out: pl.Out[pl.Tensor[[128], pl.FP32]]
+        ) -> pl.Tensor[[128], pl.FP32]:
+            with pl.manual_scope():
+                first = pl.create_tensor([128], dtype=pl.FP32)
+                second = pl.create_tensor([128], dtype=pl.FP32)
+                first, a = pl.submit(self.k, x, first, allow_early_resolve=False)
+                second, b = pl.submit(self.k, first, second, deps=[a], allow_early_resolve=True)
+                out, _ = pl.submit(self.k, second, out, deps=[b])
+            return out
+
+    code = _generate_orch_full_pipeline(P)
+    assert code.count("set_allow_early_resolve(true)") == 1, code
+    assert "params_t1.set_allow_early_resolve(true);" in code, code
+    assert code.count("set_runtime_barrier_tail(true)") == 3, code
+    assert code.count("set_scalar_prefix(true)") == 3, code
+
+
