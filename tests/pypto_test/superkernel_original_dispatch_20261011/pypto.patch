diff --git a/tests/st/runtime/scheduling/task_boundary_no_successor_demo.py b/tests/st/runtime/scheduling/task_boundary_no_successor_demo.py
new file mode 100644
index 000000000..761905ba6
--- /dev/null
+++ b/tests/st/runtime/scheduling/task_boundary_no_successor_demo.py
@@ -0,0 +1,145 @@
+# Copyright (c) PyPTO Contributors.
+# This program is free software, you can redistribute it and/or modify it under the terms and conditions of
+# CANN Open Software License Agreement Version 2.0 (the "License").
+# Please refer to the License for details. You may not use this file except in compliance with the License.
+# THIS SOFTWARE IS PROVIDED ON AN "AS IS" BASIS, WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED,
+# INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.
+# See LICENSE in the root of the software repository for the full text of the License.
+# -----------------------------------------------------------------------------------------------------------
+
+"""Compare ordinary and marked single-task graphs: no core has a successor."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+from statistics import mean
+
+import pypto.language as pl
+import torch
+from pypto.ir._kernel_compile import kernel_abi_for_program
+from pypto.ir.compile import _compile_impl
+from pypto.pypto_core.passes import RuntimeKind
+from pypto.runtime import RunConfig
+from pypto.runtime._kernel_artifact import KernelArtifact
+
+
+@pl.jit
+def ordinary(
+    x: pl.Tensor[[1536, 256], pl.FP32],
+    out: pl.Out[pl.Tensor[[1536, 256], pl.FP32]],
+    loops: pl.Scalar[pl.INT64],
+):
+    with pl.spmd(48, name_hint="only_task"):
+        offset = pl.tile.get_block_idx() * 32
+        value = pl.load(x, [offset, 0], [32, 256])
+        for _ in pl.range(loops):
+            value = pl.add(value, 1.0)
+        pl.store(value, [offset, 0], out)
+    return out
+
+
+@pl.jit
+def marked(
+    x: pl.Tensor[[1536, 256], pl.FP32],
+    out: pl.Out[pl.Tensor[[1536, 256], pl.FP32]],
+    loops: pl.Scalar[pl.INT64],
+):
+    with pl.spmd(48, name_hint="only_task"):
+        offset = pl.tile.get_block_idx() * 32
+        pl.system.wait_pre_task_end()
+        value = pl.load(x, [offset, 0], [32, 256])
+        for _ in pl.range(loops):
+            value = pl.add(value, 1.0)
+        pl.store(value, [offset, 0], out)
+        pl.system.set_next_task_start()
+    return out
+
+
+def artifact(fn, directory, compile_only):
+    meta = torch.empty((1536, 256), dtype=torch.float32, device="meta")
+    program = fn.specialize(meta, meta, 1)
+    abi = kernel_abi_for_program(program, platform="a2a3", runtime="tensormap_and_ringbuffer")
+    if compile_only:
+        opts = RunConfig(platform="a2a3").compile_kwargs()
+        opts.update(output_dir=str(directory / "build"), runtime=RuntimeKind.TENSORMAP_AND_RINGBUFFER)
+        result = _compile_impl(program, _kernel_abi=abi, **opts)
+    else:
+        result = KernelArtifact(directory / "build", abi)
+    result.load()
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--compile", action="store_true")
+    parser.add_argument("--compiled", type=Path, required=True)
+    parser.add_argument("--output", type=Path)
+    parser.add_argument("--device", type=int)
+    args = parser.parse_args()
+    names = ("ordinary", "marked")
+    artifacts = [
+        artifact(fn, args.compiled / name, args.compile) for name, fn in zip(names, (ordinary, marked))
+    ]
+    if args.compile:
+        return
+    assert os.environ.get("TASK_DEVICE") == str(args.device)
+    # Keep device imports out of CPU compilation.
+    import torch_npu  # noqa: PLC0415
+    from pypto.runtime.kernel.context import get_process_kernel_state  # noqa: PLC0415
+    from pypto.torch import init  # noqa: PLC0415
+    from pypto.torch.launch import enqueue  # noqa: PLC0415
+
+    torch_npu.npu.set_device(args.device)
+    init(device=args.device, platform="a2a3", runtime="tensormap_and_ringbuffer")
+    runtime = get_process_kernel_state()
+    registrations = [runtime.ensure_callable(a, runtime.require_config()) for a in artifacts]
+    source = (torch.arange(1536 * 256, dtype=torch.float32) % 31).reshape(1536, 256).npu(args.device)
+    outputs = [torch.empty_like(source) for _ in names]
+    report = {"scope": "one 48-block AIV task, one block per core, no following task", "shapes": []}
+    try:
+        for loops in (1, 64):
+            graphs = []
+            for registration, out in zip(registrations, outputs):
+                enqueue(registration, (source, out, loops))
+                torch_npu.npu.synchronize()
+                assert torch.equal(out.cpu(), source.cpu() + loops)
+                graph = torch_npu.npu.NPUGraph()
+                with torch_npu.npu.graph(graph):
+                    enqueue(registration, (source, out, loops))
+                graphs.append(graph)
+                for _ in range(5):
+                    graph.replay()
+            torch_npu.npu.synchronize()
+            start, end = (torch_npu.npu.Event(enable_timing=True) for _ in range(2))
+            start.record()
+            end.record()
+            end.synchronize()
+            samples = []
+            for repeat in range(30):
+                for offset in range(2):
+                    mode = (repeat + offset) % 2
+                    start.record()
+                    graphs[mode].replay()
+                    end.record()
+                    end.synchronize()
+                    samples.append(
+                        {"repeat": repeat, "variant": names[mode], "us": start.elapsed_time(end) * 1000}
+                    )
+            stats = {}
+            for name in names:
+                times = [s["us"] for s in samples if s["variant"] == name]
+                stats[name] = {"min": min(times), "mean": mean(times), "max": max(times)}
+            report["shapes"].append({"loops": loops, "exact": True, "stats": stats, "samples": samples})
+            print(json.dumps({"loops": loops, "stats": stats}), flush=True)
+            for graph in graphs:
+                graph.reset()
+    finally:
+        runtime.drain()
+        runtime.close()
+    args.output.mkdir(parents=True, exist_ok=True)
+    (args.output / "results.json").write_text(json.dumps(report, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
