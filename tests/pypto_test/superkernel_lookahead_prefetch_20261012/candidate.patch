+++ b/src/a2a3/runtime/tensormap_and_ringbuffer/runtime/scheduler/scheduler_dispatch.cpp
@@ -686,9 +686,29 @@ int32_t SchedulerContext::stage_consumer_blocks(
     // buckets fit one handles[] buffer.
     PublishHandle handles[CoreTracker::MAX_CLUSTERS * 3];
     int n = 0;
+    bool has_overlap = false;
+    for (uint32_t subslot = 0; subslot < SUBTASK_SLOT_COUNT; ++subslot) {
+        if ((c->active_mask.core_mask() & (1u << subslot)) != 0) {
+            has_overlap |=
+                (c->payload->overlap_contracts[subslot].prefix & TaskPayload::OverlapContract::SYNCHRONOUS_ENTRY) == 0;
+        }
+    }
+    const size_t extra_line_offset =
+        has_overlap ? offsetof(DispatchPayload, global_context) + offsetof(GlobalContext, submitted_overlap) : 0;
+    const bool is_mix = shape == ResourceShape::MIX;
     auto prepare_from = [&](CoreTracker::BitStates &avail, bool to_pending) {
+        if (count > 0 && avail.has_value()) {
+            auto ahead = avail;
+            prefetch_block_dst(thread_idx, ahead.pop_first(), is_mix, extra_line_offset);
+        }
         while (count > 0 && avail.has_value()) {
             int32_t core_offset = avail.pop_first();
+            // Peek only: preserve the original claim order and one publication
+            // batch. Gated dispatch never writes the argument-vector cache line.
