+// Only the slab base is needed in a dispatch packet. Expand it on the uncommon
+// deferred-completion API path; keep the public AsyncCtx representation intact.
+struct DispatchAsyncCtx {
+    volatile __gm__ DeferredCompletionSlab *slab;
+    TaskId task_token;
+    volatile uint32_t local_predecessor_pending;
+};
+
+static __aicore__ inline AsyncCtx expand_dispatch_async_ctx(__gm__ const DispatchAsyncCtx *stored) {
+    AsyncCtx ctx{};
+    auto *slab = stored->slab;
+    ctx.task_token.raw = stored->task_token.raw;
+    if (slab != nullptr) {
+        ctx.completion_count = &slab->count;
+        ctx.completion_error_code = &slab->error_code;
+        ctx.completion_entries = &slab->entries[0];
+        ctx.completion_capacity = MAX_COMPLETIONS_PER_TASK;
+    } else {
+        ctx.task_token = TaskId::invalid();
+    }
+    return ctx;
+}
