diff --git a/tests/ut/cpp/common/test_tmr_scheduler_execution_inputs.cpp b/tests/ut/cpp/common/test_tmr_scheduler_execution_inputs.cpp
index cbed60586..93176c453 100644
--- a/tests/ut/cpp/common/test_tmr_scheduler_execution_inputs.cpp
+++ b/tests/ut/cpp/common/test_tmr_scheduler_execution_inputs.cpp
@@ -261,0 +262,62 @@ TEST_F(TmrSchedulerExecutionInputsTest, ScalarPrefixWithoutLocalProducerRetainsI
+
+TEST_F(TmrSchedulerExecutionInputsTest, GatedPendingPrefixCanOverlapAnUnrelatedLocalTask) {
+    for (const int core_offset : {0, 1}) {
+        init_slot();
+        initialize({table_a.data(), table_a.size()});
+        const auto subslot = core_offset == 0 ? SubtaskSlot::AIC : SubtaskSlot::AIV0;
+        const auto mask = core_offset == 0 ? SUBTASK_MASK_AIC : SUBTASK_MASK_AIV0;
+        const auto shape = core_offset == 0 ? ResourceShape::AIC : ResourceShape::AIV;
+        auto &core = context->core_exec_states_[core_offset];
+        core.reg_addr = reinterpret_cast<uint64_t>(registers.data());
+
+        ChipTaskSlotState local{};
+        TaskDescriptor local_task{};
+        TaskPayload local_payload{};
+        local.task = &local_task;
+        local.payload = &local_payload;
+        local.active_mask = ActiveMask(mask);
+        local.logical_block_num = 1;
+        local.total_required_subtasks = 1;
+        local_payload.runtime_barrier_tail = true;
+        local_payload.published_block_count.store(1);
+        const auto previous = context->prepare_subtask_to_core(0, core_offset, local, subslot, false, 0, false);
+        ASSERT_TRUE(previous.valid);
+        context->core_trackers_[0].clear_pending_occupied(core_offset);
+
+        ChipTaskSlotState remote{};
+        TaskDescriptor remote_task{};
+        TaskPayload remote_payload{};
+        remote.task = &remote_task;
+        remote.payload = &remote_payload;
+        remote.active_mask = ActiveMask(core_offset == 0 ? SUBTASK_MASK_AIV0 : SUBTASK_MASK_AIC);
+        remote.logical_block_num = 1;
+        remote_payload.published_block_count.store(1);
+        DepListEntry fanout{&slot, nullptr};
+        remote.fanout_head = &fanout;
+
+        slot.active_mask = ActiveMask(mask);
+        slot.fanin_count = 1;
+        payload.scalar_prefix = true;
+        payload.scalar_prefix_tagged_args = true;
+        payload.fanin_actual_count = 1;
+        payload.fanin_wait_count = 1;
+        payload.fanin_inline_edges[0].set(&remote, DEP_WAIT);
+        payload.early_dispatch_state.store(EARLY_DISPATCH_STAGING);
+        CoreTracker::BitStates idle;
+        auto pending = CoreTracker::BitStates::bit(core_offset);
+        ASSERT_EQ(context->stage_consumer_blocks(0, &slot, shape, 0, 1, idle, pending), 1);
+
+        const auto &dispatch = context->payload_per_core_[core_offset][core.pending_reg_task_id & 1u];
+        EXPECT_EQ(core.running_slot_state, &local);
+        EXPECT_EQ(core.pending_slot_state, &slot);
+        EXPECT_EQ(dispatch.global_context.scalar_prefix, SCALAR_PREFIX_TAGGED_ARGS | SCALAR_PREFIX_CAN_HANDOFF);
+        EXPECT_EQ(dispatch.global_context.predecessor_reg_task_id, previous.reg_task_id);
+        EXPECT_EQ(dispatch.src_payload, reinterpret_cast<uint64_t>(&payload));
+        EXPECT_EQ(dispatch.args[0], 73u);
+        EXPECT_EQ(slot.fanin_count, 1);
+        EXPECT_EQ(payload.fanin_wait_count, 1);
+        EXPECT_FALSE(local.task_attrs.allow_early_resolve());
+        EXPECT_EQ(register_writes, 1);
+        EXPECT_EQ(sched.early_dispatch_doorbell_table[core_offset].token, last_token);
+    }
+}
