+# SPDX-License-Identifier: Apache-2.0
+"""Reuse matching controls and compile local constant-fill notification for CSA."""
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import pypto
+import tmr_csa_full_128k_b16_compile as demo
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--reuse", type=Path, required=True)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=True)
+    sys.path.insert(0, str(Path(pypto.__file__).resolve().parents[2] / "tests/st/runtime/scheduling"))
+    from task_boundary_local_fill_probe import local_fill_notification  # noqa: PLC0415
+
+    reused = {}
+    for name in ("baseline", "mixed"):
+        source = (args.reuse / name).resolve(strict=True)
+        target = args.output / name
+        if not target.exists():
+            target.symlink_to(source, target_is_directory=True)
+        assert target.resolve() == source
+        reused[name] = str(source)
+    (args.output / "reused_artifacts.json").write_text(json.dumps(reused, indent=2) + "\n")
+    demo.PACKAGES["local_fill"] = demo.PACKAGES["mixed"]
+    with local_fill_notification():
+        demo.compile_variant("local_fill", args.output / "local_fill")
+
+
+if __name__ == "__main__":
+    main()
