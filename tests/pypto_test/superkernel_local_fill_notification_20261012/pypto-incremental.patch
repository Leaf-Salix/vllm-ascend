@@ -0,0 +1,70 @@
+# Copyright (c) PyPTO Contributors.
+# Licensed under the CANN Open Software License Agreement Version 2.0.
+"""Fill the notification scratch locally, retaining all original pipe joins."""
+
+from contextlib import contextmanager
+
+import task_boundary_runtime_poll_probe as runtime_probe
+from pypto import ir
+from pypto.backend import pto_backend
+
+
+@contextmanager
+def local_fill_notification():
+    original = pto_backend._compiled_late_poll
+
+    def callback(func):
+        helper, entry = original(func)
+        if not helper:
+            return helper, entry
+        if "create_cbuf_matrix(" in helper or "vector_dup(" in helper:
+            # The default generator already owns this implementation. Retain
+            # the hook so archived scripts can also run against its old base.
+            assert "copy_gm_to_" not in helper
+            return helper, entry
+        previous = "const uint64_t expected = *value == 1 ? ~uint64_t{0} : 1;"
+        assert helper.count(previous) == 1
+        # Uniform halfword patterns work for both L1 fill and Vector duplicate.
+        # Always choose a value different from the preceding notification,
+        # including when a previous task used the original 1/~0 callback.
+        helper = helper.replace(previous, "const uint64_t expected = *value == 0 ? ~uint64_t{0} : 0;")
+        source = (
+            "    auto* source = reinterpret_cast<__gm__ uint16_t*>("
+            "expected == 1 ? notice->positive : notice->negative);\n"
+        )
+        assert helper.count(source) == 1
+        helper = helper.replace(source, "")
+        if func.func_type == ir.FunctionType.AIC:
+            load = "copy_gm_to_cbuf(scratch, source, 0, 1, 2, 0, 0, (pad_t)0);"
+            # PTO-ISA TExpandsMatTile: two repeats of one 32B block, no gap.
+            fill = "create_cbuf_matrix(scratch, int64_t{0x10002}, static_cast<uint16_t>(expected));"
+        else:
+            assert func.func_type == ir.FunctionType.AIV
+            load = "copy_gm_to_ubuf(scratch, source, 0, 1, 2, 0, 0);"
+            # Match PTO-ISA TExpandsVec1D<uint16_t>: exactly 32 halfwords,
+            # followed by restoration of normal mode and the full vector mask.
+            fill = """set_mask_count();
+    set_vector_mask(0, 32);
+    vector_dup(scratch, static_cast<uint16_t>(expected), 0, 1, 1, 8, 8);
+    set_mask_norm();
+    set_vector_mask(~uint64_t{0}, ~uint64_t{0});"""
+        assert helper.count(load) == 1
+        return helper.replace(load, fill), entry
+
+    try:
+        pto_backend._compiled_late_poll = callback
+        yield
+    finally:
+        pto_backend._compiled_late_poll = original
+
+
+@contextmanager
+def instrument(mode, cube):
+    with runtime_probe.instrument(mode, cube), local_fill_notification():
+        yield
+
+
+if __name__ == "__main__":
+    runtime_probe.probe.instrument = instrument
+    runtime_probe.probe.validate = runtime_probe.validate
+    runtime_probe.probe.main()
