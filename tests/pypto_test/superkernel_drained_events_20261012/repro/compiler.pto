// RUN: ptoas --enable-insert-sync --pto-level=level3 %s 2>&1 | FileCheck %s --implicit-check-not="PYPTO_TASK_BOUNDARY_EVENTS_V1 drained_ids" --implicit-check-not="PYPTO_TASK_BOUNDARY_RELAY_V1 drained_ids" --implicit-check-not="PYPTO_TASK_BOUNDARY_BLOCKING_POLL_V1 drained_ids"
// CHECK-DAG: // PYPTO_TASK_BOUNDARY_EVENTS_V1 fenced_then_used MTE2=7 MTE1=7 M=7 FIX=7 V=6
// CHECK-DAG: // PYPTO_TASK_BOUNDARY_BLOCKING_POLL_V1 paired_only
// CHECK-DAG: // PYPTO_TASK_BOUNDARY_BLOCKING_POLL_V1 single_pipe
// CHECK-DAG: // PYPTO_TASK_BOUNDARY_BLOCKING_POLL_V1 generated_tail
// CHECK-DAG: // PYPTO_TASK_BOUNDARY_EVENTS_V1 unmatched MTE2=7 MTE1=7 M=7 FIX=7 V=6
// CHECK-DAG: // PYPTO_TASK_BOUNDARY_EVENTS_V1 nested_pair MTE2=7 MTE1=7 M=7 FIX=7 V=6
// CHECK-DAG: // PYPTO_TASK_BOUNDARY_BLOCKING_POLL_V1 dynamic_pair
// CHECK-LABEL: void drained_ids
// CHECK: set_flag(PIPE_V, PIPE_MTE3, EVENT_ID7)
// CHECK: wait_flag(PIPE_V, PIPE_MTE3, EVENT_ID7)
// CHECK: pipe_barrier(PIPE_ALL)
// CHECK-LABEL: void fenced_then_used
// CHECK: pipe_barrier(PIPE_ALL)
// CHECK: set_flag(PIPE_V, PIPE_MTE3, EVENT_ID7)
// CHECK: wait_flag(PIPE_V, PIPE_MTE3, EVENT_ID7)
module attributes {pto.target_arch = "a2a3"} {
  func.func @drained_ids() attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.barrier <PIPE_ALL>
    return
  }
  func.func @fenced_then_used() attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.barrier <PIPE_ALL>
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    return
  }
  func.func @paired_only() attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    return
  }
  func.func @single_pipe() attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.barrier <PIPE_V>
    return
  }
  func.func @generated_tail() attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.barrier <PIPE_ALL> {pto.auto_sync_tail_barrier}
    return
  }
  func.func @unmatched() attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.barrier <PIPE_ALL>
    return
  }
  func.func @nested_pair(%condition: i1) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    scf.if %condition {
      pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
      pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
      pto.barrier <PIPE_ALL>
    }
    pto.barrier <PIPE_ALL>
    return
  }
  func.func @dynamic_pair(%id: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag_dyn [#pto.pipe<PIPE_V>, #pto.pipe<PIPE_MTE3>, %id]
    pto.wait_flag_dyn [#pto.pipe<PIPE_V>, #pto.pipe<PIPE_MTE3>, %id]
    pto.barrier <PIPE_ALL>
    return
  }
}
