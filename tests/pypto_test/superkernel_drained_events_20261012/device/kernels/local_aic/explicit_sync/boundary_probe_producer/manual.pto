module attributes {pto.backend = "emitc", pto.kernel_kind = #pto.kernel_kind<cube>, pto.target_arch = "a3"} {
  func.func @boundary_probe_producer(%arg0: !pto.ptr<i64, gm>, %arg1: !pto.ptr<f16, gm>, %arg2: !pto.ptr<f16, gm>, %arg3: !pto.ptr<f32, gm>, %arg4: !pto.ptr<i64, gm>, %arg5: i64, %arg6: i32, %arg7: i32) attributes {pto.auto_sync_tail_hint = "runtime_barrier_all", pto.kernel_kind = #pto.kernel_kind<cube>, pto.runtime_late_handoff, pto.scalar_prefix} {
    %c64_i64 = arith.constant 64 : i64
    %c32832_i64 = arith.constant 32832 : i64
    %c0_i64 = arith.constant 0 : i64
    %c8 = arith.constant 8 : index
    %c1 = arith.constant 1 : index
    %c3088 = arith.constant 3088 : index
    %c256 = arith.constant 256 : index
    %c128 = arith.constant 128 : index
    %c0 = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %c32 = arith.constant 32 : index
    %c64 = arith.constant 64 : index
    %0 = pto.make_tensor_view %arg1, shape = [%c3088, %c256], strides = [%c256, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf16>
    %1 = pto.make_tensor_view %arg2, shape = [%c128, %c256], strides = [%c256, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf16>
    %2 = pto.make_tensor_view %arg3, shape = [%c3088, %c256], strides = [%c256, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
    %3 = arith.index_cast %arg6 : i32 to index
    %4 = arith.index_cast %3 : index to i64
    call @pypto_wait_pre_task_end(%arg4, %arg5) : (!pto.ptr<i64, gm>, i64) -> ()
    pto.set_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.set_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.wait_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.set_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.wait_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.set_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.wait_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.set_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.wait_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.set_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.wait_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.set_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.wait_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.set_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_FIX>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.barrier <PIPE_ALL>
    %5 = arith.index_cast %3 : index to i64
    %6 = arith.muli %3, %c8 : index
    pto.store %5, %arg0[%6] {pto.scalar_prefix_store} : !pto.ptr<i64, gm>, i64
    %7 = pto.alloc_tile addr = %c64_i64 valid_row = %c128 valid_col = %c128 : !pto.tile_buf<mat, 128x128xf16, valid=?x?, blayout=col_major, slayout=row_major>
    %8 = arith.muli %3, %c128 : index
    %9 = arith.maxsi %8, %c0 : index
    %10 = pto.partition_view %0, offsets = [%9, %c0], sizes = [%c128, %c128] : !pto.tensor_view<?x?xf16>
    pto.tload ins(%10 : !pto.partition_tensor_view<128x128xf16>) outs(%7 : !pto.tile_buf<mat, 128x128xf16, valid=?x?, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>}
    pto.set_flag[<PIPE_MTE2>, <PIPE_MTE1>, <EVENT_ID0>]
    %11 = pto.alloc_tile addr = %c32832_i64 valid_row = %c128 valid_col = %c256 : !pto.tile_buf<mat, 128x256xf16, valid=?x?, blayout=col_major, slayout=row_major>
    %12 = pto.partition_view %1, offsets = [%c0, %c0], sizes = [%c128, %c256] : !pto.tensor_view<?x?xf16>
    pto.tload ins(%12 : !pto.partition_tensor_view<128x256xf16>) outs(%11 : !pto.tile_buf<mat, 128x256xf16, valid=?x?, blayout=col_major, slayout=row_major>) {layout = #pto.layout<nd>}
    pto.set_flag[<PIPE_MTE2>, <PIPE_MTE1>, <EVENT_ID1>]
    %13 = pto.alloc_tile addr = %c0_i64 valid_row = %c128 valid_col = %c128 : !pto.tile_buf<left, 128x128xf16, valid=?x?, slayout=row_major>
    pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE1>, <EVENT_ID0>]
    pto.tmov ins(%7 : !pto.tile_buf<mat, 128x128xf16, valid=?x?, blayout=col_major, slayout=row_major>) outs(%13 : !pto.tile_buf<left, 128x128xf16, valid=?x?, slayout=row_major>)
    %14 = pto.alloc_tile addr = %c0_i64 valid_row = %c128 valid_col = %c256 : !pto.tile_buf<right, 128x256xf16, valid=?x?, slayout=col_major>
    pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE1>, <EVENT_ID1>]
    pto.tmov ins(%11 : !pto.tile_buf<mat, 128x256xf16, valid=?x?, blayout=col_major, slayout=row_major>) outs(%14 : !pto.tile_buf<right, 128x256xf16, valid=?x?, slayout=col_major>)
    pto.set_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID0>]
    %15 = pto.alloc_tile addr = %c0_i64 valid_row = %c128 valid_col = %c256 : !pto.tile_buf<acc, 128x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>
    pto.wait_flag[<PIPE_MTE1>, <PIPE_M>, <EVENT_ID0>]
    pto.tmatmul ins(%13, %14 : !pto.tile_buf<left, 128x128xf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 128x256xf16, valid=?x?, slayout=col_major>) outs(%15 : !pto.tile_buf<acc, 128x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
    %16 = arith.remsi %3, %c4 : index
    %17 = arith.muli %16, %c32 : index
    %18 = arith.addi %17, %c64 : index
    scf.for %arg8 = %c0 to %18 step %c1 {
      pto.barrier <PIPE_M>
      pto.tmatmul.acc ins(%15, %13, %14 : !pto.tile_buf<acc, 128x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 128x128xf16, valid=?x?, slayout=row_major>, !pto.tile_buf<right, 128x256xf16, valid=?x?, slayout=col_major>) outs(%15 : !pto.tile_buf<acc, 128x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>)
    }
    pto.set_flag[<PIPE_M>, <PIPE_FIX>, <EVENT_ID0>]
    %19 = arith.muli %3, %c128 : index
    %20 = arith.maxsi %19, %c0 : index
    %21 = pto.partition_view %2, offsets = [%20, %c0], sizes = [%c128, %c256] : !pto.tensor_view<?x?xf32>
    pto.wait_flag[<PIPE_M>, <PIPE_FIX>, <EVENT_ID0>]
    pto.tstore ins(%15 : !pto.tile_buf<acc, 128x256xf32, valid=?x?, blayout=col_major, slayout=row_major, fractal=1024>) outs(%21 : !pto.partition_tensor_view<128x256xf32>) {layout = #pto.layout<nd>}
    call @pypto_set_next_task_start(%arg4) : (!pto.ptr<i64, gm>) -> ()
    return
  }
  func.func private @pypto_wait_pre_task_end(!pto.ptr<i64, gm>, i64)
  func.func private @pypto_set_next_task_start(!pto.ptr<i64, gm>)
}
