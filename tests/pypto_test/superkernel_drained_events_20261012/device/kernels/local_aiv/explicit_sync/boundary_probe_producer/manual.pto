module attributes {pto.backend = "emitc", pto.kernel_kind = #pto.kernel_kind<vector>, pto.target_arch = "a3"} {
  func.func @boundary_probe_producer(%arg0: !pto.ptr<i64, gm>, %arg1: !pto.ptr<f16, gm>, %arg2: !pto.ptr<f32, gm>, %arg3: !pto.ptr<i64, gm>, %arg4: i64, %arg5: i32, %arg6: i32) attributes {pto.auto_sync_tail_hint = "runtime_barrier_all", pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff, pto.scalar_prefix} {
    %c64_i64 = arith.constant 64 : i64
    %c32832_i64 = arith.constant 32832 : i64
    %c8 = arith.constant 8 : index
    %c1 = arith.constant 1 : index
    %c3088 = arith.constant 3088 : index
    %c256 = arith.constant 256 : index
    %c0 = arith.constant 0 : index
    %c64 = arith.constant 64 : index
    %c4 = arith.constant 4 : index
    %c512 = arith.constant 512 : index
    %c1024 = arith.constant 1024 : index
    %cst = arith.constant 1.000000e+00 : f32
    %0 = pto.make_tensor_view %arg1, shape = [%c3088, %c256], strides = [%c256, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf16>
    %1 = pto.make_tensor_view %arg2, shape = [%c3088, %c256], strides = [%c256, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
    %2 = arith.index_cast %arg5 : i32 to index
    %3 = arith.index_cast %2 : index to i64
    call @pypto_wait_pre_task_end(%arg3, %arg4) : (!pto.ptr<i64, gm>, i64) -> ()
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID1>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID2>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID3>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID4>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID5>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID6>]
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.barrier <PIPE_ALL>
    %4 = arith.index_cast %2 : index to i64
    %5 = arith.muli %2, %c8 : index
    pto.store %4, %arg0[%5] {pto.scalar_prefix_store} : !pto.ptr<i64, gm>, i64
    %6 = pto.alloc_tile addr = %c64_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<vec, 64x256xf16, valid=?x?>
    %7 = arith.muli %2, %c64 : index
    %8 = arith.maxsi %7, %c0 : index
    %9 = pto.partition_view %0, offsets = [%8, %c0], sizes = [%c64, %c256] : !pto.tensor_view<?x?xf16>
    pto.tload ins(%9 : !pto.partition_tensor_view<64x256xf16>) outs(%6 : !pto.tile_buf<vec, 64x256xf16, valid=?x?>) {layout = #pto.layout<nd>}
    pto.set_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    %10 = pto.alloc_tile addr = %c32832_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<vec, 64x256xf32, valid=?x?>
    pto.wait_flag[<PIPE_MTE2>, <PIPE_V>, <EVENT_ID0>]
    pto.tcvt ins(%6 {rmode = #pto<round_mode ROUND>, satmode = #pto<saturation_mode ON>} : !pto.tile_buf<vec, 64x256xf16, valid=?x?>) outs(%10 : !pto.tile_buf<vec, 64x256xf32, valid=?x?>)
    %11 = arith.remsi %2, %c4 : index
    %12 = arith.muli %11, %c512 : index
    %13 = arith.addi %12, %c1024 : index
    scf.for %arg7 = %c0 to %13 step %c1 {
      %17 = pto.alloc_tile addr = %c32832_i64 valid_row = %c64 valid_col = %c256 : !pto.tile_buf<vec, 64x256xf32, valid=?x?>
      pto.barrier <PIPE_V>
      pto.tadds ins(%10, %cst : !pto.tile_buf<vec, 64x256xf32, valid=?x?>, f32) outs(%17 : !pto.tile_buf<vec, 64x256xf32, valid=?x?>)
    }
    pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    %14 = arith.muli %2, %c64 : index
    %15 = arith.maxsi %14, %c0 : index
    %16 = pto.partition_view %1, offsets = [%15, %c0], sizes = [%c64, %c256] : !pto.tensor_view<?x?xf32>
    pto.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    pto.tstore ins(%10 : !pto.tile_buf<vec, 64x256xf32, valid=?x?>) outs(%16 : !pto.partition_tensor_view<64x256xf32>) {layout = #pto.layout<nd>}
    call @pypto_set_next_task_start(%arg3) : (!pto.ptr<i64, gm>) -> ()
    return
  }
  func.func private @pypto_wait_pre_task_end(!pto.ptr<i64, gm>, i64)
  func.func private @pypto_set_next_task_start(!pto.ptr<i64, gm>)
