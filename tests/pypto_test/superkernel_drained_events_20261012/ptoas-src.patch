+                        : nullptr) {}
+
+  LogicalResult record(PIPE src, PIPE dst, std::optional<uint8_t> ids,
+                       Operation *op, bool isSet, bool isStatic) {
     int pair = taskBoundaryEventPairIndex(src, dst);
     if (pair < 0) return success();
     // An unknown ID may use any slot. Preserve the author's flags, and let
     // allocation fall back to an event-free full drain only on a probe miss.
-    used[pair] |= ids.value_or(0xffu);
+    uint8_t mask = ids.value_or(0xffu);
+    used[pair] |= mask;
+    if (!isStatic || op->getBlock() != linearBlock) {
+      opaque[pair] |= mask;
+    } else if (isSet) {
+      opaque[pair] |= pending[pair] & mask;
+      pending[pair] |= mask;
+    } else {
+      opaque[pair] |= ~pending[pair] & mask;
+      pending[pair] &= ~mask;
+    }
     return success();
   }
 
   template <typename Op> LogicalResult low(Op op) {
     return record(op.getSrcPipe().getPipe(), op.getDstPipe().getPipe(),
-                  uint8_t(1u << static_cast<unsigned>(op.getEventId().getEvent())));
+                  uint8_t(1u << static_cast<unsigned>(op.getEventId().getEvent())),
+                  op, isa<SetFlagOp>(op), true);
   }
   template <typename Op> LogicalResult dynamic(Op op) {
     return record(op.getSrcPipe().getPipe(), op.getDstPipe().getPipe(),
-                  possibleEventIds(op.getEventId()));
+                  possibleEventIds(op.getEventId()), op,
+                  isa<SetFlagDynOp>(op), false);
   }
   template <typename Op> LogicalResult high(Op op) {
     auto src = parseSyncOpTypeLikeAttr(op.getSrcOpAttr());
@@ -162,7 +180,19 @@ public:
     if (failed(src) || failed(dst))
       return op.emitError("cannot resolve explicit task-boundary event pipe pair");
     return record(mapSyncOpTypeToPipe(*src), mapSyncOpTypeToPipe(*dst),
-                  uint8_t(1u << static_cast<unsigned>(op.getEventId().getEvent())));
+                  uint8_t(1u << static_cast<unsigned>(op.getEventId().getEvent())),
+                  op, isa<RecordEventOp>(op), true);
+  }
+
+  void observeBarrier(BarrierOp op) {
+    if (op->getBlock() != linearBlock || op.getPipe().getPipe() != PIPE::PIPE_ALL ||
+        op->hasAttr("pto.auto_sync_tail_barrier"))
+      return;
+    // A queued Wait alone does not prove that the event was consumed. Only an
+    // existing, retained all-pipe drain retires every matched static pair.
+    // Dynamic, nested and hidden uses keep their conservative reservation.
+    for (unsigned pair = 0; pair < used.size(); ++pair)
+      used[pair] &= pending[pair] | opaque[pair];
   }
 
   void recordHidden(Operation *op) {
@@ -170,9 +200,11 @@ public:
       for (const auto &event : model->hiddenEvents) {
         int pair = taskBoundaryEventPairIndex(event.srcPipe, event.dstPipe);
         if (pair < 0) continue;
-        auto &mask = used[pair];
+        uint8_t mask = 0;
         for (unsigned id : event.eventIds)
           mask |= id < 8 ? (1u << id) : 0xffu;
+        used[pair] |= mask;
+        opaque[pair] |= mask;
       }
     }
   }
@@ -224,12 +256,13 @@ private:
     return true;
   }
 
-  std::array<uint8_t, 9> used{};
+  Block *linearBlock;
+  std::array<uint8_t, 9> used{}, pending{}, opaque{};
 };
 
 static LogicalResult allocateExplicitTaskBoundaryEvents(func::FuncOp func) {
-  ExplicitTaskBoundaryEvents events;
-  WalkResult result = func.walk([&](Operation *op) {
+  ExplicitTaskBoundaryEvents events(func);
+  WalkResult result = func.walk<WalkOrder::PreOrder>([&](Operation *op) {
     LogicalResult status = success();
     if (auto set = dyn_cast<SetFlagOp>(op)) status = events.low(set);
     else if (auto wait = dyn_cast<WaitFlagOp>(op)) status = events.low(wait);
@@ -237,6 +270,7 @@ static LogicalResult allocateExplicitTaskBoundaryEvents(func::FuncOp func) {
     else if (auto wait = dyn_cast<WaitFlagDynOp>(op)) status = events.dynamic(wait);
     else if (auto record = dyn_cast<RecordEventOp>(op)) status = events.high(record);
     else if (auto wait = dyn_cast<WaitEventOp>(op)) status = events.high(wait);
+    else if (auto barrier = dyn_cast<BarrierOp>(op)) events.observeBarrier(barrier);
     events.recordHidden(op);
     return failed(status) ? WalkResult::interrupt() : WalkResult::advance();
   });
