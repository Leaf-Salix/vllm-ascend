--- a/python/pypto/backend/pto_backend.py
+++ b/python/pypto/backend/pto_backend.py
@@ -1097,3 +1097 @@ def _compiled_late_poll(func: _ir_core.Function) -> tuple[str, str]:
-        f"    {op}_flag(PIPE_{engine}, PIPE_MTE3, EVENT_ID7);"
-        for op in ("set", "wait")
-        for engine in engines
+        f"    {op}_flag(PIPE_{engine}, PIPE_MTE3, EVENT_ID7);" for op in ("set", "wait") for engine in engines
@@ -1137,0 +1136,36 @@ static __aicore__ __attribute__((noinline)) void pypto_poll_local_tail(__gm__ in
+def _apply_task_boundary_events(func_name: str, helper: str, ptoas_code: str) -> tuple[str, str]:
+    """Use PTOAS-selected notification events without changing the task's flags.
+
+    Unchanged automatic allocation emits no metadata and keeps the original
+    wrapper byte-for-byte. The compile guard rejects an older wrapper when
+    explicit synchronization requires an event other than the default seven.
+    """
+    marker = "// PYPTO_TASK_BOUNDARY_EVENTS_V1 "
+    if marker not in ptoas_code:
+        return helper, ""
+    pattern = re.compile(
+        r"// PYPTO_TASK_BOUNDARY_EVENTS_V1 ([A-Za-z_][A-Za-z0-9_]*) "
+        r"MTE2=([0-7]) MTE1=([0-7]) M=([0-7]) FIX=([0-7]) V=([0-7])"
+    )
+    allocations = {}
+    for line in ptoas_code.splitlines():
+        if not line.startswith(marker):
+            continue
+        match = pattern.fullmatch(line)
+        if not match or match[1] in allocations:
+            raise ValueError("invalid or duplicate PTOAS task-boundary event allocation")
+        allocations[match[1]] = match.groups()[1:]
+    if not allocations:
+        return helper, ""
+    if func_name in allocations:
+        if not helper:
+            raise ValueError("PTOAS allocated notification events for a task without a tail callback")
+        for pipe, event in zip(("MTE2", "MTE1", "M", "FIX", "V"), allocations[func_name]):
+            old = f"_flag(PIPE_{pipe}, PIPE_MTE3, EVENT_ID7);"
+            count = helper.count(old)
+            if count not in (0, 2):
+                raise ValueError(f"incomplete notification Set/Wait pair for {pipe}")
+            helper = helper.replace(old, f"_flag(PIPE_{pipe}, PIPE_MTE3, EVENT_ID{event});")
+    return helper, "#define PYPTO_TASK_BOUNDARY_EVENTS_V1 1\n"
+
+
@@ -1294,0 +1329,3 @@ def _generate_kernel_wrapper(
+    late_poll_helper, late_event_contract = _apply_task_boundary_events(
+        func.name, late_poll_helper, ptoas_code
+    )
@@ -1326 +1363 @@ def _generate_kernel_wrapper(
-        f"{late_poll_helper}{fifo_lane_arg_bridge}"
+        f"{late_event_contract}{late_poll_helper}{fifo_lane_arg_bridge}"
diff --git a/tests/st/runtime/scheduling/task_boundary_allocated_event_probe.py b/tests/st/runtime/scheduling/task_boundary_allocated_event_probe.py
