// RUN: not ptoas --enable-insert-sync --pto-level=level3 %s 2>&1 | FileCheck %s
// CHECK: late task handoff has no provably free notification event on MTE2->MTE3
module attributes {pto.target_arch = "a2a3"} {
  func.func @all_ids(%input: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    %eight = arith.constant 8 : index
    %id = arith.remui %input, %eight : index
    pto.set_flag_dyn [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_MTE3>, %id]
    pto.wait_flag_dyn [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_MTE3>, %id]
    return
  }
}
