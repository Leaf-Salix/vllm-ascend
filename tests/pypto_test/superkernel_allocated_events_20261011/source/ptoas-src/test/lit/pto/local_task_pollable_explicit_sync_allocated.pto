// RUN: ptoas --enable-insert-sync --pto-level=level3 %s 2>&1 | FileCheck %s
// CHECK: // PYPTO_TASK_BOUNDARY_EVENTS_V1 manual_tail MTE2=6 MTE1=7 M=7 FIX=7 V=7
// CHECK: #error allocated task boundary events require a matching PyPTO wrapper
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID7);
// CHECK: wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID7);

module attributes {pto.target_arch = "a2a3"} {
  func.func @manual_tail() attributes {
      pto.kernel_kind = #pto.kernel_kind<vector>, pto.runtime_late_handoff} {
    pto.set_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID7>]
    pto.wait_flag[<PIPE_MTE2>, <PIPE_MTE3>, <EVENT_ID7>]
    return
  }
}
