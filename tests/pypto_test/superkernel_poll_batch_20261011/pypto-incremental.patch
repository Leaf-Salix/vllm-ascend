+# Copyright (c) PyPTO Contributors.
+# Licensed under the CANN Open Software License Agreement Version 2.0.
+"""Check dispatch registers several times between completion-line reads."""
+
+import argparse
+import sys
+from contextlib import contextmanager
+
+import task_boundary_runtime_poll_probe as runtime_probe
+from pypto.backend import pto_backend
+
+
+@contextmanager
+def batched_poll(batch=4):
+    assert batch in (2, 4)
+    original = pto_backend._compiled_late_poll
+
+    def generate(func):
+        helper, entry = original(func)
+        if not helper:
+            return helper, entry
+        check = """        asm volatile("MOV %0, DATA_MAIN_BASE" : "=l"(next) : : "memory");
+        if (next != own && next != 0x7ffffffdu) {
+            return;
+        }
+"""
+        assert helper.count(check) == 1
+        # Keep the first observation and every original exit condition. Only
+        # delay the next completion-line read by a bounded number of Scalar
+        # register checks. Actual handoff validation remains in the runtime.
+        return helper.replace(check, check * batch), entry
+
+    try:
+        pto_backend._compiled_late_poll = generate
+        yield
+    finally:
+        pto_backend._compiled_late_poll = original
+
+
+def make_instrument(batch):
+    @contextmanager
+    def instrument(mode, cube):
+        with batched_poll(batch), runtime_probe.instrument(mode, cube):
+            yield
+
+    return instrument
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(add_help=False)
+    parser.add_argument("--batch", type=int, choices=(2, 4), default=4)
+    options, remaining = parser.parse_known_args()
+    sys.argv = [sys.argv[0], *remaining]
+    runtime_probe.probe.instrument = make_instrument(options.batch)
+    runtime_probe.probe.validate = runtime_probe.validate
+    runtime_probe.probe.main()
