diff --git a/docs/a3-tmr-local-task-boundaries.md b/docs/a3-tmr-local-task-boundaries.md
index 191a52d63..227282406 100644
--- a/docs/a3-tmr-local-task-boundaries.md
+++ b/docs/a3-tmr-local-task-boundaries.md
@@ -39,0 +40,15 @@ compilation or a capability marker alone proves neither overlap nor a gain.
+
+The compiler may set the submission capability `prearmed_async_tail` when its
+local Set is verified to occur unconditionally at the function tail. Dispatch
+then initializes kind 3 or 4 with `ASYNC_TAIL_PREARMED` in its high bit. Set
+does not write the GM control line. A cancelled predecessor wait must clear
+the kind before taking its compiler-generated early return, because that
+path issues no completion events.
+
+The executor masks the high bit before waiting and leaves a prearmed kind
+unchanged after draining. The next dispatch initializes the reused slot.
+Selected prefixes and trace instrumentation may still dirty the control line
+and therefore retain its writeback before FIN; ordinary untraced prearmed
+tasks skip both the clear and writeback. Unmarked legacy kinds keep the
+original clear/writeback protocol. This is an internal ABI capability, not
+an additional operator-author annotation.
diff --git a/src/a2a3/runtime/tensormap_and_ringbuffer/aicore/aicore_executor.cpp b/src/a2a3/runtime/tensormap_and_ringbuffer/aicore/aicore_executor.cpp
index bb340705c..053cc8a9b 100644
--- a/src/a2a3/runtime/tensormap_and_ringbuffer/aicore/aicore_executor.cpp
+++ b/src/a2a3/runtime/tensormap_and_ringbuffer/aicore/aicore_executor.cpp
@@ -42 +42,3 @@ __aicore__ __attribute__((always_inline)) static void drain_async_tail(__gm__ Gl
-    const auto kind = static_cast<AsyncTailKind>(ctx->async_tail_kind);
+    const uint32_t tail = ctx->async_tail_kind;
+    const bool prearmed = (tail & ASYNC_TAIL_PREARMED) != 0;
+    const auto kind = static_cast<AsyncTailKind>(tail & ~ASYNC_TAIL_PREARMED);
@@ -76,2 +78,9 @@ __aicore__ __attribute__((always_inline)) static void drain_async_tail(__gm__ Gl
-    ctx->async_tail_kind = 0;
-    flush_overlap_context(ctx);
+    if (!prearmed) {
+        ctx->async_tail_kind = 0;
+        flush_overlap_context(ctx);
+    } else if (ctx->scalar_prefix != 0 || trace_addr != 0) {
+        // A selected prefix may have acquired/cleared callback fields. Trace
+        // instrumentation also writes this line. Ordinary prearmed tasks never
+        // dirty it, so do not manufacture a store and writeback before FIN.
+        flush_overlap_context(ctx);
+    }
diff --git a/src/a2a3/runtime/tensormap_and_ringbuffer/common/intrinsic.h b/src/a2a3/runtime/tensormap_and_ringbuffer/common/intrinsic.h
index 413786901..a43e4205b 100644
--- a/src/a2a3/runtime/tensormap_and_ringbuffer/common/intrinsic.h
+++ b/src/a2a3/runtime/tensormap_and_ringbuffer/common/intrinsic.h
@@ -126,0 +127,4 @@ enum class AsyncTailKind : uint32_t {
+// The scheduler supplies the kind for a compiler-verified unconditional tail.
+// A cancelled prefix clears it; a normally completed task leaves it read-only.
+static constexpr uint32_t ASYNC_TAIL_PREARMED = 1u << 31;
+
