diff --git a/tests/ut/cpp/common/test_tmr_scheduler_execution_inputs.cpp b/tests/ut/cpp/common/test_tmr_scheduler_execution_inputs.cpp
index 4f6d23405..8fa753e8e 100644
--- a/tests/ut/cpp/common/test_tmr_scheduler_execution_inputs.cpp
+++ b/tests/ut/cpp/common/test_tmr_scheduler_execution_inputs.cpp
@@ -189,0 +190,19 @@ TEST_F(TmrSchedulerExecutionInputsTest, ExplicitTableBuildsEarlyPayloadAcrossABA
+TEST_F(TmrSchedulerExecutionInputsTest, PrearmedTailIsScopedToEachDispatch) {
+    initialize({table_a.data(), table_a.size()});
+    for (bool prearmed : {true, false, true}) {
+        payload.prearmed_async_tail = prearmed;
+        const auto handle = context->prepare_subtask_to_core(0, 0, slot, SubtaskSlot::AIC, false, 0, false);
+        ASSERT_TRUE(handle.valid);
+        const auto &core = context->core_exec_states_[0];
+        const auto &dispatch = context->payload_per_core_[0][core.running_reg_task_id & 1u];
+        EXPECT_EQ(dispatch.global_context.async_tail_kind,
+                  prearmed ? ASYNC_TAIL_PREARMED | static_cast<uint32_t>(AsyncTailKind::AicAllPipes) : 0u);
+        EXPECT_EQ(dispatch.global_context.scalar_prefix, 0u);
+        EXPECT_EQ(dispatch.global_context.wait_predecessor_fn, 0u);
+    }
+    Arg<1, 1> args;
+    args.set_prearmed_async_tail();
+    args.clear();
+    EXPECT_FALSE(args.prearmed_async_tail());
+}
