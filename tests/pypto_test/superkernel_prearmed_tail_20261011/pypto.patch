diff --git a/python/pypto/backend/pto_backend.py b/python/pypto/backend/pto_backend.py
index 26d6759eb..c1a142394 100644
--- a/python/pypto/backend/pto_backend.py
+++ b/python/pypto/backend/pto_backend.py
@@ -705,0 +706,4 @@ int64_t pypto_wait_predecessor(__gm__ int64_t* args, int64_t dependency) {
+    } else {
+        // The compiler's cancellation return precedes the tail markers. A
+        // prearmed task must not make the executor wait on unissued events.
+        ctx->async_tail_kind = 0;
@@ -722,6 +726,3 @@ void pypto_set_next_task_start(__gm__ int64_t* args) {
-    auto* ctx = reinterpret_cast<__gm__ GlobalContext*>(args[SPMD_GLOBAL_CONTEXT_INDEX]);
-#if defined(__DAV_CUBE__)
-    ctx->async_tail_kind = static_cast<uint32_t>(AsyncTailKind::AicAllPipes);
-#else
-    ctx->async_tail_kind = static_cast<uint32_t>(AsyncTailKind::AivAllPipes);
-#endif
+    // The compiler also supplies the prearmed capability on submission. Keep
+    // the local scheduling boundary without dirtying the GM control line.
+    asm volatile("" : : : "memory");
