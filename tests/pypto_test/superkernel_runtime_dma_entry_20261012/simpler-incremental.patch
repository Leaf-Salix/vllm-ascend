diff --git a/src/a2a3/runtime/tensormap_and_ringbuffer/aicore/aicore_executor.cpp b/src/a2a3/runtime/tensormap_and_ringbuffer/aicore/aicore_executor.cpp
index 04fcd3214..9ff388913 100644
--- a/src/a2a3/runtime/tensormap_and_ringbuffer/aicore/aicore_executor.cpp
+++ b/src/a2a3/runtime/tensormap_and_ringbuffer/aicore/aicore_executor.cpp
@@ -174,0 +175,80 @@ __aicore__ __attribute__((noinline)) static uint32_t poll_late_handoff(
+#if defined(__DAV_CUBE__) || defined(__DAV_VEC__)
+// aicore_execute{,_kernel} are weak and shared by the two compiled targets.
+// Target-specific instructions must therefore live in uniquely named strong
+// functions, selected using the actual worker type, not this TU's arch macro.
+extern "C" __aicore__ void tmr_poll_local_tail_aic(__gm__ GlobalContext *ctx);
+extern "C" __aicore__ void tmr_poll_local_tail_aiv(__gm__ GlobalContext *ctx);
+
+#if defined(__DAV_CUBE__)
+extern "C" __aicore__ __attribute__((noinline)) void tmr_poll_local_tail_aic(__gm__ GlobalContext *ctx) {
+#else
+extern "C" __aicore__ __attribute__((noinline)) void tmr_poll_local_tail_aiv(__gm__ GlobalContext *ctx) {
+#endif
+    auto *notice = reinterpret_cast<__gm__ TaskBoundaryNotification *>(ctx->task_boundary_notification);
+    auto *value = reinterpret_cast<volatile __gm__ uint64_t *>(notice->value);
+    dcci(notice->value, SINGLE_CACHE_LINE);
+    const uint64_t expected = *value == 1 ? ~uint64_t{0} : 1;
+    auto *source = reinterpret_cast<__gm__ uint16_t *>(expected == 1 ? notice->positive : notice->negative);
+    const uint32_t scratch_base = static_cast<uint32_t>(ctx->late_handoff_scratch);
+    const bool trace = ctx->scalar_overlap_trace != 0;
+    if (trace) {
+#if defined(__DAV_CUBE__)
+        ctx->late_handoff_scratch |= uint64_t{16} << 32;
+#else
+        ctx->late_handoff_scratch |= uint64_t{32} << 32;
+#endif
+        flush_overlap_context(ctx);
+    }
+#if defined(__DAV_CUBE__)
+    auto *scratch = reinterpret_cast<__cbuf__ uint16_t *>(scratch_base);
+    copy_gm_to_cbuf(scratch, source, 0, 1, 2, 0, 0, (pad_t)0);
+    set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID7);
+    set_flag(PIPE_MTE1, PIPE_MTE3, EVENT_ID7);
+    set_flag(PIPE_M, PIPE_MTE3, EVENT_ID7);
+    set_flag(PIPE_FIX, PIPE_MTE3, EVENT_ID7);
+    wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID7);
+    wait_flag(PIPE_MTE1, PIPE_MTE3, EVENT_ID7);
+    wait_flag(PIPE_M, PIPE_MTE3, EVENT_ID7);
+    wait_flag(PIPE_FIX, PIPE_MTE3, EVENT_ID7);
+    pipe_barrier(PIPE_MTE3);
+    copy_cbuf_to_gm(reinterpret_cast<__gm__ uint16_t *>(notice->value), scratch, 0, 1, 2, 0, 0);
+#else
+    auto *scratch = reinterpret_cast<__ubuf__ uint16_t *>(scratch_base);
+    copy_gm_to_ubuf(scratch, source, 0, 1, 2, 0, 0);
+    set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID7);
+    set_flag(PIPE_V, PIPE_MTE3, EVENT_ID7);
+    wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID7);
+    wait_flag(PIPE_V, PIPE_MTE3, EVENT_ID7);
+    pipe_barrier(PIPE_MTE3);
+    copy_ubuf_to_gm(reinterpret_cast<__gm__ uint16_t *>(notice->value), scratch, 0, 1, 2, 0, 0);
+#endif
+    if (trace) ctx->late_handoff_scratch |= uint64_t{1} << 32;
+    const uint32_t own = ctx->reg_task_id;
+    for (;;) {
+        const uint32_t next = static_cast<uint32_t>(read_reg(RegId::DATA_MAIN_BASE));
+        if (next != own && next != AICPU_IDLE_TASK_ID) return;
+        dcci(notice->value, SINGLE_CACHE_LINE);
+        if (*value == expected) return;
+    }
+}
+
+__aicore__ __attribute__((noinline)) static uint32_t poll_late_handoff_direct(
+    __gm__ DispatchPayload *base, __gm__ DispatchPayload *current, uint32_t task_id, CoreType worker_type
+) {
+    const uint32_t dispatched = static_cast<uint32_t>(read_reg(RegId::DATA_MAIN_BASE));
+    if (dispatched != task_id && dispatched != AICPU_IDLE_TASK_ID) {
+        return handoff_scalar_prefix(base, current, task_id);
+    }
+    if (worker_type == CoreType::AIC) {
+        tmr_poll_local_tail_aic(&current->global_context);
+    } else {
+        tmr_poll_local_tail_aiv(&current->global_context);
+    }
+    const uint32_t candidate = handoff_scalar_prefix(base, current, task_id);
+    if (candidate != AICPU_IDLE_TASK_ID && current->global_context.scalar_overlap_trace != 0) {
+        current->global_context.late_handoff_scratch |= uint64_t{2} << 32;
+    }
+    return candidate;
+}
+#endif
+
@@ -382,0 +463,5 @@ __aicore__ static void execute_dispatch_loop(__gm__ Handshake *my_hank) {
+#if defined(__DAV_CUBE__) || defined(__DAV_VEC__)
+                    if (next_id == AICPU_IDLE_TASK_ID && tail_kind == AsyncTailKind::RuntimePollable) {
+                        next_id = poll_late_handoff_direct(payload, exec_payload, task_id, my_hank->core_type);
+                    }
+#endif
