    def test_nested_branch_wait_keeps_selected_condition_and_scalar_values(self):
        """Nested manual boundaries carry only the chosen prefix across one Wait."""
    
        @pl.program
        class Before:
            @pl.function(type=pl.FunctionType.InCore)
            def kernel(
                self,
                out: pl.Out[pl.Tensor[[64], pl.FP32]],
                seed: pl.Scalar[pl.FP32],
                choose: pl.Scalar[pl.BOOL],
            ):
                if choose:
                    inner = seed > 0.0
                    if inner:
                        left = seed * 3.0
                        pl.system.wait_pre_task_end()
                        pl.tensor.write(out, [0], left)
                    else:
                        right = seed * 5.0
                        pl.system.wait_pre_task_end()
                        pl.tensor.write(out, [0], right)
                else:
                    other = seed * 7.0
                    pl.system.wait_pre_task_end()
                    pl.tensor.write(out, [0], other)
                pl.system.set_next_task_start()
                return  # noqa: PLR1711 (DSL return terminator)
    
        @pl.program
