+                seed: pl.Scalar[pl.FP32],
+                choose: pl.Scalar[pl.BOOL],
+            ):
+                if choose:
+                    inner = seed > 0.0
+                    if inner:
+                        left = seed * 3.0
+                        pl.system.wait_pre_task_end()
+                        pl.tensor.write(out, [0], left)
+                    else:
+                        right = seed * 5.0
+                        pl.system.wait_pre_task_end()
+                        pl.tensor.write(out, [0], right)
+                else:
+                    other = seed * 7.0
+                    pl.system.wait_pre_task_end()
