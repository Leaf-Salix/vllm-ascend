+
+        @pl.program
+        class Expected:
+            @pl.function(type=pl.FunctionType.InCore)
+            def kernel(
+                self,
+                out: pl.Out[pl.Tensor[[64], pl.FP32]],
+                seed: pl.Scalar[pl.FP32],
+                choose: pl.Scalar[pl.BOOL],
+            ):
+                if choose:
+                    inner = seed > 0.0
+                    if inner:
+                        left = seed * 3.0
+                        nested_value = pl.yield_(left)
+                    else:
+                        right = seed * 5.0
+                        nested_value = pl.yield_(right)
+                    chosen_inner, chosen_value = pl.yield_(inner, nested_value)
+                else:
+                    other = seed * 7.0
+                    chosen_inner, chosen_value = pl.yield_(False, other)
+                pl.system.wait_pre_task_end()
+                if choose:
+                    if chosen_inner:
+                        pl.tensor.write(out, [0], chosen_value)
+                    else:
+                        pl.tensor.write(out, [0], chosen_value)
+                else:
+                    pl.tensor.write(out, [0], chosen_value)
