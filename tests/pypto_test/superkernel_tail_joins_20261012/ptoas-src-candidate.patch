+module attributes {pto.target_arch = "a2a3"} {
+  func.func @loop_join(%src: !pto.ptr<f16>, %dst: !pto.ptr<f32>, %count: index, %condition: i1)
+      attributes {pto.kernel_kind = #pto.kernel_kind<cube>, pto.runtime_late_handoff, pto.auto_sync_tail_hint = "runtime_barrier_all"} {
+    %zero = arith.constant 0 : index
+    %one = arith.constant 1 : index
+    %n = arith.constant 16 : index
+    %addr = arith.constant 512 : i64
