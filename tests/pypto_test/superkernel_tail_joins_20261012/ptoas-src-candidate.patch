+    %dv = pto.make_tensor_view %dst, shape = [%n, %n], strides = [%n, %one] : !pto.tensor_view<16x16xf32>
+    %s = pto.partition_view %sv, offsets = [%zero, %zero], sizes = [%n, %n] : !pto.tensor_view<16x16xf16> -> !pto.partition_tensor_view<16x16xf16>
+    %d = pto.partition_view %dv, offsets = [%zero, %zero], sizes = [%n, %n] : !pto.tensor_view<16x16xf32> -> !pto.partition_tensor_view<16x16xf32>
+    %l1 = pto.alloc_tile addr = %addr : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
+    %a = pto.alloc_tile addr = %addr : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
