+// CHECK: // PYPTO_TASK_BOUNDARY_JOINS_V1 loop_join mask=7
+// CHECK-NOT: // PYPTO_TASK_BOUNDARY_JOINS_V1 later_fix_work
+// CHECK: #error reduced tail joins require a matching PyPTO wrapper
