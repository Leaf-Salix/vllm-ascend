+# SPDX-License-Identifier: Apache-2.0
+"""Compare original and Scalar-filled notifications under matching event rules."""
+
+import argparse
+import json
+from contextlib import contextmanager
+from pathlib import Path
+
+import tmr_csa_full_128k_b16_compile as compile_demo
+from pypto import ir
+from pypto.backend import pto_backend
+from tmr_csa_late_poll_compile import old_tail
+
+
+@contextmanager
+def scalar_token(words=8):
+    original = pto_backend._compiled_late_poll
+
+    def generate(func):
+        helper, entry = original(func)
+        if not helper or func.func_type == ir.FunctionType.AIC:
+            return helper, entry
+        old = "    copy_gm_to_ubuf(scratch, source, 0, 1, 2, 0, 0);"
+        assert helper.count(old) == 1
+        stores = """#pragma unroll
+    for (int i = 0; i < 8; ++i) scalar_scratch[i] = expected;"""
+        if words == 1:
+            # Only the first word is observed. Other reserved scratch bytes
+            # are transferred as padding and never used by the protocol.
+            stores = "    scalar_scratch[0] = expected;"
+        new = f"""    auto* scalar_scratch = reinterpret_cast<volatile __ubuf__ uint64_t*>(scratch);
+{stores}
+    set_flag(PIPE_S, PIPE_MTE3, EVENT_ID7);
+    wait_flag(PIPE_S, PIPE_MTE3, EVENT_ID7);"""
+        return helper.replace(old, new), entry
+
+    try:
+        pto_backend._compiled_late_poll = generate
+        yield
+    finally:
+        pto_backend._compiled_late_poll = original
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--reuse", type=Path)
+    parser.add_argument("--words", type=int, choices=(1, 8), default=8)
+    args = parser.parse_args()
+    if args.reuse:
+        assert args.words == 1, "reuse is the follow-up to the eight-word experiment"
+        args.output.mkdir(parents=True, exist_ok=True)
+        reused = {}
+        for name in ("baseline", "once", "mixed", "scalar"):
+            target = (args.reuse / name).resolve(strict=True)
+            destination = args.output / name
+            if not destination.exists():
+                destination.symlink_to(target, target_is_directory=True)
+            assert destination.resolve() == target
+            reused[name] = str(target)
+        (args.output / "reused_artifacts.json").write_text(json.dumps(reused, indent=2) + "\n")
+    else:
+        compile_demo.compile_variant("baseline", args.output / "baseline")
+        compile_demo.PACKAGES["once"] = compile_demo.PACKAGES["mixed"]
+        with old_tail("once"):
+            compile_demo.compile_variant("once", args.output / "once")
+        compile_demo.compile_variant("mixed", args.output / "mixed")
+    variant = "word" if args.words == 1 else "scalar"
+    compile_demo.PACKAGES[variant] = compile_demo.PACKAGES["mixed"]
+    with scalar_token(args.words):
+        compile_demo.compile_variant(variant, args.output / variant)
+
+
+if __name__ == "__main__":
+    main()
