+TEST_F(TmrSchedulerExecutionInputsTest, FalsePredicateRetiresWithoutPublishingScalarPrefix) {
+    initialize({table_a.data(), table_a.size()});
+    for (const bool sync_start : {false, true}) {
+        init_slot();
+        slot.active_mask = ActiveMask(SUBTASK_MASK_ALL);
+        slot.task_attrs.set_predicate();
+        if (sync_start) slot.task_attrs.set_sync_start();
+        int32_t gate = 0;
+        payload.predicate = {reinterpret_cast<uint64_t>(&gate), 0, sizeof(gate), PredicateOp::GT};
+        payload.scalar_prefix = SUBTASK_MASK_ALL;
+        sched.try_enqueue_early_dispatch_candidate(slot);
+        EXPECT_EQ(payload.early_dispatch_state.load(), EARLY_DISPATCH_NONE);
+        ASSERT_TRUE(sched.route_ready_once(slot));
+        ChipTaskSlotState *ready = nullptr;
+        ASSERT_EQ(sched.dummy_ready_queue.pop_batch(&ready, 1), 1);
+        EXPECT_EQ(ready, &slot);
+        EXPECT_EQ(sched.ready_queues[static_cast<int>(ResourceShape::MIX)].pop_batch(&ready, 1), 0);
+        EXPECT_EQ(sched.ready_sync_queues[static_cast<int>(ResourceShape::MIX)].pop_batch(&ready, 1), 0);
+        EXPECT_EQ(register_writes, 0);
+        EXPECT_EQ(context->core_exec_states_[0].running_slot_state, nullptr);
+        EXPECT_EQ(context->core_exec_states_[0].pending_slot_state, nullptr);
+    }
+}
