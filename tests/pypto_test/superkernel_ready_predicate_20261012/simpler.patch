+TEST_F(TmrSchedulerExecutionInputsTest, ReadyTruePredicateAllowsEachMembersLocalHandoff) {
+    for (const bool mixed : {false, true}) {
+        for (const int core_offset : {0, 1, 2}) {
+            init_slot();
+            initialize({table_a.data(), table_a.size()});
+            const auto subslot = static_cast<SubtaskSlot>(core_offset);
+            const uint8_t member = 1u << core_offset;
+            ChipTaskSlotState local{};
+            TaskDescriptor local_task{};
+            TaskPayload local_payload{};
+            local.task = &local_task;
+            local.payload = &local_payload;
+            local.active_mask = ActiveMask(member);
+            local.logical_block_num = 1;
+            local.total_required_subtasks = 1;
+            const auto previous = context->prepare_subtask_to_core(0, core_offset, local, subslot, false, 0, false);
+            ASSERT_TRUE(previous.valid);
+            context->core_trackers_[0].clear_pending_occupied(core_offset);
+
+            slot.active_mask = ActiveMask(mixed ? SUBTASK_MASK_ALL : member);
+            slot.task_attrs.set_predicate();
+            int32_t gate = 1;
+            payload.predicate = {reinterpret_cast<uint64_t>(&gate), 0, sizeof(gate), PredicateOp::GT};
+            payload.scalar_prefix = SUBTASK_MASK_ALL;
+            payload.scalar_prefix_tagged_args = SUBTASK_MASK_ALL;
+            sched.try_enqueue_early_dispatch_candidate(slot);
+            EXPECT_EQ(payload.early_dispatch_state.load(), EARLY_DISPATCH_NONE);
+            ASSERT_TRUE(sched.route_ready_once(slot));
+            ChipTaskSlotState *ready = nullptr;
+            const int shape = static_cast<int>(slot.active_mask.to_shape());
+            ASSERT_EQ(sched.ready_queues[shape].pop_batch(&ready, 1), 1);
+            ASSERT_EQ(ready, &slot);
+            EXPECT_FALSE(sched.route_ready_once(slot));
+
+            const auto handle = context->prepare_subtask_to_core(0, core_offset, *ready, subslot, true, 0, false);
+            ASSERT_TRUE(handle.valid);
+            const auto &dispatch = context->payload_per_core_[core_offset][handle.reg_task_id & 1u];
+            EXPECT_EQ(dispatch.global_context.scalar_prefix, SCALAR_PREFIX_TAGGED_ARGS | SCALAR_PREFIX_CAN_HANDOFF);
+            EXPECT_EQ(dispatch.global_context.predecessor_reg_task_id, previous.reg_task_id);
+            EXPECT_EQ(dispatch.src_payload, 0u);
+            EXPECT_EQ(context->core_exec_states_[core_offset].running_slot_state, &local);
+            EXPECT_EQ(context->core_exec_states_[core_offset].pending_slot_state, &slot);
+            EXPECT_EQ(register_writes, 0);
+            EXPECT_FALSE(slot.task_attrs.allow_early_resolve());
+        }
+    }
+}
