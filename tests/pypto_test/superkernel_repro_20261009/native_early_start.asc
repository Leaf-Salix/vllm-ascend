// SPDX-License-Identifier: Apache-2.0
// Standalone mechanism probe; deliberately synthetic, not a CSA benchmark.
#include "acl/acl.h"
#include "super_kernel/super_kernel.h"
#include "kernel_operator.h"

#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <numeric>
#include <vector>

constexpr uint32_t ELEMENTS = 16384;
constexpr uint32_t TRACE_WORDS = 32;
constexpr uint32_t SCALAR_SEED = 17;

struct KernelArgs {
    GM_ADDR input;
    GM_ADDR output;
    GM_ADDR trace;
    uint32_t vector_loops;
    uint32_t scalar_loops;
    uint32_t wait_first;
};

__aicore__ inline void Producer(const KernelArgs& args)
{
    const uint64_t begin = get_sys_cnt();
    AscendC::InitSocState();
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto input = allocator.Alloc<float, ELEMENTS>();
    auto output = allocator.Alloc<float, ELEMENTS>();
    AscendC::GlobalTensor<float> input_gm, output_gm;
    input_gm.SetGlobalBuffer((__gm__ float*)args.input, ELEMENTS);
    output_gm.SetGlobalBuffer((__gm__ float*)args.output, ELEMENTS);
    AscendC::DataCopy(input, input_gm, ELEMENTS);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::Adds(output, input, 1.0f, ELEMENTS);
    for (uint32_t i = 1; i < args.vector_loops; ++i) {
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(output, output, 1.0f, ELEMENTS);
    }
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(output_gm, output, ELEMENTS);
    AscendC::SetNextTaskStart<PIPE_MTE3, PIPE_FIX, true>();
    const uint64_t issued = get_sys_cnt();
    auto trace = (__gm__ uint64_t*)args.trace;
    trace[0] = get_coreid();
    trace[1] = g_super_kernel_early_start_config;
    trace[2] = begin;
    trace[3] = issued;
    // No PIPE_ALL in the SK producer. The normal global entry adds it.
}

__aicore__ inline void Consumer(const KernelArgs& args)
{
    const uint64_t begin = get_sys_cnt();
    if (args.wait_first) {
        AscendC::WaitPreTaskEnd<true>();
    }
    const uint64_t scalar_begin = get_sys_cnt();
    uint64_t checksum = SCALAR_SEED;
    // Register-only synthetic prefix with a runtime loop bound and a checksum
    // checked by the host. No input/UB/state access before Wait.
#pragma nounroll
    for (uint32_t i = 0; i < args.scalar_loops; ++i) {
        checksum = checksum * 1664525U + 1013904223U;
    }
    const uint64_t scalar_end = get_sys_cnt();
    if (!args.wait_first) {
        AscendC::WaitPreTaskEnd<true>();
    }
    const uint64_t ready = get_sys_cnt();
    AscendC::InitSocState();
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto input = allocator.Alloc<float, ELEMENTS>();
    auto output = allocator.Alloc<float, ELEMENTS>();
    AscendC::GlobalTensor<float> input_gm, output_gm;
    input_gm.SetGlobalBuffer((__gm__ float*)args.input, ELEMENTS);
    output_gm.SetGlobalBuffer((__gm__ float*)args.output, ELEMENTS);
    AscendC::DataCopy(input, input_gm, ELEMENTS);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::Adds(output, input, 2.0f, ELEMENTS);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(output_gm, output, ELEMENTS);
    auto trace = (__gm__ uint64_t*)args.trace + 16;
    trace[0] = get_coreid();
    trace[1] = g_super_kernel_early_start_config;
    trace[2] = begin;
    trace[3] = scalar_begin;
    trace[4] = scalar_end;
    trace[5] = ready;
    trace[6] = checksum;
}

extern "C" __global__ __vector__ __schedmode__(1)
void producer_global(GM_ADDR input, GM_ADDR output, GM_ADDR trace,
                     uint32_t vector_loops, uint32_t scalar_loops, uint32_t wait_first)
{
    g_super_kernel_early_start_config = 0;
    Producer({input, output, trace, vector_loops, scalar_loops, wait_first});
    AscendC::PipeBarrier<PIPE_ALL>();
}

extern "C" __global__ __vector__ __schedmode__(1)
void consumer_global(GM_ADDR input, GM_ADDR output, GM_ADDR trace,
                     uint32_t vector_loops, uint32_t scalar_loops, uint32_t wait_first)
{
    g_super_kernel_early_start_config = 0;
    Consumer({input, output, trace, vector_loops, scalar_loops, wait_first});
    AscendC::PipeBarrier<PIPE_ALL>();
}

template<uint32_t split>
__sk__ __vector__ void producer_sk(const KernelArgs* args, sk::SkSystemArgs* sys)
{
    (void)split;
    g_super_kernel_early_start_config = sys->SkGetTaskSyncCfg();
    Producer(*args);
}

template<uint32_t split>
__sk__ __vector__ void consumer_sk(const KernelArgs* args, sk::SkSystemArgs* sys)
{
    (void)split;
    g_super_kernel_early_start_config = sys->SkGetTaskSyncCfg();
    Consumer(*args);
}

// Bitmap: WAIT=1, SET=2. Keep default DCCI (do not set bit 2).
SK_BIND(producer_global, 2, producer_sk<0>, producer_sk<1>, producer_sk<2>, producer_sk<3>);
SK_BIND(consumer_global, 1, consumer_sk<0>, consumer_sk<1>, consumer_sk<2>, consumer_sk<3>);

static void Check(aclError status, const char* expression)
{
    if (status != ACL_SUCCESS) {
        std::fprintf(stderr, "%s: error=%d: %s\n", expression, status, aclGetRecentErrMsg());
        std::exit(1);
    }
}
#define ACL_CHECK(expr) Check((expr), #expr)

static uint32_t TaskCount(aclmdlRI model)
{
    aclrtStream streams[16];
    uint32_t stream_count = 16, total = 0;
    ACL_CHECK(aclmdlRIGetStreams(model, streams, &stream_count));
    for (uint32_t i = 0; i < stream_count; ++i) {
        aclmdlRITask tasks[128];
        uint32_t count = 128;
        ACL_CHECK(aclmdlRIGetTasksByStream(streams[i], tasks, &count));
        total += count;
    }
    return total;
}

int main(int argc, char** argv)
{
    if (argc != 8) {
        std::fprintf(stderr, "usage: %s device sk early_start wait_first vector_loops scalar_loops samples\n", argv[0]);
        return 2;
    }
    const int device = std::atoi(argv[1]);
    const bool sk_enabled = std::atoi(argv[2]);
    const uint32_t early = std::atoi(argv[3]);
    const uint32_t wait_first = std::atoi(argv[4]);
    const uint32_t vector_loops = std::atoi(argv[5]);
    const uint32_t scalar_loops = std::atoi(argv[6]);
    const int samples = std::atoi(argv[7]);
    if (vector_loops == 0 || samples < 1 || early > 1 || wait_first > 1) return 2;
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(device));
    aclrtStream stream;
    ACL_CHECK(aclrtCreateStream(&stream));
    void *input, *mid, *output, *trace;
    const size_t bytes = ELEMENTS * sizeof(float);
    ACL_CHECK(aclrtMalloc(&input, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&mid, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&output, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&trace, TRACE_WORDS * sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST));
    std::vector<float> host_input(ELEMENTS), host_output(ELEMENTS);
    for (uint32_t i = 0; i < ELEMENTS; ++i) host_input[i] = float(i % 31);
    ACL_CHECK(aclrtMemcpy(input, bytes, host_input.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemset(trace, TRACE_WORDS * sizeof(uint64_t), 0, TRACE_WORDS * sizeof(uint64_t)));
    auto launch = [&]() {
        producer_global<<<1, nullptr, stream>>>((uint8_t*)input, (uint8_t*)mid, (uint8_t*)trace,
                                               vector_loops, scalar_loops, wait_first);
        consumer_global<<<1, nullptr, stream>>>((uint8_t*)mid, (uint8_t*)output, (uint8_t*)trace,
                                               vector_loops, scalar_loops, wait_first);
    };
    // Register/load the ordinary kernels before capture.
    launch();
    ACL_CHECK(aclrtSynchronizeStream(stream));
    aclmdlRI model;
    ACL_CHECK(aclmdlRICaptureBegin(stream, ACL_MODEL_RI_CAPTURE_MODE_GLOBAL));
    if (sk_enabled) ACL_CHECK(aclskScopeBegin("same_core_probe", stream));
    launch();
    if (sk_enabled) ACL_CHECK(aclskScopeEnd("same_core_probe", stream));
    ACL_CHECK(aclmdlRICaptureEnd(stream, &model));
    const uint32_t tasks_before = TaskCount(model);
    if (sk_enabled) {
        aclskOption options[3] = {};
        options[0].optionType = aclskOptionType::EARLY_START;
        options[0].earlyStart.enableEarlyStart = early;
        options[1].optionType = aclskOptionType::SPLIT_MODE;
        options[1].splitMode.splitCnt = 1;
        options[2].optionType = aclskOptionType::PRELOAD_CODE;
        options[2].preload.preloadMode = 1;
        aclskOptions config{options, 3};
        ACL_CHECK(aclskOptimize(model, &config));
    }
    const uint32_t tasks_after = TaskCount(model);
    for (int i = 0; i < 5; ++i) ACL_CHECK(aclmdlRIExecuteAsync(model, stream));
    ACL_CHECK(aclrtSynchronizeStream(stream));
    aclrtEvent begin_event, end_event;
    ACL_CHECK(aclrtCreateEvent(&begin_event));
    ACL_CHECK(aclrtCreateEvent(&end_event));
    std::vector<float> times;
    for (int i = 0; i < samples; ++i) {
        ACL_CHECK(aclrtRecordEvent(begin_event, stream));
        ACL_CHECK(aclmdlRIExecuteAsync(model, stream));
        ACL_CHECK(aclrtRecordEvent(end_event, stream));
        ACL_CHECK(aclrtSynchronizeStream(stream));
        float ms;
        ACL_CHECK(aclrtEventElapsedTime(&ms, begin_event, end_event));
        times.push_back(ms * 1000.0f);
    }
    uint64_t host_trace[TRACE_WORDS] = {};
    ACL_CHECK(aclrtMemcpy(host_trace, sizeof(host_trace), trace, sizeof(host_trace), ACL_MEMCPY_DEVICE_TO_HOST));
    // Outside timing: change the source and poison intermediates, so stale
    // output from a prior replay cannot make the dependency check pass.
    for (float& value : host_input) value += 7.0f;
    ACL_CHECK(aclrtMemcpy(input, bytes, host_input.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemset(mid, bytes, 0xff, bytes));
    ACL_CHECK(aclrtMemset(output, bytes, 0xff, bytes));
    ACL_CHECK(aclmdlRIExecuteAsync(model, stream));
    ACL_CHECK(aclrtSynchronizeStream(stream));
    ACL_CHECK(aclrtMemcpy(host_output.data(), bytes, output, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    uint32_t mismatches = 0;
    uint64_t checksum = SCALAR_SEED;
    for (uint32_t i = 0; i < ELEMENTS; ++i) mismatches += host_output[i] != host_input[i] + vector_loops + 2.0f;
    for (uint32_t i = 0; i < scalar_loops; ++i) checksum = checksum * 1664525U + 1013904223U;
    const bool checksum_ok = host_trace[22] == checksum;
    std::printf("{\"sk\":%d,\"early_start\":%u,\"wait_first\":%u,\"vector_loops\":%u,"
                "\"scalar_loops\":%u,\"samples\":%d,\"tasks_before\":%u,\"tasks_after\":%u,"
                "\"min_us\":%.3f,\"mean_us\":%.3f,\"max_us\":%.3f,\"mismatches\":%u,"
                "\"poisoned_replay\":true,\"checksum_ok\":%s,\"trace\":[",
                sk_enabled, early, wait_first, vector_loops, scalar_loops, samples, tasks_before, tasks_after,
                *std::min_element(times.begin(), times.end()),
                std::accumulate(times.begin(), times.end(), 0.0) / times.size(),
                *std::max_element(times.begin(), times.end()), mismatches, checksum_ok ? "true" : "false");
    for (uint32_t i = 0; i < TRACE_WORDS; ++i) std::printf("%s%lu", i ? "," : "", host_trace[i]);
    std::printf("],\"samples_us\":[");
    for (size_t i = 0; i < times.size(); ++i) std::printf("%s%.3f", i ? "," : "", times[i]);
    std::printf("]}\n");
    ACL_CHECK(aclrtDestroyEvent(begin_event));
    ACL_CHECK(aclrtDestroyEvent(end_event));
    ACL_CHECK(aclmdlRIDestroy(model));
    ACL_CHECK(aclrtFree(input));
    ACL_CHECK(aclrtFree(mid));
    ACL_CHECK(aclrtFree(output));
    ACL_CHECK(aclrtFree(trace));
    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(device));
    ACL_CHECK(aclFinalize());
    return mismatches || !checksum_ok ? 1 : 0;
}
