index 00000000..ee512e55
--- /dev/null
+++ b/tests/pypto_test/tmr_csa_prefix_coverage.py
@@ -0,0 +1,210 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Observe actual private CSA prefix handoffs; diagnostic runs are not timing runs."""
+
+import argparse
+import json
+import os
+import sys
+from importlib.util import module_from_spec, spec_from_file_location
+from pathlib import Path
+from types import SimpleNamespace
+
+import pypto
+import torch
+from dsv4_csa_native_case import native_session
+from dsv4_csa_single_layer import collect_state, guard_checks, make_fixture, make_layer, restore
+from tmr_csa_full_128k_b16_compile import compile_variant
+from tmr_csa_full_128k_b16_demo import exact, load_artifact
+from tmr_csa_prefix_coverage_instrument import (
+    MAX_RAW_CORES,
+    RECORDS_PER_CORE,
+    WORDS_PER_RECORD,
+    analyze_trace,
+    instrument_wrappers,
+)
+
+
+def run(args, report):
+    # Use only the private env already sourced by task-submit. Do not call
+    # dsv4_csa_env.activate(), which deliberately chooses the shared SDK.
+    assert os.environ.get("TASK_DEVICE") == str(args.device), "must use queue-assigned NPU"
+    import torch_npu  # noqa: PLC0415
+    from pypto.runtime.kernel.context import get_process_kernel_state  # noqa: PLC0415
+    from pypto.torch import init, register  # noqa: PLC0415
+    from pypto.torch.launch import enqueue  # noqa: PLC0415
+    from vllm.engine.arg_utils import EngineArgs  # noqa: PLC0415
+    from vllm.platforms import current_platform  # noqa: PLC0415
+
+    from vllm_ascend.ops.pypto.deepseek_v4_flash_csa_scalar_overlap_demo import native_adapter  # noqa: PLC0415
+    from vllm_ascend.ops.pypto.deepseek_v4_flash_csa_scalar_overlap_demo.decode_csa import (  # noqa: PLC0415
+        decode_csa_tp1_layer_test,
+    )
+    from vllm_ascend.ops.pypto.deepseek_v4_flash_csa_scalar_overlap_demo.reduction import ATOMIC_ADD  # noqa: PLC0415
+
+    assert ATOMIC_ADD == 0, "the bit-exact comparison requires the existing non-atomic path"
+    torch.set_num_threads(2)
+    current_platform.pre_register_and_update()
+    torch_npu.npu.set_device(args.device)
+    torch_npu.npu.config.allow_internal_format = True
+    torch_npu.npu.set_deterministic_level(0)
+    # The frozen Python checkout has no installed Native extension. Load the
+    # release's existing metadata/operator binding read-only, as a fixture
+    # dependency; never redirect PyPTO or Simpler to their shared installs.
+    extension_path = args.native_extension.resolve(strict=True)
+    spec = spec_from_file_location("vllm_ascend.vllm_ascend_C", extension_path)
+    assert spec is not None and spec.loader is not None
+    extension = module_from_spec(spec)
+    sys.modules[spec.name] = extension
+    spec.loader.exec_module(extension)
+    from vllm_ascend.utils import enable_custom_op  # noqa: PLC0415
+
+    assert enable_custom_op(), "Native fixture custom operators must be registered"
+    report["native_fixture_extension"] = str(extension_path)
+    import _task_interface  # noqa: PLC0415
+    import simpler  # noqa: PLC0415
+
+    report["sdk"] = {
+        "pypto_source": pypto.__file__,
+        "simpler_source": simpler.__file__,
+        "simpler_binding": _task_interface.__file__,
+        "simpler_revision": _task_interface.__build_commit__,
+        "ptoas_root": os.environ.get("PTOAS_ROOT"),
+        "cann_root": os.environ.get("ASCEND_HOME_PATH"),
+    }
+    config = EngineArgs(
+        model=str(args.checkpoint),
+        tokenizer_mode="deepseek_v4",
+        trust_remote_code=True,
+        tensor_parallel_size=1,
+        dtype="bfloat16",
+        quantization="ascend",
+        hf_overrides={"sliding_window": 128},
+        max_model_len=max(16384, args.history + 128),
+        max_num_seqs=40,
+        max_num_batched_tokens=256,
+        enable_prefix_caching=False,
+        enforce_eager=True,
+        block_size=32,
+        speculative_config={"method": "dspark", "num_speculative_tokens": 5, "enforce_eager": True},
+        additional_config={"weight_nz_mode": 2, "enable_kv_nz": False, "enable_dsa_cp": False},
+    ).create_engine_config()
+    device = torch.device(f"npu:{args.device}")
+    print("STAGE: precompiled baseline and process-local diagnostic build", flush=True)
+    arena = torch.full((MAX_RAW_CORES, RECORDS_PER_CORE, WORDS_PER_RECORD), -1, dtype=torch.int64, device=device)
+    functions = []
+    ordinary = load_artifact("baseline", args.compiled)
+    with instrument_wrappers(arena.data_ptr(), functions):
+        candidate = compile_variant("mixed", args.output / "instrumented")
+    report["functions"] = functions
+    artifacts = [ordinary, candidate]
+    with native_session(config, args.device), torch.inference_mode():
+        print("STAGE: layer 2 formal weights and Native fixture", flush=True)
+        layer, weights_description = make_layer(config, args.checkpoint, device, layer_index=2)
+        fixture = make_fixture(config, layer.self_attn, args.batch, args.history, 1024, device)
+        groups = {name: (fixture["metadata"][g["prefix"]], g["views"]) for name, g in fixture["groups"].items()}
+        hadamard = groups["indexer"][0].hadamard
+        weights = native_adapter.prepare_weights(layer.self_attn, hadamard, layer)
+        # Public registration supplies the exact external schema; execution below
+        # uses the ordinary artifact and this process-local diagnostic artifact.
+        schema_op = register(decode_csa_tp1_layer_test, "scalar_overlap_demo::csa_baseline")
+        call = native_adapter.NativeCSACall(
+            SimpleNamespace(attention=schema_op),
+            weights,
+            fixture["hidden"],
+            fixture["positions"],
+            groups,
+            layer_name=fixture["groups"]["compressed"]["prefix"],
+            compact_metadata=fixture["compact"],
+        )
+        report.update(
+            weights=weights_description,
+            cache_layout={name: g["layout"] for name, g in fixture["groups"].items()},
+            input_shapes={name: list(value.shape) for name, value in call.args.items()},
+            weight_formats={name: int(torch_npu.get_npu_format(value)) for name, value in weights.items()},
+        )
+        init(device=args.device, platform="a2a3", runtime="tensormap_and_ringbuffer")
+        runtime = get_process_kernel_state()
+        try:
+            registrations = [runtime.ensure_callable(a, runtime.require_config()) for a in artifacts]
+            initial = {name: g["initial"].to(device) for name, g in fixture["groups"].items()}
+
+            def reset():
+                for name, group in fixture["groups"].items():
+                    group["allocation"].copy_(initial[name])
+                call.args["x_out"].fill_(float("nan"))
+                call.args["idx_topk"].fill_(-777)
+                call.args["idx_topk_scores"].fill_(float("nan"))
+
+            def state():
+                values = collect_state(fixture, call.args["x_out"], call.args["idx_topk"])
+                values["idx_topk_scores"] = call.args["idx_topk_scores"].cpu()
+                assert torch.isfinite(values["x_out"]).all()
+                return values
+
+            report["samples"] = []
+            for repeat in range(2):
+                if repeat:
+                    fixture["hidden"].neg_()
+                reset()
+                enqueue(registrations[0], call.core_args)
+                torch_npu.npu.synchronize()
+                reference = state()
+                reset()
+                arena.fill_(-1)
+                enqueue(registrations[1], call.core_args)
+                torch_npu.npu.synchronize()
+                equality = exact(state(), reference)
+                guards = guard_checks(fixture)
+                assert all(v["status"] == "PASS" for v in guards.values()), guards
+                trace = arena.cpu()
+                # Save before assertions, so a failed timing invariant is inspectable.
+                torch.save(trace, args.output / f"trace_round{repeat}.pt")
+                sample = analyze_trace(trace, functions)
+                sample.update(repeat=repeat, exact=equality, guards={k: v["status"] for k, v in guards.items()})
+                report["samples"].append(sample)
+                print("CSA coverage", repeat, json.dumps(sample["totals"]), flush=True)
+            report["status"] = "FUNCTIONAL_AND_COVERAGE_COMPLETE"
+        finally:
+            runtime.drain()
+            runtime.close()
+            restore(fixture)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--compiled", type=Path, required=True)
+    parser.add_argument("--device", type=int, required=True)
+    args = parser.parse_args()
+    args.batch, args.history = 16, 131072
+    args.checkpoint = Path("/data/model/DeepSeek-V4-Flash-0731-w8a8")
+    args.native_extension = (
+        Path(os.environ["PTO_EAGER_ROOT"])
+        / "vllm-ascend-dsv4-pto-0251rc1"
+        / ".cache/csa/native-install/vllm_ascend_C.cpython-310-aarch64-linux-gnu.so"
+    )
+    args.output.mkdir(parents=True, exist_ok=True)
+    report = {
+        "status": "RUNNING",
+        "device": args.device,
+        "batch": args.batch,
+        "history": args.history,
+        "scope": "single layer 2 HC_pre+norm+CSA+HC_post",
+        "runtime": "TMR",
+        "timing": "disabled; diagnostic inserts stores and clocks",
+        "atomic_add": False,
+        "deterministic_level": 0,
+        "profiler": False,
+    }
+    try:
+        run(args, report)
+    except BaseException as exc:
+        report.update(status="FAIL", error=repr(exc))
+        raise
+    finally:
+        (args.output / "results.json").write_text(json.dumps(report, indent=2) + "\n")
+    print(report["status"], flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/pypto_test/tmr_csa_prefix_coverage_instrument.py b/tests/pypto_test/tmr_csa_prefix_coverage_instrument.py
new file mode 100644
index 00000000..1aeceb88
--- /dev/null
+++ b/tests/pypto_test/tmr_csa_prefix_coverage_instrument.py
@@ -0,0 +1,210 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Private diagnostic wrappers: no scheduler, task graph, or arithmetic edits.
+
+The trace address is fixed only for the lifetime of this diagnostic process.
+These artifacts must never be reused in another process or used for timing.
+"""
+
+from collections import Counter, defaultdict
+from contextlib import contextmanager
+
+MAX_RAW_CORES = 128
+RECORDS_PER_CORE = 2048
+WORDS_PER_RECORD = 16
+
+
+def instrument_source(source, function_id, address, has_tail):
+    helper = f"""
+static __aicore__ __attribute__((always_inline)) inline
+__gm__ uint64_t* csa_coverage_row(__gm__ int64_t* args) {{
+    auto* ctx = reinterpret_cast<__gm__ GlobalContext*>(args[SPMD_GLOBAL_CONTEXT_INDEX]);
+    uint64_t core = get_coreid();
+    uint64_t sequence = ctx->reg_task_id;
+    auto* arena = reinterpret_cast<__gm__ uint64_t*>({address}ULL);
+    if (core >= {MAX_RAW_CORES}) return nullptr;
+    if (sequence >= {RECORDS_PER_CORE}) {{
+        auto* overflow = arena + core * {RECORDS_PER_CORE * WORDS_PER_RECORD};
+        overflow[0] = core;
+        overflow[1] = sequence;
+        dcci(overflow, SINGLE_CACHE_LINE, CACHELINE_OUT);
+        return nullptr;
+    }}
+    return arena + (core * {RECORDS_PER_CORE} + sequence) * {WORDS_PER_RECORD};
+}}
+"""
+    adapter_marker = 'extern "C" {\n'
+    assert adapter_marker in source
+    source = source.replace(adapter_marker, helper + adapter_marker, 1)
+    source = source.replace(
+        "    int64_t ready = 1;\n",
+        "    auto* coverage = csa_coverage_row(args);\n"
+        "    if (coverage != nullptr) coverage[14] = get_sys_cnt();\n"
+        "    int64_t ready = 1;\n",
+        1,
+    )
+    after_wait = "    // The Scalar prefix must not change state inherited by the predecessor.\n"
+    assert after_wait in source
+    source = source.replace(
+        after_wait,
+        "    if (coverage != nullptr) {\n"
+        "        coverage[15] = get_sys_cnt();\n"
+        "        dcci(coverage + 8, SINGLE_CACHE_LINE, CACHELINE_OUT);\n"
+        "    }\n" + after_wait,
+        1,
+    )
+    boundary_decode = "    args = reinterpret_cast<__gm__ int64_t*>(__pypto_args_word & ~uint64_t{1});\n"
+    assert source.count(boundary_decode) == 1
+    setup = f"""
+    auto* coverage_ctx = reinterpret_cast<__gm__ GlobalContext*>(args[SPMD_GLOBAL_CONTEXT_INDEX]);
+    auto* coverage_row = csa_coverage_row(args);
+    if (coverage_row != nullptr) {{
+        coverage_row[0] = get_coreid();
+        coverage_row[1] = get_sys_cnt();
+        coverage_row[8] = {function_id};
+        coverage_row[9] = coverage_ctx->reg_task_id;
+        coverage_row[10] = coverage_ctx->scalar_prefix;
+        coverage_row[11] = coverage_ctx->predecessor_reg_task_id;
+        coverage_row[12] = get_block_idx(args);
+        coverage_row[13] = (coverage_ctx->wait_predecessor_fn != 0 ? 1ULL : 0ULL)
+            | (coverage_ctx->predecessor_context != 0 ? 2ULL : 0ULL)
+            | ({int(has_tail)}ULL << 2);
+    }}
+"""
+    if has_tail:
+        setup += """
+    coverage_ctx->scalar_overlap_trace = reinterpret_cast<uint64_t>(coverage_row);
+    if (coverage_row != nullptr) coverage_ctx->scalar_overlap_start = coverage_row[1];
+"""
+    source = source.replace(boundary_decode, boundary_decode + setup, 1)
+    if not has_tail:
+        # Synchronous members already drain their ordinary epilogue. Do not
+        # dirty the runtime's overlap context for those two scalar-only entries.
+        ending = """
+    if (coverage_row != nullptr) {
+        uint64_t finished = get_sys_cnt();
+        coverage_row[2] = finished;
+        coverage_row[3] = finished;
+        coverage_row[4] = 0;
+        coverage_row[5] = finished;
+        coverage_row[6] = 0;
+        coverage_row[7] = finished;
+        dcci(coverage_row, SINGLE_CACHE_LINE, CACHELINE_OUT);
+    }
+"""
+        assert source.endswith("}\n")
+        source = source[:-2] + ending + "}\n"
+    return source
+
+
+@contextmanager
+def instrument_wrappers(address, functions):
+    from pypto.backend import pto_backend
+
+    original = pto_backend._generate_kernel_wrapper
+
+    def wrapper(func, *args, **kwargs):
+        assert pto_backend._function_uses_ops(func, pto_backend._LOCAL_TASK_WAIT_OPS), func.name
+        has_tail = pto_backend._function_uses_ops(func, pto_backend._LOCAL_TASK_SIGNAL_OPS)
+        function_id = len(functions)
+        functions.append(
+            {
+                "id": function_id,
+                "name": func.name,
+                "has_tail": has_tail,
+                "has_compiled_poll": "task_boundary_scratch_base" in dict(func.attrs),
+            }
+        )
+        return instrument_source(original(func, *args, **kwargs), function_id, address, has_tail)
+
+    pto_backend._generate_kernel_wrapper = wrapper
+    try:
+        yield
+    finally:
+        pto_backend._generate_kernel_wrapper = original
+
+
+def analyze_trace(tensor, functions):
+    assert tensor.shape == (MAX_RAW_CORES, RECORDS_PER_CORE, WORDS_PER_RECORD)
+    assert (tensor[:, 0, :] == -1).all(), "trace capacity exceeded or dispatch sequence zero"
+    indices = (tensor[:, :, 8] >= 0).nonzero()
+    records = [tensor[int(core), int(sequence)].tolist() for core, sequence in indices]
+    names = {f["id"]: f["name"] for f in functions}
+    prior = {(r[0], r[9]): r for r in records}
+    total, by_function = Counter(), defaultdict(Counter)
+    details, missed = [], []
+    for row in records:
+        core, begin, returned, finished, tail_flags, wait_begin, _, compute_end = row[:8]
+        fn, sequence, flags, predecessor, block, mode, prefix_end, after_wait = row[8:]
+        assert fn in names
+        assert 0 < begin <= prefix_end <= after_wait <= returned <= finished, row
+        assert returned <= wait_begin <= compute_end <= finished, row
+        counts = by_function[names[fn]]
+        counts["executions"] += 1
+        counts["gated_dispatch"] += bool(flags & 4)
+        counts["pending_capable"] += bool(flags & 1)
+        counts["prefix_callback"] += bool(mode & 1)
+        counts["local_handoff"] += bool(mode & 2)
+        counts["pending_without_handoff"] += bool(flags & 1) and not bool(mode & 2)
+        counts["idle_or_drained_prefix"] += bool(mode & 1) and not bool(mode & 2)
+        notification = bool(tail_flags & 256)
+        late_handoff = bool(tail_flags & 512)
+        counts["notification_submitted"] += notification
+        counts["handoff_after_callback"] += late_handoff
+        counts["notification_without_handoff"] += notification and not late_handoff
+        if notification:
+            assert mode & 4 and tail_flags & 255 == 7, row
+        if late_handoff:
+            # The retained callback always submits its ordered notification.
+            assert notification, row
+        if mode & 2:
+            producer = prior.get((core, predecessor))
+            assert producer is not None, ("missing predecessor", core, predecessor)
+            assert producer[2] <= begin <= prefix_end <= producer[5] <= producer[3] <= after_wait
+            by_function[names[producer[8]]]["outgoing_handoff"] += 1
+            by_function[names[producer[8]]]["outgoing_without_callback"] += not bool(producer[4] & 512)
+            counts["incoming_gated_handoff"] += bool(flags & 4)
+            counts["incoming_ready_handoff"] += not bool(flags & 4)
+            # The complete tail now includes notification DMA. A positive wait
+            # cannot independently prove that the original compute overlapped.
+            positive_tail = producer[7] - producer[5] > 5
+            counts["handoff_with_tail_gt5ticks"] += positive_tail
+            counts["received_handoff_after_callback"] += bool(producer[4] & 512)
+            details.append(
+                {
+                    "core": core,
+                    "sequence": sequence,
+                    "function": names[fn],
+                    "predecessor": names[producer[8]],
+                    "block": block,
+                    "prefix_ticks": prefix_end - begin,
+                    "predecessor_tail_wait_ticks": producer[7] - producer[5],
+                    "predecessor_submitted_notification": bool(producer[4] & 256),
+                    "after_callback": bool(producer[4] & 512),
+                }
+            )
+        elif flags & 1:
+            producer = prior.get((core, predecessor))
+            assert producer is not None, ("missing pending predecessor", core, predecessor)
+            missed.append(
+                {
+                    "core": core,
+                    "sequence": sequence,
+                    "function": names[fn],
+                    "predecessor": names[producer[8]],
+                    "predecessor_has_tail": bool(producer[13] & 4),
+                    "predecessor_submitted_notification": bool(producer[4] & 256),
+                    "entry_after_predecessor_finish_ticks": begin - producer[3],
+                }
+            )
+    for counts in by_function.values():
+        total.update(counts)
+    assert total["handoff_after_callback"] == total["received_handoff_after_callback"], total
+    assert total["outgoing_handoff"] == total["local_handoff"], total
+    assert sum(bool(r[10] & 4) and not bool(r[13] & 1) for r in records) == 0, "gated prefix was skipped"
+    return {
+        "totals": dict(total),
+        "by_function": {k: dict(v) for k, v in sorted(by_function.items())},
+        "handoffs": details,
+        "pending_without_handoff": missed,
+        "records": records,
+    }
